+def _write_synced(path: Path, content: bytes, *, exclusive: bool = True) -> None:
+    with path.open('xb' if exclusive else 'wb') as handle:
+        handle.write(content)
+        handle.flush()
+        os.fsync(handle.fileno())
+
+
+def _planned_digest(path: Path, content: bytes) -> dict[str, Any]:
+    return {'path': str(path.resolve()), 'bytes': len(content),
+            'sha256': hashlib.sha256(content).hexdigest(), 'md5': hashlib.md5(content).hexdigest()}
+
+
+def _publish_final(out: Path, stats: dict[str, Any]) -> None:
+    """Publish summary last as the commit receipt; retain every pending file.
+
+    The manifest covers the eventual summary/progress bytes and all other files
+    present before publication. It excludes itself and its identical pending
+    hard link, which cannot include their own hash. A manifest without the final
+    summary is an uncommitted run and must never be accepted as sealed.
+    """
+    final_bytes = (json.dumps(stats, indent=2, sort_keys=True) + '\n').encode('utf8')
+    summary_pending = out/'summary.json.pending'
+    _write_synced(summary_pending, final_bytes)
+    manifest = {str(p.relative_to(out)): digest_file(p) for p in sorted(out.rglob('*')) if p.is_file()}
+    for name in ('summary.json', 'progress.json'):
+        manifest[name] = _planned_digest(out/name, final_bytes)
+    manifest_pending = out/'manifest.json.pending'
+    _write_synced(manifest_pending, (json.dumps(manifest, indent=2, sort_keys=True)+'\n').encode('utf8'))
+    os.link(manifest_pending, out/'manifest.json')
+    # Progress is mutable throughout a run. Any failure here is recorded before
+    # the final summary exists; the prepared bytes and manifest remain inspectable.
+    _write_synced(out/'progress.json', final_bytes, exclusive=False)
+    # Last fallible publication operation: an atomic no-replace commit receipt.
+    os.link(summary_pending, out/'summary.json')
 
 
