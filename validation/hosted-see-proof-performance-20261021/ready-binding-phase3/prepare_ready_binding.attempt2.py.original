 for label,values in [('DRAFT',{'status':'DRAFT'}),('signature',{'expected_nodes':292546}),('source',{'candidate_sha':BASE}),('count',{'source_file_counts':{'baseline':76,'candidate':77}}),('capture',{'transport_captures':{}}),('root',{'root_review_status':'PENDING'}),('proofs',{'correctness_evidence_sha256':{}}),('workflow',{'workflow_sha256':None}),('attempt_type',{'attempts':True}),('signature_type',{'expected_nodes':True}),('blocks_type',{'aa_blocks':'15'}),('seed_type',{'bootstrap_seed':20261102.0})]:
