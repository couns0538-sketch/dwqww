 assert ind['findings']==[]
 cfg=read(P/'protocol.json');cfg.update(status=common.READY,expected_nodes=292545,candidate_first_native_signature_nodes=292545,source_gates_status='PASSED',parity_review_status='PASSED',capture_review_status='PASSED',root_review_status='PASSED',independent_review_status='PASSED',operational_qualification_status='authorized_for_one_fresh_host_calibration_attempt_with_prior_anomalies_unresolved',correctness_evidence_sha256=proofs,workflow_status='FROZEN',workflow_sha256=sha(Q/'forge-hosted-see-proof-performance.yml'),mandatory_finite_proof_paths=list(common.REQUIRED_PROOFS),actual_five_capture_gate='PASSED genuine23 original-side reuse plus one actual24 producer; no throughput/Elo evidence',remaining_proof_inputs=['Separate independent final enabled-metadata review of exact frozen hashes; root exact-payload publication/readback before sole trigger'],prototype_note='Observer source23 query counts are preserved as source-specific work/equality evidence only. Actual24 native42/active8/56coldwarm/SEE504 and one genuine24 producer are separately bound; original23 side is reused without relabeling or rerun.')
 c24=read(V/'capture-preparation/actual-five-captures/PROVENANCE.json');entry={'source_commit':CAND,'engine_sha256':c24['captures']['candidate']['binary_sha256_before']['forge'],'provenance_capture_label':'candidate','source_manifest_path':'validation/see-proof-reuse-native-20261021/ROOT-FROZEN-SOURCE-GATES.json','facts_path':'validation/hosted-see-proof-performance-20261021/capture-preparation/actual-five-captures/candidate/status.json','provenance_path':'validation/hosted-see-proof-performance-20261021/capture-preparation/actual-five-captures/PROVENANCE.json'}
 for stream in ['stdin','stdout','stderr']:entry[stream+'_path']='validation/hosted-see-proof-performance-20261021/capture-preparation/actual-five-captures/candidate/'+stream+'.txt'
 cfg['transport_captures']={'baseline':copy.deepcopy(c24['reused23_entry']),'candidate':entry}
