def prepare(proof_map):
 missing=[p for p in [proof_map,V/'independent-review/REVIEW.json',V/'ROOT-PREPARATION-REVIEW.json',V/'ROOT-ONE-ATTEMPT-AUTHORIZATION.json'] if not p.is_file()]
 if missing:return {'status':'BLOCKED_ACTUAL_BINDING_INPUTS_MISSING_NOT_APPLIED','missing':[str(p) for p in missing]}
