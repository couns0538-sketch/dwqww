+    def test_deadline_rejects_response_observed_after_go_deadline(self):
+        # The output can already be queued when the harness resumes. The
+        # deadline must be anchored before the go write, not reset on read.
+        reader = Engine.__new__(Engine)
+        reader.output = queue.Queue()
+        reader.threads = []
+        started = time.monotonic_ns()
+        time.sleep(0.035)
+        reader.output.put({"text": "bestmove e7e4", "monotonic_ns": time.monotonic_ns()})
+        self.assertIsNone(reader.until(lambda x: x.startswith("bestmove "),
+                                       0.010, start_ns=started))
+
+    def test_deadline_accepts_timely_response_despite_late_consumption(self):
+        reader = Engine.__new__(Engine)
+        reader.output = queue.Queue()
+        reader.threads = []
+        started = time.monotonic_ns()
+        reader.output.put({"text": "bestmove e7e4", "monotonic_ns": time.monotonic_ns()})
+        time.sleep(0.035)
+        item = reader.until(lambda x: x.startswith("bestmove "),
+                            0.010, start_ns=started)
+        self.assertIsNotNone(item)
+        self.assertEqual(item["text"], "bestmove e7e4")
+
+    def test_child_exit_waits_for_pending_stdout_drain(self):
+        class Exited:
+            def poll(self):
+                return 0
+
+        class ReaderThread:
+            def is_alive(self):
+                return True
+
+        reader = Engine.__new__(Engine)
+        reader.proc = Exited()
+        reader.threads = [ReaderThread()]
+        reader.output = queue.Queue()
+        def delayed_read():
+            reader.output.put({"text": "bestmove e7e4", "monotonic_ns": time.monotonic_ns()})
+        writer = threading.Timer(0.15, delayed_read)
+        writer.start()
+        try:
+            self.assertIsNotNone(reader.until(lambda x: x.startswith("bestmove "), 0.4))
+        finally:
+            writer.join(timeout=1.0)
+
