+    def test_source_grounded_hard_limit_is_351_ms(self):
+        from warm_timeout_probe import HARD_LIMIT_MS
+        self.assertEqual(HARD_LIMIT_MS, 351)
+
+    def test_reply_after_hard_limit_before_watchdog_is_not_pass(self):
+        # A 0.65 second bestmove violates the frozen engine hard limit of
+        # 351 ms even though it satisfies the 2 second diagnostic watchdog.
+        with tempfile.TemporaryDirectory() as d:
+            os.environ["MOCK_DELAY_MS"] = "650"
+            try:
+                raw = Path(d) / "overrun.jsonl"
+                result = trial(HERE / "fake_uci.py", "cold", raw, None,
+                               deadline=2.0)
+            finally:
+                os.environ.pop("MOCK_DELAY_MS", None)
+            self.assertFalse(result["deadline_expired"], result)
+            self.assertEqual(result["bestmove"], "bestmove e7e4")
+            self.assertTrue(result["hard_limit_violated"], result)
+            self.assertGreater(result["hard_limit_overrun_ms"], 200)
+            self.assertFalse(result["completed_normally"], result)
+            self.assertEqual(result["raw_events_sha256"], sha256(raw))
+
