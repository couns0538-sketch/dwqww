+# Freeze the engine's *internal* hard allocation independently of the harness's
+# broader wall-clock watchdog. From Forge 6.4 search.cpp, for Black's 596 ms:
+# available = 596 - 10 = 586; soft = 586//22 + 100*75//100 = 101;
+# hard = min(586*60//100, 101*5) = 351 ms. This value applies only to
+# the frozen TT-tag binaries and UCI options recorded in this protocol.
+# A wall-clock overrun is evidence of a timing anomaly, not proof of where
+# the delay occurred (engine, kernel scheduler, harness or I/O transport).
+HARD_LIMIT_MS = min((596 - 10) * 60 // 100,
+                    ((596 - 10) // 22 + 100 * 75 // 100) * 5)
+assert HARD_LIMIT_MS == 351
