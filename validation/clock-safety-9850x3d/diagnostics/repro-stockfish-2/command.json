[
  "/workspace/.cloud-setup/fastchess/fastchess",
  "-config",
  "outname=state.json",
  "-engine",
  "cmd=/workspace/.cloud-setup/stockfish/stockfish/stockfish-linux-x86-64-universal",
  "name=Baseline",
  "option.UCI_LimitStrength=false",
  "option.Skill Level=20",
  "-engine",
  "cmd=/workspace/.cloud-setup/clock-audit/trace-forge.py",
