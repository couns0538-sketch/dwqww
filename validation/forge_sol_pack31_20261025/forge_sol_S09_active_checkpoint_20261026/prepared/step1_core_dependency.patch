diff --git a/tests/nnue_heads_tests.cpp b/tests/nnue_heads_tests.cpp
new file mode 100644
--- /dev/null
+++ b/tests/nnue_heads_tests.cpp
@@ -0,0 +1,63 @@
+// buckets8 output heads: piece-count -> head mapping and loader contract.
+#include "forge/board.hpp"
+#include "forge/nnue.hpp"
+
+#include <iostream>
+
+using namespace forge;
+
+static_assert(nnue::OutputHeads == 8);
+// Every legal piece count 2..32 maps to its band; out-of-range counts clamp.
+static_assert(nnue::output_head(0) == 0 && nnue::output_head(1) == 0);
+static_assert(nnue::output_head(2) == 0 && nnue::output_head(4) == 0);
+static_assert(nnue::output_head(5) == 1 && nnue::output_head(8) == 1);
+static_assert(nnue::output_head(9) == 2 && nnue::output_head(12) == 2);
+static_assert(nnue::output_head(13) == 3 && nnue::output_head(16) == 3);
+static_assert(nnue::output_head(17) == 4 && nnue::output_head(20) == 4);
+static_assert(nnue::output_head(21) == 5 && nnue::output_head(24) == 5);
+static_assert(nnue::output_head(25) == 6 && nnue::output_head(28) == 6);
+static_assert(nnue::output_head(29) == 7 && nnue::output_head(32) == 7);
+static_assert(nnue::output_head(33) == 7 && nnue::output_head(64) == 7 && nnue::output_head(-5) == 0);
+
+int main() {
+    int failures = 0;
+    auto check = [&](bool ok, const char* what) {
+        if (!ok) { ++failures; std::cerr << "FAIL " << what << '\n'; }
+    };
+    // Each band is exactly 4 wide (band 0 starts at 1) and bands are monotone.
+    for (int pieces = 1; pieces <= 32; ++pieces) {
+        check(nnue::output_head(pieces) == (pieces - 1) / 4, "band formula");
+        if (pieces > 1) check(nnue::output_head(pieces) >= nnue::output_head(pieces - 1), "monotone");
+    }
+    if (nnue::available()) {
+        const int stored = nnue::stored_output_heads();
+        check(stored == 1 || stored == nnue::OutputHeads, "stored heads is 1 or 8");
+        // Positions spanning every head evaluate without touching invalid
+        // memory (ASan builds catch out-of-bounds head reads) and refresh is
+        // deterministic.
+        const char* fens[] = {
+            "4k3/8/8/8/8/8/8/4K3 w - - 0 1",                                   // 2 -> head 0
+            "4k3/8/8/8/8/8/4P3/R3K3 w - - 0 1",                               // 4 -> 0
+            "4k3/4p3/8/8/8/8/4P3/R3K3 b - - 0 1",                             // 5 -> 1
+            "r3k3/pp6/8/8/8/8/PPP5/R3K2R w - - 0 1",                          // 9 -> 2
+            "r3k2r/pppp4/8/8/8/8/PPPP4/R3K2R w KQkq - 0 1",                   // 14 -> 3
+            "r1bqk2r/pppp4/8/8/8/8/PPPP4/R1BQK2R w KQkq - 0 1",               // 18 -> 4
+            "r1bqk2r/pppppp2/8/8/8/8/PPPPPP2/R1BQK2R w KQkq - 0 1",           // 22 -> 5
+            "rnbqk2r/pppppppp/8/8/8/8/PPPPPPPP/RNBQK2R w KQkq - 0 1",         // 28 -> 6
+            "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",       // 32 -> 7
+        };
+        bool seen[nnue::OutputHeads] = {};
+        for (const char* fen : fens) {
+            Board board;
+            check(board.set_fen(fen), "fixture fen");
+            seen[nnue::output_head(popcount(board.occupied()))] = true;
+            nnue::Accumulator a, b;
+            nnue::refresh(board, a);
+            nnue::refresh(board, b);
+            check(nnue::evaluate(board, a) == nnue::evaluate(board, b), "deterministic eval");
+        }
+        for (int h = 0; h < nnue::OutputHeads; ++h) check(seen[h], "fixtures cover every head");
+    }
+    std::cout << (failures == 0 ? "nnue heads tests passed\n" : "nnue heads tests FAILED\n");
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tools/nnue/heads_parity.cpp b/tools/nnue/heads_parity.cpp
new file mode 100644
--- /dev/null
+++ b/tools/nnue/heads_parity.cpp
@@ -0,0 +1,59 @@
+// buckets8 parity harness (own tool). Builds against any Forge core, old
+// single-head or new 8-head, so the same source compares both.
+// For each FEN line: refresh + evaluate, then `plies` seeded random legal
+// moves with incremental update; at every step prints
+//   <line> <ply> <pieces> <head> <net_cp> <hce_cp> <incremental==refresh>
+// head = clamp((pieces-1)>>2, 0, 7), computed here so the lock core links too.
+#include "forge/board.hpp"
+#include "forge/eval.hpp"
+#include "forge/nnue.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <string>
+
+using namespace forge;
+
+int main(int argc, char** argv) {
+    if (argc < 2) { std::fprintf(stderr, "usage: heads_parity FENS [plies=8]\n"); return 2; }
+    const int plies = argc > 2 ? std::atoi(argv[2]) : 8;
+    std::ifstream in(argv[1]);
+    std::string line;
+    std::uint64_t rng = 0x9e3779b97f4a7c15ULL;
+    long n = 0, acc_mismatch = 0;
+    while (std::getline(in, line)) {
+        std::string fen = line.substr(0, line.find('|'));
+        while (!fen.empty() && (fen.back() == ' ' || fen.back() == '\r')) fen.pop_back();
+        Board board;
+        if (!board.set_fen(fen)) { std::printf("%ld BAD\n", n++); continue; }
+        nnue::Accumulator acc;
+        nnue::refresh(board, acc);
+        for (int ply = 0;; ++ply) {
+            nnue::Accumulator fresh;
+            nnue::refresh(board, fresh);
+            const bool same = std::memcmp(&fresh.values, &acc.values, sizeof(acc.values)) == 0;
+            if (!same) ++acc_mismatch;
+            const int pieces = popcount(board.occupied());
+            int head = (pieces - 1) >> 2; head = head < 0 ? 0 : (head > 7 ? 7 : head);
+            std::printf("%ld %d %d %d %d %d %d\n", n, ply, pieces, head, nnue::evaluate(board, acc),
+                        Evaluator::evaluate_uncached(board), same ? 1 : 0);
+            if (ply == plies) break;
+            const auto moves = board.legal_moves();
+            if (moves.empty()) break;
+            rng = rng * 6364136223846793005ULL + 1442695040888963407ULL;
+            const auto move = moves[static_cast<std::size_t>((rng >> 33) % moves.size())];
+            const auto dirty = nnue::dirty_pieces(board, move);
+            Undo undo;
+            if (!board.make_move(move, undo)) { std::printf("%ld ILLEGAL\n", n); break; }
+            nnue::Accumulator child;
+            nnue::update(acc, child, dirty);
+            acc = child;
+        }
+        ++n;
+    }
+    std::fprintf(stderr, "lines %ld available=%d residual=%d hidden=%d acc_mismatch=%ld\n", n, (int)nnue::available(),
+                 (int)nnue::residual(), (int)nnue::HiddenSize, acc_mismatch);
+    return 0;
+}
diff --git a/tools/nnue/make_heads_inc.py b/tools/nnue/make_heads_inc.py
new file mode 100644
--- /dev/null
+++ b/tools/nnue/make_heads_inc.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Forge NNUE output-head include tool (buckets8). Stdlib only.
+
+  make_heads_inc.py replicate SRC.inc DST.inc
+      Legacy single-head include -> 8-head include whose 8 heads are exact
+      copies of the source head. W1/B1 text is copied unchanged.
+  make_heads_inc.py check INC [--hidden N]
+      Validate an include against the layout in README_BUCKETS8.md and
+      report heads, sizes and which heads are identical.
+  make_heads_inc.py control SRC.inc DST.inc
+      TEST ONLY: replicate, then add (head+1)*64 to head k's bias (int16),
+      so each head gives a different eval. Used by the parity harness to
+      prove the head is really selected by piece count. Never ship it.
+
+Layout (head-major): NnueW2[8 * 2 * H] = head0[stm H | opp H], head1[...], ...
+NnueB2[8]. Bucket of a position = output_head(pieces incl. kings) =
+clamp((pieces - 1) >> 2, 0, 7).
+"""
+import re, sys
+
+HEADS = 8
+
+def parse(path):
+    text = open(path).read()
+    arrays = {}
+    for m in re.finditer(r'static const std::int16_t (Nnue\w+)\[(\d+)\] = \{(.*?)\};', text, re.S):
+        vals = [int(v) for v in m.group(3).replace('\n', ' ').split(',') if v.strip()]
+        if len(vals) != int(m.group(2)):
+            sys.exit(f'{path}: {m.group(1)} declares {m.group(2)} values, has {len(vals)}')
+        arrays[m.group(1)] = (m.start(), m.end(), vals)
+    scalar = re.search(r'static const std::int16_t NnueB2 = (-?\d+);', text)
+    heads_def = re.search(r'#define FORGE_NNUE_OUTPUT_(?:HEADS|BUCKETS) (\d+)', text)
+    return text, arrays, scalar, heads_def
+
+def fmt(name, vals, per_line=24):
+    rows = [', '.join(str(v) for v in vals[i:i + per_line]) for i in range(0, len(vals), per_line)]
+    return f'static const std::int16_t {name}[{len(vals)}] = {{\n  ' + ',\n  '.join(rows) + ',\n};'
+
+def replicate(src, dst, bias_step=0):
+    text, arrays, scalar, heads_def = parse(src)
+    if heads_def or scalar is None or 'NnueB2' in arrays:
+        sys.exit(f'{src}: not a legacy single-head include')
+    s, e, w2 = arrays['NnueW2']
+    b2 = int(scalar.group(1))
+    new_w2 = w2 * HEADS
+    new_b2 = [b2 + (k + 1) * bias_step for k in range(HEADS)]
+    if any(not -32768 <= v <= 32767 for v in new_b2):
+        sys.exit('bias out of int16 range')
+    out = text[:s] + fmt('NnueW2', new_w2) + text[e:scalar.start()] + fmt('NnueB2', new_b2, HEADS) + text[scalar.end():]
+    tag = '#define FORGE_NNUE_OUTPUT_HEADS 8\n'
+    note = ('// buckets8: 8 output heads (head-major NnueW2/NnueB2), made by tools/nnue/make_heads_inc.py\n'
+            f'// {"CONTROL (TEST ONLY): head k bias += (k+1)*%d" % bias_step if bias_step else "replicate"} from {src.split("/")[-1]}\n')
+    out = note + out
+    anchor = '#define FORGE_NNUE_RESIDUAL'
+    i = out.find(anchor)
+    i = out.find('\n', i) + 1 if i >= 0 else out.find('\n', out.find('#include <cstdint>')) + 1
+    out = out[:i] + tag + out[i:]
+    open(dst, 'w').write(out)
+    print(f'wrote {dst}: heads {HEADS}, W2 {len(new_w2)}, B2 {new_b2}')
+
+def check(path, hidden=None):
+    text, arrays, scalar, heads_def = parse(path)
+    w1 = arrays['NnueW1'][2]; b1 = arrays['NnueB1'][2]; w2 = arrays['NnueW2'][2]
+    h = len(b1)
+    if hidden and h != hidden: sys.exit(f'FAIL hidden {h} != {hidden}')
+    if len(w1) != 768 * h: sys.exit(f'FAIL W1 {len(w1)} != 768*{h}')
+    heads = int(heads_def.group(1)) if heads_def else 1
+    b2 = arrays['NnueB2'][2] if 'NnueB2' in arrays else [int(scalar.group(1))]
+    if len(w2) != heads * 2 * h or len(b2) != heads:
+        sys.exit(f'FAIL heads {heads}: W2 {len(w2)} (want {heads*2*h}), B2 {len(b2)} (want {heads})')
+    if heads not in (1, HEADS): sys.exit(f'FAIL heads {heads} not 1 or {HEADS}')
+    blocks = [tuple(w2[k * 2 * h:(k + 1) * 2 * h]) + (b2[k],) for k in range(heads)]
+    same = [k for k in range(heads) if blocks[k] == blocks[0]]
+    resid = re.search(r'#define FORGE_NNUE_RESIDUAL (\d)', text)
+    print(f'OK {path}: hidden {h}, heads {heads}, residual {resid.group(1) if resid else 0}, '
+          f'heads identical to head0: {same}, B2 {b2}')
