+// timepack4 F3 (0 = off; at 0 every search is identical to the base).
+extern int TmDecisiveWinStable;   // >0: final soft stop x pct/100 when winning by >= kDecisiveWinStableScoreCp AND the iteration is stable
+inline constexpr int kDecisiveWinStableScoreCp = 450;
+inline constexpr int kDecisiveWinStableMinDepth = 8;
+// Scale applied to the final (already floored) soft stop. Pure function so it
+// can be unit-tested without a clock. Returns 1.0 unless all of these hold:
+// pct in 1..99, depth >= kDecisiveWinStableMinDepth, score is a non-mate win
+// of at least kDecisiveWinStableScoreCp for the side to move, a previous
+// completed iteration score exists (prev_score != ValueNone), the score did
+// not fall versus that previous iteration (any drop > 0 cp skips the scale),
+// and the best move did not change in the latest iteration.
+[[nodiscard]] constexpr double decisive_win_stable_scale(int pct, int score, int depth, int prev_score,
+                                                         bool bestmove_changed) {
+    if (pct <= 0 || pct >= 100 || depth < kDecisiveWinStableMinDepth || is_mate_score(score) ||
+        score < kDecisiveWinStableScoreCp)
+        return 1.0;
+    if (bestmove_changed || prev_score == ValueNone || score < prev_score) return 1.0;
+    return pct / 100.0;
+}
 extern int CaptureFutilityBase;   // futility pruning of captures: base margin (0 = off)
