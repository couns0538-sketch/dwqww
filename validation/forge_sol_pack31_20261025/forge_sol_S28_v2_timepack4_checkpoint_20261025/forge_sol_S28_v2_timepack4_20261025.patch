diff --git a/tests/timepack4_tests.cpp b/tests/timepack4_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0ea60a778b486967aeee69f6b8dee6da8f018dad
--- /dev/null
+++ b/tests/timepack4_tests.cpp
@@ -0,0 +1,124 @@
+// timepack4 tests: TmDecisiveWinStable (winning-side final soft-stop scale that
+// is skipped while the eval is falling or the best move just changed; CR's F3).
+// Own code. No wall-clock assertions: the scale is tested as a pure function,
+// and searches are compared only by deterministic fixed-depth / fixed-node results.
+#include "forge/board.hpp"
+#include "forge/nnue.hpp"
+#include "forge/search.hpp"
+#include <cstring>
+#include <iostream>
+#include <string>
+
+namespace {
+int assertions = 0, failures = 0;
+void check(bool okay, const std::string& label) {
+    ++assertions;
+    if (!okay) { ++failures; std::cerr << "FAIL " << label << '\n'; }
+}
+
+struct RestoreOption {
+    int saved = forge::tune::TmDecisiveWinStable;
+    ~RestoreOption() { forge::tune::TmDecisiveWinStable = saved; }
+};
+
+forge::SearchInfo fresh_search(forge::Searcher& searcher, const forge::Board& board, const forge::SearchLimits& limits) {
+    searcher.reset_stop();
+    searcher.clear();
+    return searcher.search(board, limits);
+}
+
+constexpr const char* WonFen = "r5k1/5ppp/8/8/8/2Q5/5PPP/6K1 w - - 0 30";   // white (to move) is winning
+constexpr const char* LostFen = "6k1/5ppp/2q5/8/8/8/5PPP/R5K1 w - - 0 30";  // colour mirror: white (to move) is losing
+} // namespace
+
+int main() {
+    using namespace forge;
+    RestoreOption restore;
+    check(tune::TmDecisiveWinStable == 0, "TmDecisiveWinStable defaults off");
+
+    bool found = false;
+    int registered = 0;
+    for (const tune::Parameter& p : tune::parameters()) {
+        if (std::strcmp(p.name, "TmDecisiveWinStable") == 0) {
+            found = true;
+            ++registered;
+            check(p.value == &tune::TmDecisiveWinStable && p.minimum == 0 && p.maximum == 100,
+                  "TmDecisiveWinStable range 0..100");
+        }
+        check(std::strcmp(p.name, "TmDecisiveWin") != 0, "timepack3's TmDecisiveWin is not in this tree (one option per gate)");
+    }
+    check(found && registered == 1, "TmDecisiveWinStable is registered exactly once");
+
+    // --- pure factor computation (no clock) ---
+    using tune::decisive_win_stable_scale;
+    static_assert(decisive_win_stable_scale(0, 495, 20, 495, false) == 1.0, "off is a no-op");
+    static_assert(decisive_win_stable_scale(60, 495, 20, 495, false) == 0.6, "primary scales by 0.6 when stable");
+    static_assert(decisive_win_stable_scale(60, 495, 20, 500, false) == 1.0, "falling eval skips");
+    static_assert(decisive_win_stable_scale(60, 495, 20, 495, true) == 1.0, "bestmove change skips");
+    const int win = tune::kDecisiveWinStableScoreCp, deep = tune::kDecisiveWinStableMinDepth;
+    check(win == 450 && deep == 8, "constants 450 cp / depth 8");
+    // off / no-op values
+    check(decisive_win_stable_scale(0, 900, 20, 900, false) == 1.0, "pct 0: off");
+    check(decisive_win_stable_scale(-5, 900, 20, 900, false) == 1.0, "negative pct: off");
+    check(decisive_win_stable_scale(100, 900, 20, 900, false) == 1.0, "pct 100: no-op");
+    // stable winning iterations scale
+    check(decisive_win_stable_scale(60, win, deep, win, false) == 0.6, "exactly +450 at depth 8, equal prev, scales");
+    check(decisive_win_stable_scale(60, 495, 22, 454, false) == 0.6, "rising eval scales");
+    check(decisive_win_stable_scale(60, 900, 12, 900, false) == 0.6, "+900 flat scales");
+    check(decisive_win_stable_scale(1, 495, 22, 495, false) == 0.01, "pct 1 scales by 0.01");
+    check(decisive_win_stable_scale(45, 495, 22, 400, false) == 0.45, "pct 45 scales by 0.45");
+    check(decisive_win_stable_scale(60, 500, 20, -20, false) == 0.6, "big rise from a losing prev scales");
+    // F3 skips: falling eval (any drop > 0 cp) or best move changed
+    check(decisive_win_stable_scale(60, 495, 20, 496, false) == 1.0, "1 cp drop skips");
+    check(decisive_win_stable_scale(60, 495, 20, 700, false) == 1.0, "200 cp drop skips");
+    check(decisive_win_stable_scale(60, 900, 20, MateInMaxPly, false) == 1.0, "drop from a mate-in prev skips");
+    check(decisive_win_stable_scale(60, 495, 20, 495, true) == 1.0, "best move changed skips (flat eval)");
+    check(decisive_win_stable_scale(60, 600, 20, 495, true) == 1.0, "best move changed skips (rising eval)");
+    check(decisive_win_stable_scale(60, 495, 20, 700, true) == 1.0, "both falling and changed skip");
+    check(decisive_win_stable_scale(60, 495, 20, ValueNone, false) == 1.0, "no previous iteration skips");
+    // same base guards as timepack3
+    check(decisive_win_stable_scale(60, win - 1, 20, win - 1, false) == 1.0, "+449 does not scale");
+    check(decisive_win_stable_scale(60, 0, 20, 0, false) == 1.0, "equal score does not scale");
+    check(decisive_win_stable_scale(60, -495, 22, -495, false) == 1.0, "losing -495 does not scale");
+    check(decisive_win_stable_scale(60, -win, 22, -900, false) == 1.0, "losing -450 (rising) does not scale");
+    check(decisive_win_stable_scale(60, -5000, 22, -5000, false) == 1.0, "losing -5000 does not scale");
+    check(decisive_win_stable_scale(60, 495, deep - 1, 495, false) == 1.0, "depth 7 does not scale");
+    check(decisive_win_stable_scale(60, 495, 1, 495, false) == 1.0, "depth 1 does not scale");
+    check(decisive_win_stable_scale(60, MateInMaxPly, 20, MateInMaxPly, false) == 1.0, "mate-in score does not scale");
+    check(decisive_win_stable_scale(60, MateValue - 5, 20, MateValue - 5, false) == 1.0, "mate in 3 does not scale");
+    check(decisive_win_stable_scale(60, -MateValue + 4, 20, -MateValue + 4, false) == 1.0, "mated score does not scale");
+    check(decisive_win_stable_scale(60, MateInMaxPly - 1, 20, MateInMaxPly - 1, false) == 0.6, "largest non-mate score scales");
+
+    // --- deterministic searches: option value never changes fixed-depth or fixed-node results ---
+    Searcher searcher(16, 1);
+    Board start, won, lost;
+    check(start.set_fen(Board::StandardStartFen), "startpos parses");
+    check(won.set_fen(WonFen), "won FEN parses");
+    check(lost.set_fen(LostFen), "lost FEN parses");
+    for (const Board* b : {&start, &won, &lost}) {
+        SearchLimits d; d.depth = 10;
+        SearchLimits dc; dc.depth = 10; dc.time_ms = 600000;          // clock plus depth limit
+        SearchLimits nc; nc.nodes = 50000; nc.nodes_specified = true; nc.time_ms = 600000; // clock plus node limit
+        for (const SearchLimits* l : {&d, &dc, &nc}) {
+            tune::TmDecisiveWinStable = 0;
+            const SearchInfo off = fresh_search(searcher, *b, *l);
+            for (int pct : {1, 60, 100}) {
+                tune::TmDecisiveWinStable = pct;
+                const SearchInfo on = fresh_search(searcher, *b, *l);
+                check(on.nodes == off.nodes && on.best_move == off.best_move && on.score == off.score && on.depth == off.depth,
+                      "deterministic search identical with TmDecisiveWinStable=" + std::to_string(pct));
+            }
+        }
+    }
+    tune::TmDecisiveWinStable = 0;
+    {
+        SearchLimits d; d.depth = 10;
+        const SearchInfo w = fresh_search(searcher, won, d), l = fresh_search(searcher, lost, d);
+        check(w.score >= 300, "won FEN scores clearly winning for the side to move (sign sanity)");
+        check(l.score <= -300, "lost FEN scores clearly losing for the side to move (sign sanity)");
+        check(tune::decisive_win_stable_scale(60, l.score, 20, l.score, false) == 1.0, "the lost FEN's own score never scales");
+    }
+
+    std::cout << "timepack4_tests: " << assertions << " assertions, " << failures << " failures\n";
+    return failures == 0 ? 0 : 1;
+}
