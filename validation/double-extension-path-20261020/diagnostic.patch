 namespace forge {
 
+// DIAGNOSTIC ONLY: independent true-path counters and bounded untimed traces.
+namespace {
+struct ExtensionDiagnostic {
+    std::array<int, MaxPly + 8> expected{};
+    std::array<std::uint64_t, 5> events{};
+    std::uint64_t children = 0;
+    std::uint64_t single_extensions = 0;
+    std::uint64_t double_extensions = 0;
+    std::uint64_t singular_attempts = 0;
+    void trace(int kind, const char* event, const Board& board, const SearchStack* ss,
+               Move move, int depth, int extension, int before, int after, bool outer_excluded) {
+        if (++events[static_cast<std::size_t>(kind)] > 12) return;
+        std::cerr << "DE_TRACE {\"event\":\"" << event << "\",\"fen\":\"" << board.fen()
+                  << "\",\"move\":\"" << Board::move_to_uci(move) << "\",\"depth\":" << depth
+                  << ",\"ply\":" << ss->ply << ",\"extension\":" << extension
+                  << ",\"frame_before\":" << before << ",\"frame_after\":" << after
+                  << ",\"parent_actual\":" << (ss - 1)->double_extensions
+                  << ",\"expected_path_before_move\":" << expected[static_cast<std::size_t>(ss->ply)]
+                  << ",\"outer_excluded\":" << outer_excluded
+                  << ",\"current_excluded\":" << !ss->excluded_move.is_none() << "}\n";
+    }
+};
+thread_local ExtensionDiagnostic ExtensionDiag;
+struct ExtensionDiagnosticRun {
+    ExtensionDiagnosticRun() { ExtensionDiag = {}; }
+    ~ExtensionDiagnosticRun() {
+        std::cerr << "DE_SUMMARY {\"children\":" << ExtensionDiag.children
+                  << ",\"single_extensions\":" << ExtensionDiag.single_extensions
+                  << ",\"double_extensions\":" << ExtensionDiag.double_extensions
+                  << ",\"singular_attempts\":" << ExtensionDiag.singular_attempts
+                  << ",\"same_ply_before\":" << ExtensionDiag.events[0]
+                  << ",\"same_ply_changed\":" << ExtensionDiag.events[1]
+                  << ",\"single_parent_mismatch\":" << ExtensionDiag.events[2]
+                  << ",\"eligibility_mismatch\":" << ExtensionDiag.events[3]
+                  << ",\"actual_vs_true_path_mismatch\":" << ExtensionDiag.events[4] << "}\n";
+    }
+};
+} // namespace
