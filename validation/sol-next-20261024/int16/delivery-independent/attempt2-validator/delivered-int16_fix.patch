diff --git a/tests/bad_capture_tests.cpp b/tests/bad_capture_tests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e3e061629379d16926cb98c31798c8ad56c73bab
--- /dev/null
+++ b/tests/bad_capture_tests.cpp
@@ -0,0 +1,149 @@
+// Fixed-input regression for the actual SEE partition and normal search path.
+// The capacity invariant itself is checked beside MovePicker's private storage.
+#include "forge/board.hpp"
+#include "forge/search.hpp"
+
+#include <array>
+#include <cstddef>
+#include <iostream>
+#include <string>
+#include <string_view>
+
+namespace {
+int failures = 0;
+int accepted = 0;
+
+void check(bool okay, const std::string& message) {
+    if (!okay) {
+        ++failures;
+        std::cerr << "FAIL: " << message << '\n';
+    }
+}
+
+struct Fixture {
+    const char* name;
+    const char* fen;
+    bool review_only;
+    std::size_t expected_noisy;
+    std::size_t expected_promotions;
+    const char* required_losing_move;
+};
+
+void run(const Fixture& fixture) {
+    using namespace forge;
+    Board board;
+    std::string error;
+    const bool parsed = board.set_fen(fixture.fen, &error);
+    std::cout << "BAD_CAPTURE_FEN " << fixture.name << " accepted=" << parsed;
+    if (!parsed) {
+        std::cout << " reason=" << error << '\n';
+        // Supplied diagnostic positions must obey the normal FEN parser. Do
+        // not bypass it or substitute an unvalidated internal board state.
+        check(fixture.review_only, std::string(fixture.name) + " control FEN parses: " + error);
+        return;
+    }
+    ++accepted;
+
+    const auto fen = board.fen();
+    const auto key = board.key();
+    const auto pawn_key = board.pawn_key();
+    const auto history = board.history_size();
+    const auto noisy = board.pseudo_legal_moves(true);
+    std::size_t losing = 0;
+    std::size_t promotions = 0;
+    std::size_t legal_losing = 0;
+    for (const Move move : noisy) {
+        check(move.is_capture() || move.is_promotion(),
+              std::string(fixture.name) + " noisy generator emits captures/promotions only");
+        if (move.is_promotion()) ++promotions;
+        if (!board.see_ge(move, 0)) {
+            ++losing;
+            if (board.is_legal(move)) ++legal_losing;
+        }
+    }
+    std::cout << " in_check=" << board.in_check() << " noisy=" << noisy.size()
+              << " see_losing=" << losing << " legal_see_losing=" << legal_losing
+              << " promotions=" << promotions << '\n';
+    check(noisy.size() <= MoveList::Capacity && losing <= noisy.size(),
+          std::string(fixture.name) + " SEE partition remains within producer capacity");
+    check(board.fen() == fen && board.key() == key && board.pawn_key() == pawn_key &&
+          board.history_size() == history,
+          std::string(fixture.name) + " SEE census preserves board state");
+    if (!fixture.review_only) {
+        check(noisy.size() == fixture.expected_noisy,
+              std::string(fixture.name) + " expected noisy move count");
+        check(promotions == fixture.expected_promotions,
+              std::string(fixture.name) + " expected promotion count");
+        check(losing > 0 && legal_losing > 0,
+              std::string(fixture.name) + " contains actual legal SEE-losing moves");
+        check(!board.in_check(), std::string(fixture.name) + " uses main capture stages");
+    }
+
+    SearchLimits limits;
+    limits.depth = 3;
+    Move forced = Move::none();
+    if (std::string_view(fixture.required_losing_move).size() != 0) {
+        const auto move = board.parse_uci(fixture.required_losing_move);
+        check(move.has_value(), std::string(fixture.name) + " required losing move is legal");
+        if (!move) return;
+        forced = *move;
+        check(!board.see_ge(forced, 0), std::string(fixture.name) + " required move fails SEE >= 0");
+        // This legal root restriction requires a deferred losing capture to
+        // be returned by the normal main-search move picker.
+        limits.search_moves_specified = true;
+        limits.search_moves.push_back(forced);
+    }
+    Searcher searcher(16, 1);
+    const SearchInfo result = searcher.search(board, limits);
+    check(result.nodes > 0 && result.depth > 0,
+          std::string(fixture.name) + " normal depth-limited search completes an iteration");
+    check(!result.best_move.is_none() && board.is_legal(result.best_move),
+          std::string(fixture.name) + " search returns a legal best move");
+    if (!forced.is_none()) {
+        check(result.best_move == forced,
+              std::string(fixture.name) + " deferred losing capture survives root restriction");
+    }
+    check(!result.pv.empty() && result.pv.front() == result.best_move,
+          std::string(fixture.name) + " PV starts with the selected move");
+    Board replay = board;
+    for (const Move move : result.pv) {
+        if (!replay.is_legal(move)) {
+            check(false, std::string(fixture.name) + " PV contains an illegal move");
+            break;
+        }
+        Undo undo;
+        if (!replay.make_move(move, undo)) {
+            check(false, std::string(fixture.name) + " legal PV move was rejected");
+            break;
+        }
+    }
+    check(board.fen() == fen && board.key() == key && board.pawn_key() == pawn_key &&
+          board.history_size() == history,
+          std::string(fixture.name) + " search preserves caller board state");
+    std::cout << "BAD_CAPTURE_SEARCH " << fixture.name << " depth=" << result.depth
+              << " nodes=" << result.nodes << " bestmove=" << Board::move_to_uci(result.best_move)
+              << " pv_moves=" << result.pv.size() << '\n';
+}
+} // namespace
+
+int main() {
+    // Exactly the two supplied QA inputs and three existing Forge fixtures.
+    // No generated positions, parser bypasses or direct private-buffer writes.
+    constexpr std::array<Fixture, 5> fixtures{{
+        {"qa-1", "1Q1bq3/pr1Q1p1R/KQ1n1Q1b/1p1Q1n1Q/BQ1p1Q1r/1p1QpN2/1k1pR2p/5NB1 w - - 0 1",
+         true, 0, 0, ""},
+        {"qa-2", "1krQ2b1/8/Q2pQnR1/p1Q3b1/Q1n2QrQ/p1QQpKp1/q1ppR2p/1NB1BN2 w - - 0 1",
+         true, 0, 0, ""},
+        {"poisoned-pawn", "3qk3/8/8/3p4/8/8/8/3QK3 w - - 0 1",
+         false, 1, 0, "d1d5"},
+        {"white-promotions", "1r2k3/P7/8/8/8/8/8/4K3 w - - 0 1",
+         false, 8, 8, ""},
+        {"black-promotions", "4k3/8/8/8/8/8/p7/1R2K3 b - - 0 1",
+         false, 8, 8, ""},
+    }};
+    for (const Fixture& fixture : fixtures) run(fixture);
+    check(accepted >= 3, "all ordinary SEE/search controls execute");
+    std::cout << "Bad capture regression: accepted=" << accepted
+              << " failures=" << failures << '\n';
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tools/check_complete_iteration.py b/tools/check_complete_iteration.py
new file mode 100644
index 0000000000000000000000000000000000000000..6e4153980b8e40736933e98de9f6774efeb8427e
--- /dev/null
+++ b/tools/check_complete_iteration.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""Check actual-UCI completed-iteration preservation, Ponder and restrictions.
+
+The reference must be the frozen guard-OFF lock. Run first with --engine pointing
+to that lock for RED, then with the guarded ON candidate for GREEN. Each search
+is a fresh process. All original exchanges and result records are retained.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from complete_iteration_probe import capture
+
+
+POSITION = "fen rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
+LEGAL = {f"{file}2{file}{rank}" for file in "abcdefgh" for rank in "34"} | {
+    "b1a3", "b1c3", "g1f3", "g1h3"}
+RESTRICTED = ["e2e4", "h2h3", "c2c4", "d2d4"]
+TUPLE = ["depth", "score_kind", "score", "pv", "best", "ponder"]
+
+
+def sha256(path: Path) -> str:
+    with path.open("rb") as stream:
+        return hashlib.file_digest(stream, "sha256").hexdigest()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--engine", type=Path, required=True)
+    parser.add_argument("--reference", type=Path, required=True)
+    parser.add_argument("--outdir", type=Path, required=True)
+    parser.add_argument("--cpu", type=int, help="optional Linux taskset CPU; omitted by default")
+    args = parser.parse_args()
+    args.outdir.mkdir(parents=True, exist_ok=False)
+    results: dict[str, dict] = {}
+    checks: list[dict] = []
+
+    def run(name: str, go: str, reference=False, ponder=False, restricted=False):
+        command = go + (" searchmoves " + " ".join(RESTRICTED) if restricted else "")
+        value = capture(args.reference if reference else args.engine, POSITION, command,
+                        args.outdir / (name + ".raw"), ["Ponder value true"] if ponder else [], args.cpu)
+        results[name] = value
+        return value
+
+    def check(name: str, okay: bool, **details):
+        checks.append({"name": name, "pass": bool(okay), **details})
+        print(("PASS " if okay else "FAIL ") + name, flush=True)
+
+    def same_tuple(name: str, actual: dict, reference: dict, same_nodes=False):
+        differences = {key: {"expected": reference[key], "actual": actual[key]}
+                       for key in TUPLE if actual[key] != reference[key]}
+        if same_nodes and actual["nodes"] != reference["nodes"]:
+            differences["nodes"] = {"expected": reference["nodes"], "actual": actual["nodes"]}
+        check(name, not differences, differences=differences)
+
+    scenarios = [("plain", False, False, 600, 3), ("ponder", True, False, 600, 3),
+                 ("restricted-ponder", True, True, 1800, 7)]
+    for name, ponder, restricted, budget, completed_depth in scenarios:
+        reference = run(name + "-complete-reference", f"depth {completed_depth}", True, ponder, restricted)
+        actual = run(name + "-interrupted", f"nodes {budget}", False, ponder, restricted)
+        same_tuple(name + " preserves last completed tuple", actual, reference)
+        check(name + " reports no unfinished iteration", bool(actual["infos"]) and
+              all(info["depth"] <= completed_depth for info in actual["infos"]))
+        check(name + " bestmove belongs to legal root restriction",
+              actual["best"] in (set(RESTRICTED) if restricted else LEGAL))
+        if ponder:
+            check(name + " ponder suffix matches completed PV", len(reference["pv"]) >= 2 and
+                  actual["best"] == reference["pv"][0] and actual["ponder"] == reference["pv"][1])
+
+        # Node2 completes one root child, but not the depth1 iteration. Prove
+        # that trigger on the unmodified lock, then require a legal empty-PV
+        # fallback from ON. Searchmoves has four legal alternatives, not one.
+        trigger = run(name + "-partial-first-reference", "nodes 2", True, ponder, restricted)
+        check(name + " OFF proves nonempty first-iteration partial PV",
+              bool(trigger["pv"]) and trigger["depth"] == 1 and
+              reference["infos"][0]["depth"] == 1 and reference["infos"][0]["nodes"] > 2)
+        fallback = run(name + "-zero-fallback", "nodes 0", False, ponder, restricted)
+        first = run(name + "-partial-first", "nodes 2", False, ponder, restricted)
+        check(name + " first interrupted iteration keeps legal fallback",
+              not first["infos"] and not first["pv"] and first["ponder"] is None and
+              first["best"] == fallback["best"] and
+              first["best"] in (set(RESTRICTED) if restricted else LEGAL))
+
+    for depth in [4, 10]:
+        reference = run(f"full-depth{depth}-reference", f"depth {depth}", True, True)
+        actual = run(f"full-depth{depth}", f"depth {depth}", False, True)
+        same_tuple(f"completed depth{depth} tuple and nodes unchanged", actual, reference, True)
+
+    record = {"engine": str(args.engine.resolve()), "engine_sha256": sha256(args.engine),
+              "reference": str(args.reference.resolve()), "reference_sha256": sha256(args.reference),
+              "position": POSITION, "history": [], "cpu": args.cpu,
+              "checks": checks, "results": results}
+    (args.outdir / "result.json").write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
+    passed = sum(check["pass"] for check in checks)
+    print(f"{passed}/{len(checks)} checks passed", flush=True)
+    return 0 if passed == len(checks) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/check_complete_iteration_core.cpp b/tools/check_complete_iteration_core.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bb74f536b5d22b974784755e42c4f3f5e4f082a2
--- /dev/null
+++ b/tools/check_complete_iteration_core.cpp
@@ -0,0 +1,108 @@
+// Original public-API check of the complete-iteration result tuple.
+#include "forge/search.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+using namespace forge;
+constexpr const char* StartFen = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
+const std::vector<std::string> Restricted{"e2e4", "h2h3", "c2c4", "d2d4"};
+
+SearchInfo run(int depth, bool limited, std::uint64_t nodes, bool restricted) {
+    Board board;
+    if (!board.set_fen(StartFen)) throw std::runtime_error("initial FEN rejected");
+    Searcher owner(16, 1);
+    SearchLimits limits;
+    limits.depth = depth;
+    limits.nodes_specified = limited;
+    limits.nodes = nodes;
+    limits.search_moves_specified = restricted;
+    if (restricted) {
+        for (const auto& text : Restricted) {
+            const auto move = board.parse_uci(text);
+            if (!move) throw std::runtime_error("restricted root move rejected");
+            limits.search_moves.push_back(*move);
+        }
+    }
+    return owner.search(board, limits, false);
+}
+
+void describe(const std::string& label, const SearchInfo& info) {
+    std::cout << "CASE " << label << " depth=" << info.depth << " score=" << info.score
+              << " nodes=" << info.nodes << " best=" << Board::move_to_uci(info.best_move)
+              << " ponder=" << (info.ponder_move.is_none() ? "none" : Board::move_to_uci(info.ponder_move))
+              << " pv=";
+    for (const auto& move : info.pv) std::cout << Board::move_to_uci(move) << ' ';
+    std::cout << '\n';
+}
+
+bool same_tuple(const SearchInfo& left, const SearchInfo& right) {
+    return left.depth == right.depth && left.score == right.score && left.pv == right.pv &&
+           left.best_move == right.best_move && left.ponder_move == right.ponder_move;
+}
+
+bool legal_pv(const SearchInfo& info) {
+    Board board;
+    if (!board.set_fen(StartFen)) return false;
+    for (const auto move : info.pv) {
+        if (!board.is_legal(move)) return false;
+        Undo undo;
+        if (!board.make_move(move, undo)) return false;
+    }
+    return true;
+}
+} // namespace
+
+int main() {
+    using namespace forge;
+    int assertions = 0;
+    int failures = 0;
+    const auto check = [&](bool okay, const std::string& label) {
+        ++assertions;
+        if (!okay) {
+            ++failures;
+            std::cerr << "FAIL " << label << '\n';
+        }
+    };
+    for (const bool restricted : {false, true}) {
+        const std::string prefix = restricted ? "restricted" : "plain";
+        const int complete_depth = restricted ? 7 : 3;
+        const std::uint64_t stop_nodes = restricted ? 1800 : 600;
+        const auto completed = run(complete_depth, false, 0, restricted);
+        const auto interrupted = run(64, true, stop_nodes, restricted);
+        describe(prefix + "-completed", completed);
+        describe(prefix + "-interrupted", interrupted);
+        check(same_tuple(completed, interrupted), prefix + " completed tuple preserved on node stop");
+        check(interrupted.nodes == stop_nodes, prefix + " total nodes includes unfinished iteration");
+        check(legal_pv(interrupted), prefix + " retained PV is legal");
+        check(!interrupted.pv.empty() && interrupted.best_move == interrupted.pv.front(),
+              prefix + " best move agrees with retained PV");
+        check(interrupted.pv.size() > 1 && interrupted.ponder_move == interrupted.pv[1],
+              prefix + " ponder agrees with retained PV");
+
+        const auto zero = run(64, true, 0, restricted);
+        const auto first = run(64, true, 2, restricted);
+        describe(prefix + "-zero-fallback", zero);
+        describe(prefix + "-first-interrupted", first);
+        Board root;
+        check(root.set_fen(StartFen), prefix + " root parses");
+        check(first.depth == 0 && first.score == 0 && first.pv.empty() && first.ponder_move.is_none(),
+              prefix + " first interrupted result has no completed score/PV");
+        check(first.nodes == 2, prefix + " first interrupted total nodes retained");
+        check(first.best_move == zero.best_move && root.is_legal(first.best_move),
+              prefix + " first interrupted move uses existing legal fallback");
+        if (restricted) {
+            const auto text = Board::move_to_uci(first.best_move);
+            check(std::find(Restricted.begin(), Restricted.end(), text) != Restricted.end(),
+                  "restricted fallback belongs to allowed roots");
+        }
+    }
+    for (const int depth : {4, 10}) describe("normal-depth" + std::to_string(depth), run(depth, false, 0, false));
+    std::cout << "Complete iteration core: assertions " << assertions << " failures " << failures << '\n';
+    return failures ? 1 : 0;
+}
diff --git a/tools/check_nnue_avx512.py b/tools/check_nnue_avx512.py
new file mode 100644
index 0000000000000000000000000000000000000000..91be183884b9ff3312bc245d92098d0d9b4dd653
--- /dev/null
+++ b/tools/check_nnue_avx512.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+"""Attribute every linked FMA and optionally require real AVX-512 NNUE code."""
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+
+HEADER = re.compile(r'^([0-9a-fA-F]+) <(.+)>:$')
+INSTRUCTION = re.compile(r'^\s*([0-9a-fA-F]+):\s+(?:[0-9a-fA-F]{2}\s+)+([a-zA-Z][a-zA-Z0-9_.]*)\s*(.*)$')
+ZMM = re.compile(r'%zmm\d+\b')
+FMA_PREFIXES = ('vfmadd', 'vfnmadd', 'vfmsub', 'vfnmsub')
+NNUE_APIS = ('refresh', 'update', 'evaluate')
+
+
+def is_forge_symbol(symbol):
+    # Symbol ownership comes only from a raw, anchored objdump header. A
+    # template argument, similarly named namespace or operand is not ownership.
+    return bool(re.match(r'^(?:(?:non-virtual|virtual|covariant return) thunk to |transaction clone for )?forge::', symbol))
+
+
+def scan_disassembly(lines):
+    symbols = []
+    current = None
+    fma_hits = []
+    for line in lines:
+        line = line.rstrip('\n')
+        header = HEADER.fullmatch(line)
+        if header:
+            current = {'address': header.group(1), 'name': header.group(2),
+                       'instructions': 0, 'zmm_instructions': 0, 'zmm_mnemonics': {}}
+            symbols.append(current)
+            continue
+        if line.startswith('Disassembly of section '):
+            current = None
+            continue
+        instruction = INSTRUCTION.match(line)
+        if not instruction:
+            continue
+        address, mnemonic, operands = instruction.groups()
+        if current is not None:
+            current['instructions'] += 1
+            if ZMM.search(operands):
+                current['zmm_instructions'] += 1
+                counts = current['zmm_mnemonics']
+                counts[mnemonic] = counts.get(mnemonic, 0) + 1
+        if mnemonic.startswith(FMA_PREFIXES):
+            fma_hits.append({'symbol': current['name'] if current else None,
+                             'symbol_address': current['address'] if current else None,
+                             'address': address, 'mnemonic': mnemonic,
+                             'operands': operands, 'raw': line})
+    return {'symbols': symbols, 'fma_hits': fma_hits,
+            'forge_fma': [h for h in fma_hits if h['symbol'] and is_forge_symbol(h['symbol'])],
+            'nonforge_fma': [h for h in fma_hits if h['symbol'] and not is_forge_symbol(h['symbol'])],
+            'unattributed_fma': [h for h in fma_hits if h['symbol'] is None]}
+
+
+def file_sha256(path):
+    h = hashlib.sha256()
+    with path.open('rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            h.update(block)
+    return h.hexdigest()
+
+
+def audit_binary(binary, output, require_zmm, objdump):
+    initial_hash = file_sha256(binary)
+    raw = output / (binary.name + '.objdump.txt')
+    stderr = output / (binary.name + '.objdump.stderr')
+    command = [objdump, '-Cd', str(binary)]
+    with raw.open('w') as stdout, stderr.open('w') as errors:
+        process = subprocess.run(command, stdout=stdout, stderr=errors)
+    if process.returncode:
+        raise RuntimeError('objdump failed for ' + str(binary) + ': ' + stderr.read_text())
+    with raw.open() as stream:
+        result = scan_disassembly(stream)
+    failures = []
+    if not result['symbols']:
+        failures.append('no raw symbol headers found')
+    if result['forge_fma']:
+        failures.append('fused arithmetic appears in forge:: symbols')
+    if result['unattributed_fma']:
+        failures.append('fused arithmetic appears without a symbol owner')
+    nnue = {}
+    for api in NNUE_APIS:
+        matching = [s for s in result['symbols'] if s['name'].startswith('forge::nnue::' + api + '(')
+                    and ' [clone ' not in s['name']]
+        nnue[api] = matching
+        if require_zmm and (len(matching) != 1 or matching[0]['zmm_instructions'] == 0):
+            failures.append(api + ' lacks one actual public symbol with ZMM instructions')
+    if require_zmm and nnue['evaluate']:
+        mnemonics = nnue['evaluate'][0]['zmm_mnemonics']
+        for instruction in ('vminps', 'vmaxps', 'vmulps', 'vaddps'):
+            if instruction not in mnemonics:
+                failures.append('evaluate lacks ZMM ' + instruction)
+    final_hash = file_sha256(binary)
+    if initial_hash != final_hash:
+        failures.append('executable changed while disassembling')
+    receipt = {'binary': str(binary), 'sha256_before': initial_hash, 'sha256_after': final_hash,
+               'objdump_command': command, 'objdump_returncode': process.returncode,
+               'raw_disassembly': str(raw), 'raw_sha256': file_sha256(raw),
+               'require_zmm': require_zmm, 'symbol_count': len(result['symbols']),
+               'instruction_count': sum(s['instructions'] for s in result['symbols']),
+               'fma_total': len(result['fma_hits']),
+               'forge_fma_count': len(result['forge_fma']),
+               'unattributed_fma_count': len(result['unattributed_fma']),
+               'fma_by_exact_symbol': dict(sorted(Counter(h['symbol'] for h in result['fma_hits'] if h['symbol']).items())),
+               'fma_hits': result['fma_hits'], 'nnue': nnue, 'failures': failures}
+    (output / (binary.name + '.receipt.json')).write_text(json.dumps(receipt, indent=2) + '\n')
+    return receipt
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('binaries', nargs='+', type=Path)
+    parser.add_argument('--output-dir', required=True, type=Path)
+    parser.add_argument('--require-zmm', action='append', default=[], type=Path,
+                        help='Binary path that must contain ZMM in all three actual NNUE APIs')
+    parser.add_argument('--objdump', default='objdump')
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    required = {p.resolve() for p in args.require_zmm}
+    binaries = [p.resolve() for p in args.binaries]
+    if required - set(binaries):
+        parser.error('--require-zmm paths must also appear in binaries')
+    if len({p.name for p in binaries}) != len(binaries):
+        parser.error('binary basenames must be unique within one audit')
+    version = subprocess.run([args.objdump, '--version'], capture_output=True, text=True, check=True).stdout.splitlines()[0]
+    receipts = []
+    for binary in binaries:  # Sequential disassembly keeps the audit at one CPU.
+        receipt = audit_binary(binary, args.output_dir, binary in required, args.objdump)
+        receipts.append(receipt)
+        print(binary.name + ': ' + ('FAIL' if receipt['failures'] else 'PASS') +
+              ', total FMA=' + str(receipt['fma_total']) +
+              ', forge:: FMA=' + str(receipt['forge_fma_count']) +
+              ', unattributed FMA=' + str(receipt['unattributed_fma_count']))
+        for symbol, count in receipt['fma_by_exact_symbol'].items():
+            print('  ' + str(count) + ' ' + symbol)
+        for api, symbols in receipt['nnue'].items():
+            for symbol in symbols:
+                print('  ' + api + ' ZMM=' + str(symbol['zmm_instructions']) + ' @' + symbol['address'])
+        for failure in receipt['failures']:
+            print('  FAIL: ' + failure)
+    (args.output_dir / 'summary.json').write_text(json.dumps({'objdump_version': version, 'receipts': receipts}, indent=2) + '\n')
+    return int(any(r['failures'] for r in receipts))
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/tools/complete_iteration_probe.py b/tools/complete_iteration_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..96a4e6fd9ba8950783af409e36f632e2d2466edc
--- /dev/null
+++ b/tools/complete_iteration_probe.py
@@ -0,0 +1,138 @@
+#!/usr/bin/env python3
+"""Portable, standard-library-only actual-UCI exchange capture."""
+from __future__ import annotations
+
+import argparse
+import queue
+import re
+import shutil
+import subprocess
+import threading
+import time
+from pathlib import Path
+
+
+class Engine:
+    def __init__(self, executable: Path, cpu: int | None = None):
+        command = [str(executable.resolve())]
+        if cpu is not None:
+            taskset = shutil.which("taskset")
+            if taskset is None:
+                raise RuntimeError("--cpu requires taskset; omit --cpu for portable execution")
+            command = [taskset, "-c", str(cpu), *command]
+        self.origin = time.monotonic()
+        self.raw: list[str] = []
+        self.lines: list[str] = []
+        self.pending: queue.Queue[str | None] = queue.Queue()
+        self.process = subprocess.Popen(command, stdin=subprocess.PIPE,
+                                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                        text=True, bufsize=1)
+        self.reader = threading.Thread(target=self._read, daemon=True)
+        self.reader.start()
+
+    def record(self, marker: str, line: str):
+        self.raw.append(f"{time.monotonic() - self.origin:.6f} {marker} {line}")
+
+    def _read(self):
+        assert self.process.stdout is not None
+        for line in self.process.stdout:
+            line = line.rstrip("\r\n")
+            self.lines.append(line)
+            self.record("<", line)
+            self.pending.put(line)
+        self.pending.put(None)
+
+    def send(self, command: str):
+        assert self.process.stdin is not None
+        self.record(">", command)
+        self.process.stdin.write(command + "\n")
+        self.process.stdin.flush()
+
+    def until(self, prefix: str, timeout: float = 20.0):
+        deadline = time.monotonic() + timeout
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise AssertionError(f"response timeout waiting for {prefix!r}")
+            try:
+                line = self.pending.get(timeout=remaining)
+            except queue.Empty as error:
+                raise AssertionError(f"response timeout waiting for {prefix!r}") from error
+            if line is None:
+                raise AssertionError(f"engine exited before {prefix!r}")
+            if line.startswith(prefix):
+                return
+
+    def close(self):
+        if self.process.poll() is None:
+            self.send("quit")
+            try:
+                self.process.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                self.process.kill()
+                self.process.wait()
+                raise AssertionError("engine did not exit after quit")
+        self.reader.join(timeout=5)
+        self.record("=", f"exit {self.process.returncode}")
+        if self.reader.is_alive():
+            raise AssertionError("output reader did not finish")
+        if self.process.returncode != 0:
+            raise AssertionError(f"engine exited {self.process.returncode}")
+
+
+def capture(executable: Path, position: str, go: str, log: Path,
+            options: list[str] | None = None, cpu: int | None = None) -> dict:
+    engine = Engine(executable, cpu)
+    try:
+        engine.send("uci")
+        engine.until("uciok")
+        for option in ["Threads value 1", "Hash value 16", "OwnBook value false", *(options or [])]:
+            engine.send("setoption name " + option)
+        engine.send("ucinewgame")
+        engine.send("isready")
+        engine.until("readyok")
+        engine.send("position " + position)
+        engine.send("go " + go)
+        engine.until("bestmove ")
+    finally:
+        try:
+            engine.close()
+        finally:
+            log.parent.mkdir(parents=True, exist_ok=True)
+            log.write_text("\n".join(engine.raw) + "\n", encoding="utf-8")
+    infos = []
+    for line in engine.lines:
+        if not line.startswith("info depth "):
+            continue
+        match = re.fullmatch(r"info depth (\d+) .*? score (cp|mate) (-?\d+) nodes (\d+) .*? pv(?: (.*))?", line)
+        if match is None:
+            raise AssertionError(f"unrecognized info record: {line!r}")
+        infos.append({"depth": int(match[1]), "score_kind": match[2], "score": int(match[3]),
+                      "nodes": int(match[4]), "pv": (match[5] or "").split(), "raw": line})
+    best_lines = [line for line in engine.lines if line.startswith("bestmove ")]
+    if len(best_lines) != 1:
+        raise AssertionError(f"expected one bestmove, got {best_lines!r}")
+    best = best_lines[0].split()
+    summary = dict(infos[-1]) if infos else {"depth": 0, "score_kind": None, "score": None,
+                                                   "nodes": None, "pv": [], "raw": None}
+    summary.update(best=best[1], ponder=best[3] if len(best) == 4 and best[2] == "ponder" else None,
+                   infos=infos, exit=engine.process.returncode)
+    return summary
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--engine", type=Path, required=True)
+    parser.add_argument("--position", default="startpos")
+    parser.add_argument("--go", required=True)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--option", action="append", default=[])
+    parser.add_argument("--cpu", type=int)
+    args = parser.parse_args()
+    result = capture(args.engine, args.position, args.go, args.out, args.option, args.cpu)
+    import json
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/nnue_abba_bench.py b/tools/nnue_abba_bench.py
new file mode 100644
index 0000000000000000000000000000000000000000..ff99e0eb75271e4b9937a8911875f6b189665bbe
--- /dev/null
+++ b/tools/nnue_abba_bench.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+"""Preregistered fresh-process bench20 ABBA; internal NPS, descriptive ratios only."""
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import re
+import shutil
+import statistics
+import subprocess
+import sys
+import time
+
+INPUT = b"setoption name Threads value 1\nsetoption name Hash value 16\nsetoption name OwnBook value false\nbench 20\nquit\n"
+FLAGS = "GCC 14.2.0 -std=c++20 -O3 -DNDEBUG -DFORGE_NNUE_HIDDEN=256 -ffp-contract=off -fno-fast-math -march=znver5 -static -pthread"
+TIMEOUT = 600
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def write(path, value):
+    with Path(path).open("w") as stream:
+        json.dump(value, stream, indent=2)
+        stream.write("\n")
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def sequence(blocks):
+    if blocks < 4:
+        raise ValueError("at least four complete ABBA blocks are required")
+    plan = [{"role": role, "pair": None, "block": None} for role in ("OFF", "ON") * 2]
+    for block in range(blocks):
+        plan.extend({"role": role, "pair": 2*block+pair, "block": block}
+                    for role, pair in zip(("OFF", "ON", "ON", "OFF"), (0, 0, 1, 1)))
+    return plan
+
+
+def parse_row(raw):
+    lines = [line for line in raw.splitlines() if b"bench depth" in line]
+    match = re.fullmatch(rb"info string bench depth (\d+) nodes (\d+) time (\d+) nps (\d+)", lines[0]) if len(lines) == 1 else None
+    if not match:
+        raise ValueError("expected exactly one complete bench report")
+    depth, nodes, milliseconds, nps = map(int, match.groups())
+    if depth != 20 or nodes != 11901452 or milliseconds <= 0 or nps != nodes*1000//milliseconds:
+        raise ValueError("invalid bench depth, nodes, milliseconds or internal NPS")
+    return dict(depth=depth, nodes=nodes, milliseconds=milliseconds, nps=nps)
+
+
+def source_manifest(root):
+    paths = sorted(p for folder in ("src", "include") for p in (root/folder).rglob("*") if p.is_file())
+    paths += [root/"CMakeLists.txt"] if (root/"CMakeLists.txt").is_file() else []
+    if not paths:
+        raise ValueError("source root has no source files: " + str(root))
+    files = {str(p.relative_to(root)): sha(p) for p in paths}
+    return {"files": files, "sha256": hashlib.sha256(json.dumps(files, sort_keys=True).encode()).hexdigest()}
+
+
+def pins(binary, source):
+    return {"binary_sha256": sha(binary), "source_sha256": source_manifest(source)["sha256"], "runner_sha256": sha(__file__)}
+
+
+def capture(argv, stdin, folder, timeout):
+    (folder/"stdin.bin").write_bytes(stdin)
+    record = {"argv": argv, "started_utc": datetime.now(timezone.utc).isoformat(), "actual_exit": None}
+    start, process = time.monotonic(), None
+    with (folder/"stdout.bin").open("wb") as stdout, (folder/"stderr.bin").open("wb") as stderr:
+        try:
+            process = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=stdout, stderr=stderr)
+            process.communicate(stdin, timeout=timeout)
+            record["status"] = "EXITED"
+        except subprocess.TimeoutExpired:
+            record["status"] = "TIMEOUT"
+            process.kill()
+            process.communicate()
+        except OSError as error:
+            record.update(status="LAUNCH_ERROR", error=repr(error))
+        except KeyboardInterrupt:
+            record["status"] = "INTERRUPTED"
+        finally:
+            if process is not None:
+                if process.poll() is None:
+                    process.kill()
+                    process.wait()
+                record["actual_exit"] = process.returncode
+            record.update(wall_seconds=time.monotonic()-start, closed_utc=datetime.now(timezone.utc).isoformat())
+    record.update({name+"_sha256": sha(folder/(name+".bin")) for name in ("stdin", "stdout", "stderr")})
+    write(folder/"process.json", record)
+    return record
+
+
+def summarize(rows, blocks):
+    if len(rows) != 4 + 4*blocks:
+        raise ValueError("incomplete protocol: no ratio summary")
+    ratios = []
+    for pair in range(2*blocks):
+        selected = [row for row in rows if row["pair"] == pair]
+        if len(selected) != 2 or {row["role"] for row in selected} != {"OFF", "ON"}:
+            raise ValueError("incomplete pair")
+        values = {row["role"]: row["nps"] for row in selected}
+        ratios.append(values["ON"]/values["OFF"])
+    return dict(on_off_pair_ratios=ratios, median_ratio=statistics.median(ratios), min_ratio=min(ratios), max_ratio=max(ratios))
+
+
+def arguments(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    for flag in ("baseline", "candidate", "out"):
+        parser.add_argument("--"+flag, type=Path, required=True)
+    parser.add_argument("--cpu", type=int, default=4)
+    parser.add_argument("--blocks", type=int, default=4)
+    for flag in ("baseline-source", "candidate-source"):
+        parser.add_argument("--"+flag, type=Path, default=Path(__file__).resolve().parents[1])
+    for role in ("baseline", "candidate"):
+        parser.add_argument("--"+role+"-extra-define", action="append", default=[], choices=("FORGE_NNUE_ALIGN64=0", "FORGE_NNUE_ALIGN64=1"))
+    return parser.parse_args(argv)
+
+
+def preflight(args):
+    taskset = shutil.which("taskset")
+    if taskset is None or args.cpu not in range(5) or args.cpu not in os.sched_getaffinity(0):
+        raise ValueError("taskset and the selected allowed CPU 0..4 are required; no CPU substitution")
+    if not args.baseline.is_file() or not args.candidate.is_file():
+        raise ValueError("both binaries must be existing files")
+    sequence(args.blocks)
+    return taskset
+
+
+def run(args):
+    taskset, rows = preflight(args), []
+    args.out.mkdir(parents=True, exist_ok=False)
+    sources = {"OFF": args.baseline_source.resolve(), "ON": args.candidate_source.resolve()}
+    binaries = {"OFF": args.baseline.resolve(), "ON": args.candidate.resolve()}
+    profile = {"created_utc": datetime.now(timezone.utc).isoformat(), "purpose": "Intel Xeon Platinum 8573C cloud VM; not physical Ryzen. VM noise remains; median is descriptive, no Elo or automatic gain/acceptance claim.",
+               "metric": "engine-reported bench NPS; process wall is diagnostic only", "timeout_seconds": TIMEOUT,
+               "cpu": {"selected": args.cpu, "allowed_affinity": sorted(os.sched_getaffinity(0)), "platform": platform.platform(),
+                       "model": next((line.split(":", 1)[1].strip() for line in Path("/proc/cpuinfo").read_text().splitlines() if line.startswith("model name")), "unknown")},
+               "declared_build_flags": {role: FLAGS+" -DFORGE_AVX512="+str(int(role == "ON"))+"".join(" -D"+value for value in getattr(args, "baseline_extra_define" if role == "OFF" else "candidate_extra_define")) for role in binaries},
+               "build_flags_evidence": "declared from frozen build protocol; not inferred from executable bytes",
+               "input_hex": INPUT.hex(), "input_sha256": hashlib.sha256(INPUT).hexdigest(), "effective_bench_options": "bench constructs Searcher(16), default Threads 1; OwnBook is unused by bench",
+               "binaries": {role: {"path": str(binary), **pins(binary, sources[role])} for role, binary in binaries.items()},
+               "sources": {role: {"path": str(source), **source_manifest(source)} for role, source in sources.items()}, "sequence": sequence(args.blocks)}
+    for sample in profile["sequence"]:
+        sample["argv"] = [taskset, "-c", str(args.cpu), str(binaries[sample["role"]])]
+    (args.out/"stdin.bin").write_bytes(INPUT)
+    write(args.out/"profile.json", profile)  # Durable preregistration before the first producer launch.
+    try:
+        for index, sample in enumerate(profile["sequence"]):
+            folder = args.out/f"{index:03d}"
+            folder.mkdir()
+            role = sample["role"]
+            record = {**sample, "before": pins(binaries[role], sources[role])}
+            write(folder/"sample.json", record)
+            try:
+                if record["before"] != {key: profile["binaries"][role][key] for key in record["before"]}:
+                    raise ValueError("preregistered binary/source/runner changed before launch")
+                record.update(capture(sample["argv"], INPUT, folder, TIMEOUT))
+                record["after"] = pins(binaries[role], sources[role])
+                if record["after"] != record["before"]:
+                    raise ValueError("binary/source/runner changed during sample")
+                if record["status"] != "EXITED" or record["actual_exit"] != 0:
+                    raise ValueError("producer failed: " + str(record))
+                record.update(parse_row((folder/"stdout.bin").read_bytes()))
+                rows.append(record)
+            finally:
+                write(folder/"sample.json", record)
+        report = {"status": "COMPLETED", "purpose": profile["purpose"], "metric": profile["metric"], "samples": rows, **summarize(rows, args.blocks)}
+    except Exception as error:
+        report = {"status": "FAILED", "error": repr(error), "completed_samples": len(rows), "ratios": "withheld because protocol is incomplete; no retry or replacement"}
+    report["profile_sha256"] = sha(args.out/"profile.json")
+    write(args.out/"summary.json", report)
+    return 0 if report["status"] == "COMPLETED" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(run(arguments()))
