@@ -0,0 +1,43 @@
+// Original output-layer boundary check for the user's locked H256 weights.
+// Synthetic accumulators are not FEN-parity positions or playing evidence.
+#include "forge/nnue.hpp"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include "../src/nnue_weights.inc"
+
+int main() {
+    using namespace forge;
+    Board board;
+    if (!board.set_fen(Board::StandardStartFen) || !nnue::set_int16(true)) return 2;
+    bool passed = true;
+    for (const bool positive : {true, false}) {
+        nnue::Accumulator integer, floating;
+        integer.valid = floating.valid = true;
+        integer.integer = true;
+        std::int64_t total = 0;
+        for (int side = 0; side < 2; ++side) {
+            for (int h = 0; h < nnue::HiddenSize; ++h) {
+                const auto weight = NnueW2[side * nnue::HiddenSize + h];
+                const bool selected = positive ? weight > 0 : weight < 0;
+                integer.integer_values[static_cast<std::size_t>(side)][static_cast<std::size_t>(h)] = selected ? 4096 : 0;
+                floating.values[static_cast<std::size_t>(side)][static_cast<std::size_t>(h)] = selected ? 1.0F : 0.0F;
+                if (selected) total += static_cast<std::int64_t>(weight) * 8192;
+            }
+        }
+        const double exact = (static_cast<double>(total) / 33554432.0 + static_cast<double>(NnueB2) / 4096.0) * 400.0 / 2.25;
+        const int expected = static_cast<int>(std::clamp(exact, -30000.0, 30000.0));
+        const int actual = nnue::evaluate(board, integer);
+        const int reference = nnue::evaluate(board, floating);
+        const bool exceeds = total > std::numeric_limits<std::int32_t>::max() || total < std::numeric_limits<std::int32_t>::min();
+        const bool ok = exceeds && actual == expected && std::abs(actual - reference) <= 2;
+        passed = passed && ok;
+        std::cout << "{\"case\":\"" << (positive ? "positive" : "negative")
+                  << "\",\"total_i64\":" << total << ",\"exceeds_int32\":" << (exceeds ? "true" : "false")
+                  << ",\"integer_cp\":" << actual << ",\"oracle_cp\":" << expected
+                  << ",\"float_cp\":" << reference << ",\"result\":\"" << (ok ? "PASS" : "FAIL") << "\"}\n";
+    }
+    return passed ? 0 : 1;
+}
diff --git a/tools/nnue_int16_parity.cpp b/tools/nnue_int16_parity.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bd187f08ffacfcfec460e24e4005759b20c3b716
--- /dev/null
+++ b/tools/nnue_int16_parity.cpp
@@ -0,0 +1,343 @@
+// Original Forge H256 runtime-int16 validation driver. No engine source copied.
+// Usage: nnue_int16_parity [unique-positions=100000] [seed=20261024] [fens.txt]
+// Compile against the actual candidate core, with the same hidden-size/FP flags.
+#include "forge/board.hpp"
+#include "forge/eval.hpp"
+#include "forge/nnue.hpp"
+#include "forge/search.hpp"
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+#include "../src/nnue_weights.inc"
+
+namespace {
+using namespace forge;
+constexpr std::size_t H = static_cast<std::size_t>(nnue::HiddenSize);
+using Exact = std::array<std::array<std::int64_t, H>, 2>;
+
+struct Rng {
+    std::uint64_t state;
+    std::uint64_t next() {
+        state ^= state >> 12;
+        state ^= state << 25;
+        state ^= state >> 27;
+        return state * UINT64_C(2685821657736338717);
+    }
+};
+
+struct Stats {
+    std::uint64_t checked = 0, positions = 0, transitions = 0, nulls = 0;
+    std::uint64_t castles = 0, ep = 0, quiet_promotions = 0, capture_promotions = 0;
+    std::uint64_t fresh_lane_mismatches = 0, incremental_lane_mismatches = 0;
+    std::uint64_t output_oracle_mismatches = 0, state_mismatches = 0;
+    std::uint64_t parent_mismatches = 0, in_place_mismatches = 0;
+    std::uint64_t net_sign_flips = 0, total_sign_flips = 0;
+    std::uint64_t net_zero_changes = 0, total_zero_changes = 0, different = 0;
+    std::int64_t minimum_lane = INT64_MAX, maximum_lane = INT64_MIN;
+    std::uint64_t absolute_sum = 0;
+    int maximum_cp = 0;
+    std::vector<std::uint64_t> histogram = std::vector<std::uint64_t>(60001, 0);
+    std::string first_failure, maximum_fen;
+    std::unordered_set<std::string> seen;
+    std::ofstream fens;
+    std::uint64_t corpus_hash = UINT64_C(14695981039346656037);
+
+    void fail(const Board& board, const char* reason) {
+        if (first_failure.empty()) first_failure = std::string(reason) + ": " + board.fen();
+    }
+};
+
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+std::string position_key(const Board& board) {
+    std::string fen = board.fen();
+    std::size_t end = 0;
+    for (int i = 0; i < 4; ++i) {
+        end = fen.find(' ', end);
+        if (end == std::string::npos) return fen;
+        if (i != 3) ++end;
+    }
+    return fen.substr(0, end);
+}
+
+Exact exact_lanes(const Board& board) {
+    Exact result{};
+    for (std::size_t perspective = 0; perspective < 2; ++perspective) {
+        for (std::size_t h = 0; h < H; ++h) result[perspective][h] = NnueB1[h];
+        for (int square = 0; square < 64; ++square) {
+            const Piece piece = board.piece_at(square);
+            if (piece == Empty) continue;
+            // Independent feature-index derivation, not the candidate helper.
+            const std::size_t relative_color = color_of(piece) == static_cast<Color>(perspective) ? 0 : 1;
+            const std::size_t type = static_cast<std::size_t>(piece_type(piece) - 1);
+            const std::size_t relative_square = static_cast<std::size_t>(perspective == White ? square : square ^ 56);
+            const std::size_t feature = (relative_color * 6 + type) * 64 + relative_square;
+            for (std::size_t h = 0; h < H; ++h)
+                result[perspective][h] += NnueW1[feature * H + h];
+        }
+    }
+    return result;
+}
+
+int exact_integer_output(const Board& board, const Exact& exact) {
+    const std::size_t us = static_cast<std::size_t>(board.side_to_move());
+    std::int64_t total = 0;
+    for (std::size_t side = 0; side < 2; ++side) {
+        const std::size_t perspective = side == 0 ? us : 1 - us;
+        for (std::size_t h = 0; h < H; ++h) {
+            const std::int64_t a = std::clamp<std::int64_t>(exact[perspective][h], 0, 4096);
+            const std::int64_t square = (a * a + 1024) / 2048;
+            total += square * NnueW2[side * H + h];
+        }
+    }
+    const double output = static_cast<double>(total) / 33554432.0 + static_cast<double>(NnueB2) / 4096.0;
+    const double cp = output * 400.0 / 2.25;
+    return static_cast<int>(std::clamp(cp, -30000.0, 30000.0));
+}
+
+bool same_active(const nnue::Accumulator& a, const nnue::Accumulator& b) {
+    if (a.valid != b.valid || a.integer != b.integer) return false;
+    for (std::size_t perspective = 0; perspective < 2; ++perspective)
+        for (std::size_t h = 0; h < H; ++h) {
+            if (a.integer) {
+                if (a.integer_values[perspective][h] != b.integer_values[perspective][h]) return false;
+            } else if (std::bit_cast<std::uint32_t>(a.values[perspective][h]) !=
+                       std::bit_cast<std::uint32_t>(b.values[perspective][h])) return false;
+        }
+    return true;
+}
+
+void refresh_pair(const Board& board, nnue::Accumulator& floating, nnue::Accumulator& integer) {
+    (void)nnue::set_int16(false);
+    require(!nnue::int16_active(), "OFF request did not select float");
+    nnue::refresh(board, floating);
+    require(nnue::set_int16(true) && nnue::int16_active(), "int16 backend unavailable");
+    nnue::refresh(board, integer);
+}
+
+void check(const Board& board, const nnue::Accumulator& floating,
+           const nnue::Accumulator& integer, Stats& stats, std::uint64_t target) {
+    ++stats.checked;
+    nnue::Accumulator fresh_float, fresh_integer;
+    refresh_pair(board, fresh_float, fresh_integer);
+    if (!floating.valid || floating.integer || !integer.valid || !integer.integer ||
+        !fresh_float.valid || fresh_float.integer || !fresh_integer.valid || !fresh_integer.integer) {
+        ++stats.state_mismatches;
+        stats.fail(board, "wrong accumulator validity or backend tag");
+    }
+    const Exact exact = exact_lanes(board);
+    bool incremental_bad = false, fresh_bad = false;
+    for (std::size_t perspective = 0; perspective < 2; ++perspective)
+        for (std::size_t h = 0; h < H; ++h) {
+            const auto wanted = exact[perspective][h];
+            stats.minimum_lane = std::min(stats.minimum_lane, wanted);
+            stats.maximum_lane = std::max(stats.maximum_lane, wanted);
+            incremental_bad |= integer.integer_values[perspective][h] != wanted ||
+                !std::isfinite(floating.values[perspective][h]) ||
+                static_cast<double>(floating.values[perspective][h]) * 4096.0 != static_cast<double>(wanted);
+            fresh_bad |= fresh_integer.integer_values[perspective][h] != wanted ||
+                !std::isfinite(fresh_float.values[perspective][h]) ||
+                static_cast<double>(fresh_float.values[perspective][h]) * 4096.0 != static_cast<double>(wanted);
+        }
+    if (incremental_bad) { ++stats.incremental_lane_mismatches; stats.fail(board, "incremental lane oracle mismatch"); }
+    if (fresh_bad) { ++stats.fresh_lane_mismatches; stats.fail(board, "refreshed lane oracle mismatch"); }
+    const int int_cp = nnue::evaluate(board, integer);
+    const int float_cp = nnue::evaluate(board, floating);
+    if (int_cp != exact_integer_output(board, exact) || int_cp != nnue::evaluate(board, fresh_integer) ||
+        float_cp != nnue::evaluate(board, fresh_float)) {
+        ++stats.output_oracle_mismatches;
+        stats.fail(board, "output oracle or refresh evaluation mismatch");
+    }
+    if (stats.positions >= target || !stats.seen.insert(position_key(board)).second) return;
+    ++stats.positions;
+    const int difference = std::abs(int_cp - float_cp);
+    stats.absolute_sum += static_cast<std::uint64_t>(difference);
+    ++stats.histogram[static_cast<std::size_t>(std::min(difference, 60000))];
+    stats.different += difference != 0;
+    stats.net_sign_flips += (int_cp > 0 && float_cp < 0) || (int_cp < 0 && float_cp > 0);
+    stats.net_zero_changes += (int_cp == 0) != (float_cp == 0);
+    const int hand = Evaluator::evaluate_uncached(board);
+    const int full_int = std::clamp(hand + int_cp, -MateInMaxPly + 1, MateInMaxPly - 1);
+    const int full_float = std::clamp(hand + float_cp, -MateInMaxPly + 1, MateInMaxPly - 1);
+    stats.total_sign_flips += (full_int > 0 && full_float < 0) || (full_int < 0 && full_float > 0);
+    stats.total_zero_changes += (full_int == 0) != (full_float == 0);
+    if (difference > stats.maximum_cp) { stats.maximum_cp = difference; stats.maximum_fen = board.fen(); }
+    const std::string fen = board.fen();
+    for (const unsigned char byte : fen) stats.corpus_hash = (stats.corpus_hash ^ byte) * UINT64_C(1099511628211);
+    stats.corpus_hash = (stats.corpus_hash ^ static_cast<unsigned char>('\n')) * UINT64_C(1099511628211);
+    if (stats.fens.is_open()) stats.fens << fen << '\n';
+}
+
+void transition(const Board& board_after, const nnue::DirtyPieces& dirty,
+                nnue::Accumulator& floating, nnue::Accumulator& integer, Stats& stats, bool in_place) {
+    const nnue::Accumulator saved_float = floating, saved_integer = integer;
+    nnue::Accumulator next_float, next_integer;
+    nnue::update(floating, next_float, dirty);
+    nnue::update(integer, next_integer, dirty);
+    ++stats.transitions;
+    if (!same_active(floating, saved_float) || !same_active(integer, saved_integer)) {
+        ++stats.parent_mismatches;
+        stats.fail(board_after, "update mutated its distinct parent");
+    }
+    if (in_place) {
+        nnue::Accumulator alias_float = saved_float, alias_integer = saved_integer;
+        nnue::update(alias_float, alias_float, dirty);
+        nnue::update(alias_integer, alias_integer, dirty);
+        if (!same_active(alias_float, next_float) || !same_active(alias_integer, next_integer)) {
+            ++stats.in_place_mismatches;
+            stats.fail(board_after, "in-place update differs from distinct update");
+        }
+    }
+    floating = next_float;
+    integer = next_integer;
+}
+
+constexpr std::array<const char*, 12> starts{
+    "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+    "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR b KQkq - 0 1",
+    "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
+    "r3k2r/8/8/8/8/8/8/R3K2R b KQkq - 0 1",
+    "4k3/8/8/3pP3/8/8/8/4K3 w - d6 0 1",
+    "4k3/8/8/8/3Pp3/8/8/4K3 b - d3 0 1",
+    "1r2k3/P7/8/8/8/8/7p/4K3 w - - 0 1",
+    "4k3/7P/8/8/8/8/p7/1R2K3 b - - 0 1",
+    "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
+    "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",
+    "r4rk1/1pp1qppp/p1np1n2/8/2B1P1b1/2N2N2/PPP1QPPP/2KR3R w - - 0 10",
+    "2rr3k/pp3pp1/1nnqbN1p/3pN3/2pP4/2P3Q1/PPB4P/R4RK1 w - - 0 1"
+};
+
+void record_move(Move move, Stats& stats) {
+    stats.castles += move.is_castle();
+    stats.ep += (move.flags & EnPassant) != 0U;
+    stats.quiet_promotions += move.is_promotion() && !move.is_capture();
+    stats.capture_promotions += move.is_promotion() && move.is_capture();
+}
+
+void special_cases(Stats& stats, std::uint64_t target) {
+    for (const char* fen : starts) {
+        Board board;
+        require(board.set_fen(fen), "special FEN rejected");
+        nnue::Accumulator base_float, base_integer;
+        refresh_pair(board, base_float, base_integer);
+        check(board, base_float, base_integer, stats, target);
+        for (const Move move : board.legal_moves()) {
+            const auto dirty = nnue::dirty_pieces(board, move);
+            Undo undo;
+            require(board.make_move(move, undo), "special legal move rejected");
+            auto floating = base_float, integer = base_integer;
+            transition(board, dirty, floating, integer, stats, true);
+            record_move(move, stats);
+            check(board, floating, integer, stats, target);
+            board.unmake_move(move, undo);
+        }
+        if (!board.in_check()) {
+            NullUndo undo;
+            board.make_null_move(undo);
+            auto floating = base_float, integer = base_integer;
+            transition(board, nnue::DirtyPieces{}, floating, integer, stats, true);
+            ++stats.nulls;
+            check(board, floating, integer, stats, target);
+            board.unmake_null_move(undo);
+        }
+    }
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    try {
+        const std::uint64_t target = argc > 1 ? std::stoull(argv[1]) : 100000;
+        const std::uint64_t seed = argc > 2 ? std::stoull(argv[2]) : 20261024;
+        require(target > 0 && target <= 10000000, "position count out of range");
+        require(seed != 0, "seed must be nonzero");
+        require(nnue::available() && nnue::int16_available(), "compiled net/int16 unavailable");
+        Stats stats;
+        stats.seen.reserve(static_cast<std::size_t>(target * 2));
+        if (argc > 3) {
+            stats.fens.open(argv[3], std::ios::binary);
+            require(stats.fens.is_open(), "cannot open FEN output");
+        }
+        special_cases(stats, target);
+        Rng rng{seed};
+        while (stats.positions < target) {
+            Board board;
+            // Half of the games start normally; the rest add material/EP/promotion diversity.
+            const std::size_t fixture = (rng.next() & 1U) == 0 ? 0 : static_cast<std::size_t>(rng.next() % starts.size());
+            require(board.set_fen(starts[fixture]), "walk FEN rejected");
+            nnue::Accumulator floating, integer;
+            refresh_pair(board, floating, integer);
+            for (int ply = 0; ply < 240 && stats.positions < target; ++ply) {
+                check(board, floating, integer, stats, target);
+                const MoveList moves = board.legal_moves();
+                if (moves.empty() || board.halfmove_clock() >= 100 || board.is_insufficient_material()) break;
+                const Move move = moves[static_cast<std::size_t>(rng.next() % moves.size())];
+                const auto dirty = nnue::dirty_pieces(board, move);
+                Undo undo;
+                require(board.make_move(move, undo), "walk legal move rejected");
+                transition(board, dirty, floating, integer, stats, stats.transitions % 257 == 0);
+                record_move(move, stats);
+            }
+        }
+        if (stats.fens.is_open()) { stats.fens.flush(); require(stats.fens.good(), "FEN output write failed"); }
+        const std::uint64_t p99_rank = (stats.positions * 99 + 99) / 100;
+        std::uint64_t cumulative = 0;
+        int p99 = 0;
+        for (std::size_t i = 0; i < stats.histogram.size(); ++i) {
+            cumulative += stats.histogram[i];
+            if (cumulative >= p99_rank) { p99 = static_cast<int>(i); break; }
+        }
+        const double mean = static_cast<double>(stats.absolute_sum) / static_cast<double>(stats.positions);
+        const bool clean = stats.fresh_lane_mismatches == 0 && stats.incremental_lane_mismatches == 0 &&
+            stats.output_oracle_mismatches == 0 && stats.state_mismatches == 0 && stats.parent_mismatches == 0 &&
+            stats.in_place_mismatches == 0;
+        const bool coverage = stats.castles >= 4 && stats.ep >= 2 && stats.quiet_promotions >= 8 &&
+            stats.capture_promotions >= 8 && stats.nulls >= 2;
+        const bool passed = clean && coverage && mean <= 2.0 && stats.maximum_cp <= 30;
+        std::cout << std::setprecision(12)
+            << "{\n  \"result\": \"" << (passed ? "PASS" : "FAIL") << "\",\n"
+            << "  \"seed\": " << seed << ",\n  \"unique_four_field_positions\": " << stats.positions
+            << ",\n  \"state_checks\": " << stats.checked << ",\n  \"transitions\": " << stats.transitions
+            << ",\n  \"mean_abs_cp\": " << mean << ",\n  \"max_abs_cp\": " << stats.maximum_cp
+            << ",\n  \"p99_abs_cp\": " << p99 << ",\n  \"different\": " << stats.different
+            << ",\n  \"raw_net_strict_sign_flips\": " << stats.net_sign_flips
+            << ",\n  \"full_static_strict_sign_flips\": " << stats.total_sign_flips
+            << ",\n  \"raw_net_zero_vs_nonzero\": " << stats.net_zero_changes
+            << ",\n  \"full_static_zero_vs_nonzero\": " << stats.total_zero_changes
+            << ",\n  \"fresh_lane_mismatches\": " << stats.fresh_lane_mismatches
+            << ",\n  \"incremental_lane_mismatches\": " << stats.incremental_lane_mismatches
+            << ",\n  \"output_oracle_mismatches\": " << stats.output_oracle_mismatches
+            << ",\n  \"state_mismatches\": " << stats.state_mismatches
+            << ",\n  \"parent_mismatches\": " << stats.parent_mismatches
+            << ",\n  \"in_place_mismatches\": " << stats.in_place_mismatches
+            << ",\n  \"minimum_lane\": " << stats.minimum_lane
+            << ",\n  \"maximum_lane\": " << stats.maximum_lane
+            << ",\n  \"castles\": " << stats.castles << ",\n  \"en_passant\": " << stats.ep
+            << ",\n  \"quiet_promotions\": " << stats.quiet_promotions
+            << ",\n  \"capture_promotions\": " << stats.capture_promotions
+            << ",\n  \"null_moves\": " << stats.nulls
+            << ",\n  \"coverage_pass\": " << (coverage ? "true" : "false")
+            << ",\n  \"fen_stream_fnv1a64\": \"" << std::hex << stats.corpus_hash << std::dec << "\",\n"
+            << "  \"maximum_fen\": \"" << stats.maximum_fen << "\",\n"
+            << "  \"first_failure\": \"" << stats.first_failure << "\"\n}\n";
+        (void)nnue::set_int16(false);
+        return passed ? 0 : 1;
+    } catch (const std::exception& error) {
+        std::cerr << "nnue_int16_parity: " << error.what() << '\n';
+        return 2;
+    }
+}
diff --git a/tools/nnue_million_oracle.cpp b/tools/nnue_million_oracle.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..693acb88294e6e5355402320d46c59d759042723
--- /dev/null
+++ b/tools/nnue_million_oracle.cpp
@@ -0,0 +1,300 @@
+// Original deterministic actual-API oracle. Link this identical source against
+// each frozen core; tools/nnue_million_oracle.py compares the original bytes.
+#include "forge/nnue.hpp"
+
+#include <array>
+#include <bit>
+#include <cfenv>
+#include <charconv>
+#include <cmath>
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#if defined(__SSE__) || defined(_M_X64) || defined(_M_AMD64)
+#include <xmmintrin.h>
+#endif
+#if defined(_WIN32)
+#include <cstdio>
+#include <fcntl.h>
+#include <io.h>
+#endif
+
+namespace {
+constexpr std::uint64_t Seed = 0x243f6a8885a308d3ULL;
+constexpr std::uint32_t RecordBytes = 104U + 2U * (2U * forge::nnue::HiddenSize * 4U + 8U);
+constexpr std::array<const char*, 10> Starts{
+    "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+    "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR b KQkq - 0 1",
+    "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
+    "r3k2r/8/8/8/8/8/8/R3K2R b KQkq - 0 1",
+    "4k3/8/8/3pP3/8/8/8/4K3 w - d6 0 1",
+    "4k3/8/8/8/3Pp3/8/8/4K3 b - d3 0 1",
+    "1r2k3/P7/8/8/8/8/7p/4K3 w - - 0 1",
+    "4k3/7P/8/8/8/8/p7/1R2K3 b - - 0 1",
+    "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
+    "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1"
+};
+std::uint64_t random_state = Seed;
+std::uint64_t random_word() {
+    random_state = random_state * 6364136223846793005ULL + 1442695040888963407ULL;
+    return random_state;
+}
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+void emit32(std::uint32_t value) {
+    char bytes[4];
+    for (int i = 0; i < 4; ++i) bytes[i] = static_cast<char>((value >> (8 * i)) & 255U);
+    std::cout.write(bytes, sizeof bytes);
+}
+void emit64(std::uint64_t value) {
+    emit32(static_cast<std::uint32_t>(value));
+    emit32(static_cast<std::uint32_t>(value >> 32U));
+}
+bool same(const forge::nnue::Accumulator& a, const forge::nnue::Accumulator& b) {
+    if (a.valid != b.valid) return false;
+    for (std::size_t side = 0; side < a.values.size(); ++side)
+        for (std::size_t h = 0; h < a.values[side].size(); ++h)
+            if (std::bit_cast<std::uint32_t>(a.values[side][h]) !=
+                std::bit_cast<std::uint32_t>(b.values[side][h])) return false;
+    return true;
+}
+struct Coverage {
+    std::uint64_t records = 0, fresh = 0, updates = 0, parent = 0, inplace = 0, starts = 0;
+    std::uint32_t games = 0;
+    std::array<std::uint32_t, 2> moves{}, captures{}, ep{};
+    std::array<std::array<std::uint32_t, 2>, 2> castles{};
+    std::array<std::array<std::uint32_t, 4>, 2> quiet_promotions{}, capture_promotions{};
+} coverage;
+
+void emit_accumulator(const forge::Board& board, const forge::nnue::Accumulator& acc) {
+    require(acc.valid, "invalid actual accumulator");
+    for (const auto& side : acc.values)
+        for (float value : side) {
+            require(std::isfinite(value), "nonfinite actual accumulator");
+            emit32(std::bit_cast<std::uint32_t>(value));
+        }
+    emit32(static_cast<std::uint32_t>(forge::nnue::evaluate(board, acc)));
+    emit32(acc.valid ? 1U : 0U);
+}
+void snapshot(const forge::Board& board, const forge::nnue::Accumulator& incremental,
+              std::uint32_t ply, std::uint32_t kind, forge::Move move) {
+    forge::nnue::Accumulator fresh;
+    forge::nnue::refresh(board, fresh);
+    ++coverage.fresh;
+    emit64(coverage.records++);
+    emit64(board.key());
+    emit32(coverage.games - 1U);
+    emit32(ply);
+    emit32(kind);
+    emit32(static_cast<std::uint32_t>(move.from) |
+           (static_cast<std::uint32_t>(move.to) << 8U) |
+           (static_cast<std::uint32_t>(move.promotion) << 16U) |
+           (static_cast<std::uint32_t>(move.flags) << 24U));
+    emit32(static_cast<std::uint32_t>(board.side_to_move()));
+    emit32(0U);
+    for (int square = 0; square < 64; ++square)
+        std::cout.put(static_cast<char>(board.piece_at(square)));
+    // These are compared to the corresponding fields in the other core, not
+    // asserted equal to one another: their addition histories may differ.
+    emit_accumulator(board, incremental);
+    emit_accumulator(board, fresh);
+}
+void record_move(forge::Color color, forge::Move move) {
+    const auto side = static_cast<std::size_t>(color);
+    ++coverage.moves[side];
+    if (move.is_capture()) ++coverage.captures[side];
+    if ((move.flags & forge::EnPassant) != 0U) ++coverage.ep[side];
+    if (move.is_castle()) ++coverage.castles[side][(move.flags & forge::KingCastle) != 0U ? 0U : 1U];
+    if (move.is_promotion()) {
+        require(move.promotion >= forge::Knight && move.promotion <= forge::Queen, "invalid promotion");
+        auto& counts = move.is_capture() ? coverage.capture_promotions : coverage.quiet_promotions;
+        ++counts[side][static_cast<std::size_t>(move.promotion - forge::Knight)];
+    }
+}
+forge::nnue::Accumulator transition(forge::Board& board, const forge::nnue::Accumulator& parent,
+                                  forge::Move move, forge::Undo& undo) {
+    const auto dirty = forge::nnue::dirty_pieces(board, move);
+    const auto before = parent;
+    record_move(board.side_to_move(), move);
+    require(board.make_move(move, undo), "legal move rejected");
+    forge::nnue::Accumulator child;
+    for (auto& side : child.values) side.fill(-0x1.fffffep10F);
+    forge::nnue::update(parent, child, dirty);
+    ++coverage.updates;
+    require(same(parent, before), "distinct update modified parent");
+    ++coverage.parent;
+    auto inplace = parent;
+    forge::nnue::update(inplace, inplace, dirty);
+    require(child.valid && same(child, inplace), "in-place and distinct updates differ");
+    ++coverage.inplace;
+    return child;
+}
+forge::nnue::Accumulator start(forge::Board& board, const char* fen) {
+    require(board.set_fen(fen), "invalid fixture");
+    ++coverage.games;
+    ++coverage.starts;
+    forge::nnue::Accumulator acc;
+    forge::nnue::refresh(board, acc);
+    snapshot(board, acc, 0U, 0U, forge::Move::none());
+    return acc;
+}
+void emit_header(std::uint64_t count, std::uint64_t seed) {
+    emit32(0x314f4d4eU); // NMO1
+    emit32(1U);
+    emit32(static_cast<std::uint32_t>(forge::nnue::HiddenSize));
+    emit32(RecordBytes);
+    emit64(count);
+    emit64(seed);
+#if defined(__SSE__) || defined(_M_X64) || defined(_M_AMD64)
+    emit32(_mm_getcsr() & 0x0000ffc0U);
+#else
+    emit32(0xffffffffU);
+#endif
+    emit32(static_cast<std::uint32_t>(std::fegetround()));
+    emit32(192U);
+    emit32(static_cast<std::uint32_t>(Starts.size()));
+    emit32(2U);
+    emit32(0U); emit32(0U); emit32(0U);
+}
+template<std::size_t N>
+void json_array(const std::array<std::uint32_t, N>& values) {
+    std::cerr << '[';
+    for (std::size_t i = 0; i < N; ++i) {
+        if (i != 0U) std::cerr << ',';
+        std::cerr << values[i];
+    }
+    std::cerr << ']';
+}
+template<std::size_t Rows, std::size_t Cols>
+void json_matrix(const std::array<std::array<std::uint32_t, Cols>, Rows>& values) {
+    std::cerr << '[';
+    for (std::size_t i = 0; i < Rows; ++i) {
+        if (i != 0U) std::cerr << ',';
+        json_array(values[i]);
+    }
+    std::cerr << ']';
+}
+void emit_trailer(std::uint64_t count, std::uint64_t seed) {
+    require(coverage.records == count && coverage.fresh == count &&
+            coverage.updates + coverage.starts == count &&
+            coverage.parent == coverage.updates && coverage.inplace == coverage.updates,
+            "position/API coverage count mismatch");
+    emit32(0x544f4d4eU); // NMOT
+    emit32(1U);
+    emit64(coverage.records); emit64(coverage.fresh); emit64(coverage.updates);
+    emit64(coverage.parent); emit64(coverage.inplace); emit64(coverage.games); emit64(coverage.starts);
+    for (auto n : coverage.moves) emit32(n);
+    for (auto n : coverage.captures) { require(n != 0U, "missing capture color"); emit32(n); }
+    for (auto n : coverage.ep) { require(n != 0U, "missing en-passant color"); emit32(n); }
+    for (const auto& side : coverage.castles)
+        for (auto n : side) { require(n != 0U, "missing castle side/color"); emit32(n); }
+    for (const auto& side : coverage.quiet_promotions)
+        for (auto n : side) { require(n != 0U, "missing quiet promotion type/color"); emit32(n); }
+    for (const auto& side : coverage.capture_promotions)
+        for (auto n : side) { require(n != 0U, "missing capture promotion type/color"); emit32(n); }
+    for (int i = 42; i < 64; ++i) emit32(0U);
+    std::cerr << "records=" << coverage.records << " refresh=" << coverage.fresh
+              << " updates=" << coverage.updates << " parent_checks=" << coverage.parent
+              << " inplace_checks=" << coverage.inplace << " games=" << coverage.games
+              << " genuine_boards=yes special_moves=both_colors_all_promotions\n";
+    std::cerr << "{\"kind\":\"nnue_million_oracle\",\"positions\":" << count
+              << ",\"records\":" << coverage.records << ",\"seed\":" << seed
+              << ",\"refresh\":" << coverage.fresh << ",\"updates\":" << coverage.updates
+              << ",\"parent_checks\":" << coverage.parent
+              << ",\"inplace_checks\":" << coverage.inplace << ",\"games\":" << coverage.games
+              << ",\"starts\":" << coverage.starts << ",\"moves\":";
+    json_array(coverage.moves);
+    std::cerr << ",\"captures\":"; json_array(coverage.captures);
+    std::cerr << ",\"en_passant\":"; json_array(coverage.ep);
+    std::cerr << ",\"castles\":"; json_matrix(coverage.castles);
+    std::cerr << ",\"quiet_promotions\":"; json_matrix(coverage.quiet_promotions);
+    std::cerr << ",\"capture_promotions\":"; json_matrix(coverage.capture_promotions);
+    std::cerr << ",\"genuine_boards\":true}\n";
+}
+std::uint64_t unsigned_argument(std::string_view value) {
+    std::uint64_t result = 0;
+    const auto parsed = std::from_chars(value.data(), value.data() + value.size(), result);
+    require(!value.empty() && parsed.ec == std::errc{} && parsed.ptr == value.data() + value.size(),
+            "invalid unsigned decimal argument");
+    return result;
+}
+void wait_for_start() {
+    std::string line;
+    require(static_cast<bool>(std::getline(std::cin, line)), "start command required on stdin");
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    require(line == "start", "expected start command on stdin");
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    try {
+#if defined(_WIN32)
+        require(_setmode(_fileno(stdout), _O_BINARY) != -1, "binary stdout unavailable");
+#endif
+        std::uint64_t count = 1000000U;
+        std::uint64_t seed = Seed;
+        bool wait_start = false, positions_seen = false, seed_seen = false;
+        for (int i = 1; i < argc; ++i) {
+            const std::string_view option(argv[i]);
+            if (option == "--positions" || option == "--seed") {
+                require(i + 1 < argc, "option requires an unsigned decimal argument");
+                auto& seen = option == "--positions" ? positions_seen : seed_seen;
+                require(!seen, "duplicate option");
+                seen = true;
+                auto& value = option == "--positions" ? count : seed;
+                value = unsigned_argument(argv[++i]);
+            } else if (option == "--wait-start") {
+                require(!wait_start, "duplicate option");
+                wait_start = true;
+            } else {
+                throw std::runtime_error("usage: nnue_million_oracle [--positions COUNT] [--seed UINT64] [--wait-start]");
+            }
+        }
+        require(count >= 1024U && count <= std::numeric_limits<std::uint32_t>::max(),
+                "position count must be in [1024, 4294967295]");
+        std::ios::sync_with_stdio(false);
+        if (wait_start) wait_for_start();
+        random_state = seed;
+        require(forge::nnue::available(), "NNUE network required");
+        require(std::fegetround() == FE_TONEAREST, "round-to-nearest required");
+        emit_header(count, seed);
+        forge::Board board;
+        // Exhaust legal first moves before any random choices, guaranteeing
+        // captures, both castles, EP and all promotions for both colors.
+        for (const char* fen : Starts) {
+            const auto parent = start(board, fen);
+            for (auto move : board.legal_moves()) {
+                forge::Undo undo;
+                const auto child = transition(board, parent, move, undo);
+                snapshot(board, child, 1U, 1U, move);
+                board.unmake_move(move, undo);
+            }
+        }
+        require(coverage.records < count, "fixtures exceed requested count");
+        while (coverage.records < count) {
+            // Each independent walk is bounded to 192 legal plies, preserving
+            // middlegame diversity rather than spending the corpus on lone kings.
+            const auto fixture = static_cast<std::size_t>(random_word() % Starts.size());
+            auto acc = start(board, Starts[fixture]);
+            for (std::uint32_t ply = 1U; ply <= 192U && coverage.records < count; ++ply) {
+                const auto moves = board.legal_moves();
+                if (moves.empty()) break;
+                const auto move = moves[static_cast<std::size_t>(random_word() % moves.size())];
+                forge::Undo undo;
+                acc = transition(board, acc, move, undo);
+                snapshot(board, acc, ply, 2U, move);
+            }
+        }
+        emit_trailer(count, seed);
+        std::cout.flush();
+        require(static_cast<bool>(std::cout), "oracle stdout write failed");
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "nnue_million_oracle: " << error.what() << '\n';
+        return 1;
+    }
+}
