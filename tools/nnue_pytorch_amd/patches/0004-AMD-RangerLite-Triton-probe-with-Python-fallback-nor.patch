+        device = torch.device("cuda", torch.cuda.current_device())
     key = str(device)
     if key not in _probe_cache:
         try:
diff --git a/model/optimizers/ranger_lite.py b/model/optimizers/ranger_lite.py
index c107b3f..167ce38 100644
--- a/model/optimizers/ranger_lite.py
+++ b/model/optimizers/ranger_lite.py
@@ -35,6 +35,31 @@ if not _HAS_CUPY and os.environ.get("NNUE_RANGER_FUSED", "1").strip() != "0":
         _rlt = None
 _HAS_FUSED = _HAS_CUPY or _HAS_TRITON_FUSED
 
+_triton_probe: dict[str, bool] = {}
+
+
+def _triton_fused_usable(device) -> bool:
+    """Run one tiny Triton update per device; on failure (e.g. the venv's rocm-sdk
+    is not on PATH, so Triton cannot build its HIP driver) use the Python path."""
+    device = torch.device(device)
+    if device.type == "cuda" and device.index is None:
+        device = torch.device("cuda", torch.cuda.current_device())
+    key = str(device)
+    if key not in _triton_probe:
+        try:
+            g = torch.ones(4, device=device)
+            vm = torch.zeros(4, device=device)
+            _rlt.variance(g, vm, 0.5, 0.5)
+            _triton_probe[key] = bool(torch.equal(vm, torch.full_like(vm, 0.5)))
+        except Exception as e:  # noqa: BLE001
+            _triton_probe[key] = False
+            warnings.warn(
+                f"RangerLite: Triton fused kernels unusable ({type(e).__name__}: {e}); "
+                "using the Python update path.",
+                stacklevel=2,
+            )
+    return _triton_probe[key]
+
 
 class _RangerLiteFusedKernels:
     """Cached CuPy fused update kernels.
@@ -328,6 +353,8 @@ class RangerLite(torch.optim.Optimizer):
                 return False
             if p.dtype != torch.float32 or p.device.type != "cuda":
                 return False
+            if not _HAS_CUPY and not _triton_fused_usable(p.device):
+                return False
             if not p.is_contiguous() or not grad.is_contiguous():
                 return False
             state = self.state[p]
diff --git a/tests/test_amd_triton_ft.py b/tests/test_amd_triton_ft.py
index 797cb9a..e899a1d 100644
--- a/tests/test_amd_triton_ft.py
+++ b/tests/test_amd_triton_ft.py
@@ -134,8 +134,12 @@ def main() -> int:
         return 2
     ok = True
     t0 = time.time()
+    cases = CASES
+    if "--small" in sys.argv:  # PC rule after 2026-10-29: no L1 1024 shapes while the live trainer runs
+        cases = [c for c in CASES if c[4] <= 256]
+        print("small mode: L1 <= 256 cases only")
     print(f"{'case':24s} {'fwd':>10s} {'grad_w':>10s} {'grad_b':>10s}  verdict (tol {TOL:g})")
-    for case in CASES:
+    for case in cases:
         for label, (d_out, d_w, d_b) in check_case(*case):
             good = max(d_out, d_w, d_b) < TOL
             ok &= good
diff --git a/tests/test_amd_triton_ranger.py b/tests/test_amd_triton_ranger.py
index 8e20370..2865939 100644
--- a/tests/test_amd_triton_ranger.py
+++ b/tests/test_amd_triton_ranger.py
@@ -93,10 +93,10 @@ EXPECTED = {  # path -> launchers that must run (4 params x 12 steps = 48 calls
 def main() -> int:
     print(f"torch {torch.__version__} hip {torch.version.hip}; cupy={rl._HAS_CUPY} "
           f"triton_fused={rl._HAS_TRITON_FUSED}")
-    if not rl._HAS_TRITON_FUSED:
+    if not rl._HAS_TRITON_FUSED or not rl._triton_fused_usable(DEV):
         print("FAIL: Triton fused RangerLite not available")
         return 2
-    count_kernel_calls()
+    count_kernel_calls()  # after the one-time probe, so it does not count
     ok = True
     for tiny in (False, True):
         for pnm in (True, False):
@@ -115,10 +115,40 @@ def main() -> int:
                 print(f"{'denormal-vm' if tiny else 'normal-grads':12s} pnm={pnm!s:5s} wd={wd:<5g} "
                       f"stable_wd={stable!s:5s} path {path:5s}: max abs diff {d:.3e}, finite={finite}, "
                       f"triton calls {CALLS} (python run: {ref_calls or 'none'})  {'PASS' if good else 'FAIL'}")
+    ok &= check_fallback()
     print("RESULT", "PASS" if ok else "FAIL")
     return 0 if ok else 1
 
 
+def check_fallback() -> bool:
+    """A Triton launch failure (e.g. venv not on PATH) must fall back to the Python path, not crash."""
+    import warnings
+
+    saved_probe = dict(rl._triton_probe)
+    saved_variance = rl._rlt.variance
+
+    def broken(*a, **k):
+        raise RuntimeError("simulated Triton launch failure")
+
+    rl._triton_probe.clear()
+    rl._rlt.variance = broken
+    try:
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            ref = run(False, True, 1e-2, True, steps=3)
+            got = run(True, True, 1e-2, True, steps=3)
+        warned = any("Triton fused kernels unusable" in str(x.message) for x in w)
+        d = max((a - b).abs().max().item() for a, b in zip(ref, got))
+        good = warned and d == 0.0
+        print(f"fallback on Triton failure: warned={warned}, diff vs Python path {d:.1e}  "
+              f"{'PASS' if good else 'FAIL'}")
+        return good
+    finally:
+        rl._rlt.variance = saved_variance
+        rl._triton_probe.clear()
+        rl._triton_probe.update(saved_probe)
+
+
 def test_triton_ranger_matches_python():
     assert main() == 0
 
