 .../triton_ft_functions.py                    |  2 ++
 model/optimizers/ranger_lite.py               | 27 +++++++++++++++
 tests/test_amd_triton_ft.py                   |  6 +++-
 tests/test_amd_triton_ranger.py               | 34 +++++++++++++++++--
 4 files changed, 66 insertions(+), 3 deletions(-)

diff --git a/model/modules/feature_transformer/triton_ft_functions.py b/model/modules/feature_transformer/triton_ft_functions.py
index 8ff4834..2df82e5 100644
--- a/model/modules/feature_transformer/triton_ft_functions.py
+++ b/model/modules/feature_transformer/triton_ft_functions.py
@@ -34,6 +34,8 @@ def triton_usable(device: torch.device) -> bool:
         return False
     if device.type != "cuda":
         return False
