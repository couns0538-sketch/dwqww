diff --git a/model/optimizers/ranger_lite_triton.py b/model/optimizers/ranger_lite_triton.py
new file mode 100644
index 0000000..e357793
--- /dev/null
+++ b/model/optimizers/ranger_lite_triton.py
@@ -0,0 +1,195 @@
+"""Triton versions of the fused RangerLite update kernels (GPL-3.0, nnue-pytorch).
+
+Same arithmetic as the CuPy kernels in ranger_lite.py (_RangerLiteFusedKernels),
+one element per lane, so AMD GPUs (ROCm on Windows, no CuPy) get the fused path.
+All tensors are contiguous fp32 on one GPU; scalars are passed as fp32.
+
+Denormals: on gfx1100 with triton-windows 3.6, tl.sqrt_rn returns NaN for
+every fp32 denormal input (tl.sqrt flushes them to 0). variance_ma reaches
+denormals once a gradient is ~1e-19, so the denominator flushes them to 0
+first; the result differs from the exact sqrt by < 1e-19 before eps (1e-7).
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+BLOCK = 1024
+_FLT_MIN = tl.constexpr(1.1754943508222875e-38)  # smallest normal fp32
+
+
+@triton.jit
+def _sqrt_no_denormal(x):
+    return tl.sqrt_rn(tl.where(x < _FLT_MIN, 0.0, x))
+
+
+@triton.jit
+def _pnm_full_kernel(
+    p_ptr, g_ptr, gm_ptr, ngm_ptr, vm_ptr, n,
+    beta2, one_minus_beta2, bias_correction2, beta1_sq, one_minus_beta1_sq,
+    one_plus_pnm, pnm_factor, noise_norm, lr_div_bc1, eps, wd_factor,
+    ODD: tl.constexpr, BLOCK: tl.constexpr,
+):
+    offs = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < n
+    g = tl.load(g_ptr + offs, mask=m, other=0.0)
+    vm = tl.load(vm_ptr + offs, mask=m, other=0.0) * beta2 + g * g * one_minus_beta2
+    tl.store(vm_ptr + offs, vm, mask=m)
+    denom = _sqrt_no_denormal(vm / bias_correction2) + eps
+    gm = tl.load(gm_ptr + offs, mask=m, other=0.0)
+    ngm = tl.load(ngm_ptr + offs, mask=m, other=0.0)
+    if ODD:
+        pgm = gm
+        pngm = ngm
+    else:
+        pgm = ngm
+        pngm = gm
+    new_pgm = pgm * beta1_sq + g * one_minus_beta1_sq
+    pnm_val = (new_pgm * one_plus_pnm - pngm * pnm_factor) / noise_norm
+    p = tl.load(p_ptr + offs, mask=m, other=0.0)
+    p = p * (1.0 - wd_factor)
+    p = p - lr_div_bc1 * (pnm_val / denom)
+    tl.store(p_ptr + offs, p, mask=m)
+    if ODD:
+        tl.store(gm_ptr + offs, new_pgm, mask=m)
+    else:
+        tl.store(ngm_ptr + offs, new_pgm, mask=m)
+
+
+@triton.jit
+def _adam_full_kernel(
+    p_ptr, g_ptr, gm_ptr, vm_ptr, n,
+    beta2, one_minus_beta2, bias_correction2, beta1, one_minus_beta1,
+    lr_div_bc1, eps, wd_factor,
+    BLOCK: tl.constexpr,
+):
+    offs = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < n
+    g = tl.load(g_ptr + offs, mask=m, other=0.0)
+    vm = tl.load(vm_ptr + offs, mask=m, other=0.0) * beta2 + g * g * one_minus_beta2
+    tl.store(vm_ptr + offs, vm, mask=m)
+    denom = _sqrt_no_denormal(vm / bias_correction2) + eps
+    gm = tl.load(gm_ptr + offs, mask=m, other=0.0) * beta1 + g * one_minus_beta1
+    tl.store(gm_ptr + offs, gm, mask=m)
+    p = tl.load(p_ptr + offs, mask=m, other=0.0)
+    p = p * (1.0 - wd_factor)
+    p = p - lr_div_bc1 * (gm / denom)
+    tl.store(p_ptr + offs, p, mask=m)
+
+
+@triton.jit
+def _variance_kernel(g_ptr, vm_ptr, n, beta2, one_minus_beta2, BLOCK: tl.constexpr):
+    offs = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < n
+    g = tl.load(g_ptr + offs, mask=m, other=0.0)
+    vm = tl.load(vm_ptr + offs, mask=m, other=0.0) * beta2 + g * g * one_minus_beta2
+    tl.store(vm_ptr + offs, vm, mask=m)
+
+
+@triton.jit
+def _pnm_phase2_kernel(
+    p_ptr, g_ptr, gm_ptr, ngm_ptr, vm_ptr, n,
+    bias_correction2, beta1_sq, one_minus_beta1_sq,
+    one_plus_pnm, pnm_factor, noise_norm, lr_div_bc1, eps, wd_factor,
+    ODD: tl.constexpr, BLOCK: tl.constexpr,
+):
+    offs = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < n
+    vm = tl.load(vm_ptr + offs, mask=m, other=0.0)
+    denom = _sqrt_no_denormal(vm / bias_correction2) + eps
+    g = tl.load(g_ptr + offs, mask=m, other=0.0)
+    gm = tl.load(gm_ptr + offs, mask=m, other=0.0)
+    ngm = tl.load(ngm_ptr + offs, mask=m, other=0.0)
+    if ODD:
+        pgm = gm
+        pngm = ngm
+    else:
+        pgm = ngm
+        pngm = gm
+    new_pgm = pgm * beta1_sq + g * one_minus_beta1_sq
+    pnm_val = (new_pgm * one_plus_pnm - pngm * pnm_factor) / noise_norm
+    p = tl.load(p_ptr + offs, mask=m, other=0.0)
+    p = p * (1.0 - wd_factor)
+    p = p - lr_div_bc1 * (pnm_val / denom)
+    tl.store(p_ptr + offs, p, mask=m)
+    if ODD:
+        tl.store(gm_ptr + offs, new_pgm, mask=m)
+    else:
+        tl.store(ngm_ptr + offs, new_pgm, mask=m)
+
+
+@triton.jit
+def _adam_phase2_kernel(
+    p_ptr, g_ptr, gm_ptr, vm_ptr, n,
+    bias_correction2, beta1, one_minus_beta1, lr_div_bc1, eps, wd_factor,
+    BLOCK: tl.constexpr,
+):
+    offs = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < n
+    vm = tl.load(vm_ptr + offs, mask=m, other=0.0)
+    denom = _sqrt_no_denormal(vm / bias_correction2) + eps
+    g = tl.load(g_ptr + offs, mask=m, other=0.0)
+    gm = tl.load(gm_ptr + offs, mask=m, other=0.0) * beta1 + g * one_minus_beta1
+    tl.store(gm_ptr + offs, gm, mask=m)
+    p = tl.load(p_ptr + offs, mask=m, other=0.0)
+    p = p * (1.0 - wd_factor)
+    p = p - lr_div_bc1 * (gm / denom)
+    tl.store(p_ptr + offs, p, mask=m)
+
+
+def _grid(n):
+    return (triton.cdiv(n, BLOCK),)
+
+
+@torch.compiler.disable
+def pnm_full(p, g, gm, ngm, vm, beta2, one_minus_beta2, bias_correction2, beta1_sq,
+             one_minus_beta1_sq, one_plus_pnm, pnm_factor, noise_norm, lr_div_bc1, eps, step, wd_factor):
+    n = p.numel()
+    _pnm_full_kernel[_grid(n)](
+        p, g, gm, ngm, vm, n,
+        float(beta2), float(one_minus_beta2), float(bias_correction2), float(beta1_sq),
+        float(one_minus_beta1_sq), float(one_plus_pnm), float(pnm_factor), float(noise_norm),
+        float(lr_div_bc1), float(eps), float(wd_factor),
+        ODD=bool(step & 1), BLOCK=BLOCK,
+    )
+
+
+@torch.compiler.disable
+def adam_full(p, g, gm, vm, beta2, one_minus_beta2, bias_correction2, beta1, one_minus_beta1,
+              lr_div_bc1, eps, wd_factor):
+    n = p.numel()
+    _adam_full_kernel[_grid(n)](
+        p, g, gm, vm, n,
+        float(beta2), float(one_minus_beta2), float(bias_correction2), float(beta1),
+        float(one_minus_beta1), float(lr_div_bc1), float(eps), float(wd_factor),
+        BLOCK=BLOCK,
+    )
+
+
+@torch.compiler.disable
+def variance(g, vm, beta2, one_minus_beta2):
+    n = g.numel()
+    _variance_kernel[_grid(n)](g, vm, n, float(beta2), float(one_minus_beta2), BLOCK=BLOCK)
+
+
+@torch.compiler.disable
+def pnm_phase2(p, g, gm, ngm, vm, bias_correction2, beta1_sq, one_minus_beta1_sq, one_plus_pnm,
+               pnm_factor, noise_norm, lr_div_bc1, eps, step, wd_factor):
+    n = p.numel()
+    _pnm_phase2_kernel[_grid(n)](
+        p, g, gm, ngm, vm, n,
+        float(bias_correction2), float(beta1_sq), float(one_minus_beta1_sq), float(one_plus_pnm),
+        float(pnm_factor), float(noise_norm), float(lr_div_bc1), float(eps), float(wd_factor),
+        ODD=bool(step & 1), BLOCK=BLOCK,
+    )
+
+
+@torch.compiler.disable
+def adam_phase2(p, g, gm, vm, bias_correction2, beta1, one_minus_beta1, lr_div_bc1, eps, wd_factor):
+    n = p.numel()
+    _adam_phase2_kernel[_grid(n)](
+        p, g, gm, vm, n,
+        float(bias_correction2), float(beta1), float(one_minus_beta1), float(lr_div_bc1),
+        float(eps), float(wd_factor),
+        BLOCK=BLOCK,
+    )
diff --git a/tests/bench_amd_triton_ft.py b/tests/bench_amd_triton_ft.py
new file mode 100644
index 0000000..6739cb4
--- /dev/null
+++ b/tests/bench_amd_triton_ft.py
@@ -0,0 +1,130 @@
+"""R6 J3a: feature-transformer forward+backward time, torch vs Triton (synthetic batches).
+
+Usage: python tests/bench_amd_triton_ft.py [--tune] [--iters N]
+Times one FT step = forward + backward of double_feature_transform (weight and
+bias gradients) with CUDA events, median of N iterations after warm-up.
+"""
+
+import argparse
+import itertools
+import os
+import statistics
+import sys
+
+import torch
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from model.modules.feature_transformer.double_ft_functions import (  # noqa: E402
+    double_feature_transform,
+)
+
+DEV = torch.device("cuda")
+
+
+def make(batch, active, num_inputs, l1, fill=0.75, seed=0):
+    g = torch.Generator(device="cpu").manual_seed(seed)
+    k = int(active * fill)
+    wi = torch.full((batch, active), -1, dtype=torch.int32)
+    bi = torch.full((batch, active), -1, dtype=torch.int32)
+    # unique per row: random offsets in disjoint strides
+    stride = num_inputs // active
+    base = torch.arange(active, dtype=torch.int64) * stride
+    wi[:, :k] = (base[:k] + torch.randint(0, stride, (batch, k), generator=g)).to(torch.int32)
+    bi[:, :k] = (base[:k] + torch.randint(0, stride, (batch, k), generator=g)).to(torch.int32)
+    us = (torch.rand(batch, 1, generator=g) < 0.5).float()
+    them = 1.0 - us
+    w = (torch.randn(num_inputs, l1, generator=g) * 0.05).to(DEV).requires_grad_(True)
+    b = (torch.randn(l1, generator=g) * 0.05).to(DEV).requires_grad_(True)
+    gout = (torch.randn(batch, l1, generator=g) / batch).to(DEV)
+    return us.to(DEV), them.to(DEV), wi.to(DEV), bi.to(DEV), w, b, gout
+
+
+def step(backend, data, l1):
+    us, them, wi, bi, w, b, gout = data
+    w.grad = None
+    b.grad = None
+    out = double_feature_transform(us, them, wi, bi, w, b, 1.0, l1, backend=backend)
+    out.backward(gout)
+
+
+def time_ms(backend, data, l1, iters, fwd_only=False):
+    us, them, wi, bi, w, b, gout = data
+    for _ in range(3):
+        step(backend, data, l1)
+    torch.cuda.synchronize()
+    ts = []
+    for _ in range(iters):
+        s = torch.cuda.Event(enable_timing=True)
+        e = torch.cuda.Event(enable_timing=True)
+        s.record()
+        if fwd_only:
+            with torch.no_grad():
+                double_feature_transform(us, them, wi, bi, w, b, 1.0, l1, backend=backend)
+        else:
+            step(backend, data, l1)
+        e.record()
+        e.synchronize()
+        ts.append(s.elapsed_time(e))
+    return statistics.median(ts)
+
+
+SHAPES = [
+    # batch, active, inputs, l1   (fill 75% of active slots)
+    (4096, 32, 73728, 256),  # baseline smoke config (K32H3^, --l1 256, bs 4096)
+    (16384, 32, 73728, 1024),  # K32H3^ at upstream L1 and batch
+    (4096, 288, 138096, 1024),  # Full_Threats+PP_3Wide+K32H3^ at L1 1024
+]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--iters", type=int, default=10)
+    ap.add_argument("--tune", action="store_true")
+    ap.add_argument("--shapes", default="0,1,2")
+    args = ap.parse_args()
+    print(f"torch {torch.__version__} hip {torch.version.hip} {torch.cuda.get_device_name(0)}", flush=True)
+    for si in [int(x) for x in args.shapes.split(",")]:
+        batch, active, num_inputs, l1 = SHAPES[si]
+        data = make(batch, active, num_inputs, l1)
+        t_torch = time_ms("torch", data, l1, args.iters)
+        t_torch_f = time_ms("torch", data, l1, args.iters, fwd_only=True)
+        t_tri = time_ms("triton", data, l1, args.iters)
+        t_tri_f = time_ms("triton", data, l1, args.iters, fwd_only=True)
+        print(
+            f"shape B={batch} A={active} N={num_inputs} L1={l1}: "
+            f"torch fwd {t_torch_f:.2f} ms, fwd+bwd {t_torch:.2f} ms | "
+            f"triton fwd {t_tri_f:.2f} ms, fwd+bwd {t_tri:.2f} ms | "
+            f"speedup fwd {t_torch_f / t_tri_f:.1f}x, fwd+bwd {t_torch / t_tri:.1f}x",
+            flush=True,
+        )
+        if args.tune:
+            half = l1 // 2
+            best = None
+            for bc, kc, nw, pos in itertools.product(
+                [c for c in (32, 64, 128, 256) if c <= half], (8, 16, 32), (2, 4, 8), (4, 8, 16)
+            ):
+                if kc > active:
+                    continue
+                os.environ["NNUE_TRITON_BLOCK_C"] = str(bc)
+                os.environ["NNUE_TRITON_KC"] = str(kc)
+                os.environ["NNUE_TRITON_WARPS"] = str(nw)
+                os.environ["NNUE_TRITON_POS"] = str(pos)
+                try:
+                    t = time_ms("triton", data, l1, max(3, args.iters // 2))
+                except Exception as e:  # e.g. out of resources
+                    print(f"  bc={bc} kc={kc} warps={nw} pos={pos}: {type(e).__name__}", flush=True)
+                    continue
+                print(f"  bc={bc:3d} kc={kc:2d} warps={nw} pos={pos:2d}: {t:.2f} ms", flush=True)
+                if best is None or t < best[0]:
+                    best = (t, bc, kc, nw, pos)
+            for k in ("NNUE_TRITON_BLOCK_C", "NNUE_TRITON_KC", "NNUE_TRITON_WARPS", "NNUE_TRITON_POS"):
+                os.environ.pop(k, None)
+            if best:
+                print(f"  BEST {best[0]:.2f} ms: bc={best[1]} kc={best[2]} warps={best[3]} pos={best[4]}", flush=True)
+        del data
+        torch.cuda.empty_cache()
+
+
+if __name__ == "__main__":
+    main()
