+// WDL holds at clock 0 only. A stored mate is treated alike while tables are loaded: a mate too late for the current clock
+// would make a shorter TB loss look like the best defence (SyzygyRule50 bit 1). This only withholds the stored score.
+#if FORGE_SYZYGY_RULE50
+[[nodiscard]] bool tb_score_fits_clock(int stored, int clock) {
+    if ((tune::SyzygyRule50 & 1) == 0 || !syzygy::tb_scores || !options::syzygy_50_move_rule) return true;
