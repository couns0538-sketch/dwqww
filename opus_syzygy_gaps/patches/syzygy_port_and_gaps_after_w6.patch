+    if (magnitude < syzygy::TbWinInMaxPly) return true;
+    if (magnitude >= MateInMaxPly) return MateValue - magnitude + clock <= 100;
+    const int k = syzygy::TbWin - magnitude;
+    return k == 0 ? clock == 0 : k + clock <= 100;
