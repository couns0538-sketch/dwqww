+#if FORGE_SYZYGY_ROOT_EXACT
+#ifndef FORGE_SYZYGY_BOUNDARY_BUDGET
+#define FORGE_SYZYGY_BOUNDARY_BUDGET 1000  // moves tried at the root: about 35 ms at worst; undecided roots stay safe, see resolve_boundary
+#endif
+// Exact result near the 50-move boundary (SyzygyRootExact bit 2). value: 1 win, 0 draw, -1 loss for the side to move at
+// the board's counter. A table distance decides a move unless it is rounded and lands exactly on the hundredth
+// half-move: only those lines are followed move by move. `top` is the best the side to move can get (a table loser cannot
+// win), `memo` holds decided positions of this walk. False: the budget is used up or a table is missing.
+struct BoundaryMemo {
+    std::vector<std::uint64_t> keys = std::vector<std::uint64_t>(4096, 0);
+    std::vector<std::int8_t> values = std::vector<std::int8_t>(4096, 0);
+    [[nodiscard]] static std::uint64_t code(const Board& board) {
+        return (board.key() ^ (static_cast<std::uint64_t>(board.halfmove_clock()) << 56)) | 1;
+    }
+};
+
+[[gnu::cold]] bool boundary_value(const Registry& r, Board& board, int top, BoundaryMemo& memo, int& value, int& budget) {
+    const std::uint64_t code = BoundaryMemo::code(board);
+    const std::size_t slot = static_cast<std::size_t>(code >> 3) & (memo.keys.size() - 1);
+    if (memo.keys[slot] == code) {
+        value = memo.values[slot];
+        return true;
+    }
+    const MoveList legal = board.legal_moves();
+    if (legal.empty()) {
+        value = board.in_check() ? -1 : 0;
+        return true;
+    }
+    int best = -1;
+    for (const Move move : legal) {
+        if (--budget < 0) return false;
+        Undo undo;
+        (void)board.make_move(move, undo);
+        bool ok = true;
+        int v = 0;
+        if (!board.has_legal_move()) {
+            v = board.in_check() ? 1 : 0;
+        } else if (board.halfmove_clock() == 0) {
+            NodeValue child;
+            ok = node_wdl(r, board, false, child);
+            v = child.wdl == -2 ? 1 : (child.wdl == 2 ? -1 : 0);
+        } else if (board.halfmove_clock() < 100) {
+            int dtz = 0;
+            bool rounded = false;
+            ok = dtz_value(r, board, dtz, rounded, 0);
+            if (ok && dtz != 0) {
+                const int sum = (dtz < 0 ? -dtz : dtz) + board.halfmove_clock();
+                if (sum < 100 || (sum == 100 && !rounded)) {
+                    v = dtz > 0 ? -1 : 1;
+                } else if (sum == 100) {
+                    int child_value = 0;
+                    ok = boundary_value(r, board, dtz > 0 ? 1 : 0, memo, child_value, budget);
+                    v = -child_value;
+                }
+            }
+        }
+        board.unmake_move(move, undo);
+        if (!ok) return false;
+        best = std::max(best, v);
+        if (best >= top) break;
+    }
+    memo.keys[slot] = code;
+    memo.values[slot] = static_cast<std::int8_t>(best);
+    value = best;
+    return true;
+}
+
+// Moves with distance + counter = 100 and a rounded distance, when they lead the root's ranks (ranks 900 and -900 from
+// rank_root_moves): resolved by boundary_value in rounds with a growing cap per move, so that one hard move cannot use up the
+// budget, stopping at the first proof. Win 901; really 101: 899 and -899, the plain ranks of sum 101; loss -2000. A move left
+// undecided keeps 900 or -900: a move that may still draw goes before moves that surely lose, and the root reports the search
+// score (src/tablebase.inc).
+[[gnu::cold]] void resolve_boundary(const Registry& r, Board& board, std::vector<RootRank>& ranks) {
+    BoundaryMemo memo;
+    int budget = FORGE_SYZYGY_BOUNDARY_BUDGET;
+    for (int cap = 64; budget > 0; cap = std::min(cap * 4, FORGE_SYZYGY_BOUNDARY_BUDGET)) {
+        int best = -3000;
+        for (const RootRank& x : ranks) best = std::max(best, x.rank);
+        if (best != 900 && best != -900) return;
+        for (RootRank& x : ranks) {
+            if (x.rank != best) continue;
+            const int given = std::min(cap, budget);
+            int left = given;
+            int value = 0;
+            Undo undo;
+            (void)board.make_move(x.move, undo);
+            // The child to move is the table loser when the move is a table win, the table winner otherwise.
+            const bool done = boundary_value(r, board, best > 0 ? 0 : 1, memo, value, left);
+            board.unmake_move(x.move, undo);
+            budget -= given - left;
+            if (done) {
+                x.rank = best > 0 ? (value == -1 ? 901 : 899) : (value == 1 ? -2000 : -899);
+                if (x.rank == 901 || x.rank == -899) return;
+            }
+            if (budget <= 0) return;
+        }
+    }
+}
+#endif
