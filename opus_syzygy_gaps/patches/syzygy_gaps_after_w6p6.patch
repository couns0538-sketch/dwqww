diff --git a/src/syzygy.inc b/src/syzygy.inc
index 303929b..9e2a7e7 100644
--- a/src/syzygy.inc
+++ b/src/syzygy.inc
@@ -1172,6 +1172,106 @@ struct NodeValue {
