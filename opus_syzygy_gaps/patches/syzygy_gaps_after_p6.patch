+#if FORGE_SYZYGY_ROOT_EXACT
+// Exact result near the 50-move boundary (SyzygyRootExact bit 2). value: 1 win, 0 draw, -1 loss for the side to move at
+// the board's counter. A table distance decides a move unless it is rounded and lands exactly on the hundredth
+// half-move: only those lines are followed move by move. False: the budget is used up or a table is missing.
+[[gnu::cold]] bool boundary_value(const Registry& r, Board& board, int& value, int& budget) {
+    const MoveList legal = board.legal_moves();
+    if (legal.empty()) {
+        value = board.in_check() ? -1 : 0;
+        return true;
+    }
+    int best = -1;
+    for (const Move move : legal) {
+        if (--budget < 0) return false;
+        Undo undo;
+        (void)board.make_move(move, undo);
+        bool ok = true;
+        int v = 0;
+        if (!board.has_legal_move()) {
+            v = board.in_check() ? 1 : 0;
+        } else if (board.halfmove_clock() == 0) {
+            NodeValue child;
+            ok = node_wdl(r, board, false, child);
+            v = child.wdl == -2 ? 1 : (child.wdl == 2 ? -1 : 0);
+        } else if (board.halfmove_clock() < 100) {
+            int dtz = 0;
+            bool rounded = false;
+            ok = dtz_value(r, board, dtz, rounded, 0);
+            if (ok && dtz != 0) {
+                const int sum = (dtz < 0 ? -dtz : dtz) + board.halfmove_clock();
+                if (sum < 100 || (sum == 100 && !rounded)) {
+                    v = dtz > 0 ? -1 : 1;
+                } else if (sum == 100) {
+                    int child_value = 0;
+                    ok = boundary_value(r, board, child_value, budget);
+                    v = -child_value;
+                }
+            }
+        }
+        board.unmake_move(move, undo);
+        if (!ok) return false;
+        best = std::max(best, v);
+        if (best == 1) break;
+    }
+    value = best;
+    return true;
+}
+
+// Rank of a root move with distance + counter = 100, the move already made on the board. Win 901, undecided win 900 (the
+// plain rank), a rounded distance that is really 101: 899 and -899 (the plain ranks of sum 101), undecided loss -900,
+// loss -2000. A rounded move that may still draw thus goes before moves that surely lose.
+[[gnu::cold]] int boundary_rank(const Registry& r, Board& board, int dtz, bool rounded, int& budget) {
+    if (!rounded) return dtz > 0 ? 901 : -2000;
+    int value = 0;
+    if (!boundary_value(r, board, value, budget)) return dtz > 0 ? 900 : -900;
+    if (dtz > 0) return value == -1 ? 901 : 899;
+    return value == 1 ? -2000 : -899;
+}
+#endif
