+// Even the stronger all-input subset bound (plus one maximum dirty sequence)
+// must remain exactly representable as a float integer. This also proves every
+// int32 intermediate safe. Reject a future unqualified network rather than
+// silently narrowing it. The current 13-network audit is retained separately.
+bool exact_network_grid_safe() {
+    static const bool safe = [] {
+        for (int h = 0; h < HiddenSize; ++h) {
+            std::int64_t bound = std::abs(static_cast<std::int64_t>(NnueB1[h]));
+            std::int64_t largest = 0;
+            for (int input = 0; input < InputCount; ++input) {
+                const auto magnitude = std::abs(static_cast<std::int64_t>(NnueW1[input * HiddenSize + h]));
+                bound += magnitude;
+                largest = std::max(largest, magnitude);
+            }
+            if (bound + 4 * largest >= (std::int64_t{1} << 24)) return false;
+        }
+        return WeightScale == 4096.0F;
+    }();
+    return safe;
+}
+
+void refresh_exact(const Board& board, Accumulator& accumulator) {
+    for (const Color perspective : {White, Black}) {
+        auto& destination = accumulator.exact_values[static_cast<std::size_t>(perspective)];
+        for (int h = 0; h < HiddenSize; h += 8) {
+            const __m128i bias = _mm_loadu_si128(reinterpret_cast<const __m128i*>(NnueB1 + h));
+            _mm256_store_si256(reinterpret_cast<__m256i*>(destination.data() + h), _mm256_cvtepi16_epi32(bias));
+        }
+        Bitboard occupied = board.occupied();
+        while (occupied != 0) {
+            const int square = pop_lsb(occupied);
+            const int index = feature_index(perspective, board.piece_at(square), square);
+            const auto* column = NnueW1 + static_cast<std::size_t>(index) * HiddenSize;
+            for (int h = 0; h < HiddenSize; h += 8) {
+                const __m128i packed = _mm_loadu_si128(reinterpret_cast<const __m128i*>(column + h));
+                const __m256i sum = _mm256_add_epi32(
+                    _mm256_load_si256(reinterpret_cast<const __m256i*>(destination.data() + h)),
+                    _mm256_cvtepi16_epi32(packed));
+                _mm256_store_si256(reinterpret_cast<__m256i*>(destination.data() + h), sum);
+            }
+        }
+    }
+    accumulator.exact_int32 = true;
+    accumulator.valid = true;
+}
+
+void update_exact(const Accumulator& parent, Accumulator& child, const DirtyPieces& dirty) {
+    for (const Color perspective : {White, Black}) {
+        const auto& source = parent.exact_values[static_cast<std::size_t>(perspective)];
+        auto& destination = child.exact_values[static_cast<std::size_t>(perspective)];
+        std::array<const std::int16_t*, 4> columns{};
+        for (int change = 0; change < dirty.count; ++change) {
+            const auto& piece = dirty.changes[static_cast<std::size_t>(change)];
+            columns[static_cast<std::size_t>(change)] = NnueW1 +
+                static_cast<std::size_t>(feature_index(perspective, piece.piece, piece.square)) * HiddenSize;
+        }
+        for (int h = 0; h < HiddenSize; h += 8) {
+            __m256i sum = _mm256_load_si256(reinterpret_cast<const __m256i*>(source.data() + h));
+            for (int change = 0; change < dirty.count; ++change) {
+                const __m128i packed = _mm_loadu_si128(reinterpret_cast<const __m128i*>(columns[static_cast<std::size_t>(change)] + h));
+                const __m256i delta = _mm256_cvtepi16_epi32(packed);
+                sum = dirty.changes[static_cast<std::size_t>(change)].add
+                    ? _mm256_add_epi32(sum, delta) : _mm256_sub_epi32(sum, delta);
+            }
+            _mm256_store_si256(reinterpret_cast<__m256i*>(destination.data() + h), sum);
+        }
+    }
+    child.exact_int32 = true;
+    child.valid = true;
+}
