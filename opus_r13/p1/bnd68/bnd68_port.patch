+                        }
+                    }
+                }
+            }
+            // Control: the harness does see TT scores. A scored, deep, exact entry is returned at once.
+            planted_score.clear_hash();
+            TranspositionTable& tt = planted_score.transposition_table();
+            tt.store(tt.probe(board.key()), board.key(), 777, raw, Move::none(), 30, BoundExact, false,
