+            tune::EvalOnlyStore = 1;
+            planted_score.clear_hash();
+            tt.store(tt.probe(board.key()), board.key(), 100, raw, Move::none(), 3, BoundLower, false,
+                     static_cast<std::uint16_t>(board.halfmove_clock()));
+            (void)SearcherTestProbe::run(planted_score, board, 1, 900, 901);
+            const TTProbe kept = tt.probe(board.key());
+            check(kept.hit && kept.entry.score != ValueNone, "EvalOnlyStore=1: a scored same-key entry is never turned eval-only: " + fen);
