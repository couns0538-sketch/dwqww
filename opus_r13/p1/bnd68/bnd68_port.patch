+                }
+            }
+            tune::EvalOnlyStore = 1;
+            // With EvalOnlyStore=1 on a miss, the node itself leaves either its real result or an eval-only entry.
+            planted_score.clear_hash();
+            const int stored_run = SearcherTestProbe::run(planted_score, board, 2, -1, 0);
+            check(stored_run > -MateValue && stored_run < MateValue, "EvalOnlyStore=1: score in bounds: " + fen);
+            // A window far below the eval makes the node leave through reverse futility (no final store), so
+            // what remains for this key is the eval-only entry written by the engine itself.
+            planted_score.clear_hash();
+            const int rfp_run = SearcherTestProbe::run(planted_score, board, 2, -3001, -3000);
+            const TTProbe left = tt.probe(board.key());
+            if (left.hit && left.entry.depth == 0) {
+                ++engine_eval_only_seen;
+                check(left.entry.score == ValueNone && left.entry.move.is_none() && left.entry.bound() == BoundUpper &&
+                          (board.in_check() || left.entry.eval == raw),
+                      "engine eval-only entry: score ValueNone, no move, upper, eval = raw eval: " + fen);
+            }
+            check(rfp_run > -MateValue && rfp_run < MateValue, "EvalOnlyStore=1 RFP run: score in bounds: " + fen);
+            // EvalOnlyStoreMinDepth gate, same depth-2 RFP window. When MinDepth 0 left the engine's own
+            // eval-only entry (so the node exits with no final store), MinDepth 1 and 2 (<= depth) must leave the
+            // identical entry and MinDepth 3 and 8 (> depth) must leave the slot empty. EvalOnlyStore=0 ignores
+            // MinDepth. A gate on the wrong side (> vs >=) or ignoring the option fails one of these.
+            if (left.hit && left.entry.depth == 0 && left.entry.score == ValueNone) {
+                ++min_depth_windows;
+                for (const int min_depth : {1, 2, 3, 8}) {
+                    tune::EvalOnlyStoreMinDepth = min_depth;
+                    planted_score.clear_hash();
+                    const int gated = SearcherTestProbe::run(planted_score, board, 2, -3001, -3000);
+                    const TTProbe g = tt.probe(board.key());
+                    const std::string tag = "MinDepth " + std::to_string(min_depth) + " " + fen;
+                    check(gated == rfp_run, "EvalOnlyStoreMinDepth: RFP-window score unchanged: " + tag);
+                    if (min_depth <= 2) {
+                        check(g.hit && g.entry.score == ValueNone && g.entry.depth == 0 && g.entry.eval == left.entry.eval &&
+                                  g.entry.move.is_none() && g.entry.bound() == BoundUpper,
+                              "EvalOnlyStoreMinDepth <= depth: eval-only entry still stored: " + tag);
+                    } else {
+                        check(!g.hit, "EvalOnlyStoreMinDepth > depth: no eval-only entry stored: " + tag);
+                    }
+                }
+                tune::EvalOnlyStore = 0;
+                tune::EvalOnlyStoreMinDepth = 8;
+                planted_score.clear_hash();
+                (void)SearcherTestProbe::run(planted_score, board, 2, -3001, -3000);
+                check(!tt.probe(board.key()).hit, "EvalOnlyStore=0 with MinDepth 8: still no store (option inert when off): " + fen);
+                tune::EvalOnlyStoreMinDepth = 0;
+            }
+            tune::EvalOnlyStore = 0;
+        }
+        check(compared == 6 * 2 * 2 * 5 * 7, "eval-only miss-equivalence grid fully run");
+        check(engine_eval_only_seen > 0, "the engine's own EvalOnlyStore path was exercised");
+        check(early_exit_windows >= 4, "store-on-hit early-exit windows were exercised");
+        check(min_depth_windows >= 2, "EvalOnlyStoreMinDepth windows were exercised");
+        std::cout << "EvalOnlyStoreMinDepth windows checked: " << min_depth_windows << '\n';
+        std::cout << "store-on-hit early-exit windows checked: " << early_exit_windows << '\n';
+        std::cout << "engine eval-only entries inspected: " << engine_eval_only_seen << '\n';
+    }
+
+    const std::vector<Options> configs = {
+        {0, 0, "off"}, {100, 0, "cont4"}, {0, 1, "evalstore"}, {100, 1, "pair"}, {200, 1, "max"},
+    };
+    const std::vector<std::string> fens = {
+        std::string(Board::StandardStartFen),
+        "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
+        "2rr3k/pp3pp1/1nnqbN1p/3pN3/2pP4/2P3Q1/PPB4P/R4RK1 w - - 0 1",
+        "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",
+        "r1bqkb1r/pppp1ppp/2n2n2/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq - 4 4", // mate in 1 (Qxf7#)
+        "6k1/5ppp/8/8/8/8/5PPP/3R2K1 w - - 0 1",                                // mate in 1 (Rd8#)
+        "1k6/ppp5/8/8/8/8/5PPP/3R2K1 b - - 0 1",                                // black to move, mated soon by back rank
+        "7k/8/6K1/8/8/8/8/1Q6 w - - 0 1",                                       // K+Q vs K, mate in few
+        "8/8/8/8/8/5k2/8/4K2q w - - 0 1",                                       // white king in check
+    };
+
+    for (int threads : {1, 2}) {
+        Searcher searcher(16, threads);
+        for (const std::string& fen : fens) {
+            Board board;
+            check(board.set_fen(fen), "fen parses: " + fen);
+            apply(Options{});
+            const SearchInfo off = run_depth(searcher, board, 9);
+            for (const Options& o : configs) {
+                apply(o);
+                const SearchInfo r = run_depth(searcher, board, 9);
+                const std::string tag = std::string(o.name) + " T" + std::to_string(threads) + " " + fen;
+                check(!r.best_move.is_none() && board.is_legal(r.best_move), "legal bestmove: " + tag);
+                check(r.score > -MateValue && r.score < MateValue, "score within mate bounds: " + tag);
+                // A mate the base finds at this depth must still be found; better ordering may find a
+                // mate the base misses, which is reported, not failed.
+                if (is_mate_score(off.score)) check(is_mate_score(r.score), "base mate still found: " + tag);
+                if (is_mate_score(r.score) != is_mate_score(off.score)) {
+                    std::cout << "note: " << tag << " off score " << off.score << " option score " << r.score
+                              << " bestmove " << int(r.best_move.from) << "-" << int(r.best_move.to) << '\n';
+                }
+                if (is_mate_score(off.score) && is_mate_score(r.score)) {
+                    check((r.score > 0) == (off.score > 0), "mate sign unchanged: " + tag);
+                    if (off.score > 0) check(mate_distance(r.score) <= mate_distance(off.score), "own mate not delayed: " + tag);
+                }
+                // Searching again without clearing (warm histories and TT, eval-only entries present).
+                const SearchInfo warm = run_depth(searcher, board, 9, false);
+                check(!warm.best_move.is_none() && board.is_legal(warm.best_move), "legal bestmove warm: " + tag);
+                check(warm.score > -MateValue && warm.score < MateValue, "warm score within bounds: " + tag);
+                if (threads == 1 && o.cont4 == 0 && o.store == 0) {
+                    check(r.nodes == off.nodes && r.best_move == off.best_move && r.score == off.score,
+                          "off is deterministic: " + tag);
+                }
+            }
+        }
+        // EvalOnlyStoreMinDepth whole-search identities (T1 only, deterministic): with EvalOnlyStore=1, MinDepth 1
+        // equals MinDepth 0 (search depth is >= 1 at the store); with EvalOnlyStore=0, MinDepth has no effect.
+        // MinDepth 3/6 must still give legal moves and in-bounds scores and keep base mates.
+        if (threads == 1) {
+            for (const std::string& fen : fens) {
+                Board board;
+                check(board.set_fen(fen), "fen parses: " + fen);
+                apply(Options{0, 1, "evalstore"});
+                tune::EvalOnlyStoreMinDepth = 0;
+                const SearchInfo m0 = run_depth(searcher, board, 9);
+                tune::EvalOnlyStoreMinDepth = 1;
+                const SearchInfo m1 = run_depth(searcher, board, 9);
+                check(m0.nodes == m1.nodes && m0.best_move == m1.best_move && m0.score == m1.score,
+                      "EvalOnlyStore=1: MinDepth 1 identical to MinDepth 0: " + fen);
+                apply(Options{});
+                tune::EvalOnlyStoreMinDepth = 0;
+                const SearchInfo off = run_depth(searcher, board, 9);
+                tune::EvalOnlyStoreMinDepth = 6;
+                const SearchInfo off6 = run_depth(searcher, board, 9);
+                check(off.nodes == off6.nodes && off.best_move == off6.best_move && off.score == off6.score,
+                      "EvalOnlyStore=0: MinDepth 6 identical to off: " + fen);
+                for (const int min_depth : {3, 6}) {
+                    apply(Options{0, 1, "evalstore"});
+                    tune::EvalOnlyStoreMinDepth = min_depth;
+                    const SearchInfo r = run_depth(searcher, board, 9);
+                    const std::string tag = "MinDepth " + std::to_string(min_depth) + " " + fen;
+                    check(!r.best_move.is_none() && board.is_legal(r.best_move), "legal bestmove: " + tag);
+                    check(r.score > -MateValue && r.score < MateValue, "score within mate bounds: " + tag);
+                    if (is_mate_score(off.score)) check(is_mate_score(r.score), "base mate still found: " + tag);
+                    if (is_mate_score(off.score) && is_mate_score(r.score) && off.score > 0)
+                        check(mate_distance(r.score) <= mate_distance(off.score), "own mate not delayed: " + tag);
+                }
+                tune::EvalOnlyStoreMinDepth = 0;
+                apply(Options{});
+            }
+        }
+        // Turning everything off again restores the base search exactly (no state leaks after clear()).
+        Board start;
+        check(start.set_fen(Board::StandardStartFen), "startpos parses");
+        if (threads == 1) {
+            apply(Options{});
+            const SearchInfo before = run_depth(searcher, start, 10);
+            apply(configs.back());
+            (void)run_depth(searcher, start, 10);
+            apply(Options{});
+            const SearchInfo after = run_depth(searcher, start, 10);
+            check(before.nodes == after.nodes && before.best_move == after.best_move && before.score == after.score,
+                  "options off after on: identical to never on");
+        }
+    }
+
+    std::cout << "pack_e_tests: " << assertions << " assertions, " << failures << " failures\n";
+    return failures == 0 ? EXIT_SUCCESS : EXIT_FAILURE;
+}
