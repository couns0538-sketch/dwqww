+std::uint64_t Board::compute_nonpawn_key(Color color) const {
+    std::uint64_t key = 0;
+    Bitboard others = occupied(color) & ~pieces(color, Pawn);
+    while (others != 0) {
+        const int square = pop_lsb(others);
+        key ^= piece_key(square, squares_[static_cast<std::size_t>(square)]);
+    }
+    return key;
+}
+
+std::uint64_t Board::king_key_term(Color color) const {
+    const int square = king_square(color);
+    if (square < 0) return 0;
+    return piece_key(square, squares_[static_cast<std::size_t>(square)]);
+}
+
+#ifndef NDEBUG
+void Board::assert_nonpawn_keys() const {
+    assert(nonpawn_key_[White] == compute_nonpawn_key(White));
+    assert(nonpawn_key_[Black] == compute_nonpawn_key(Black));
+}
+#endif
