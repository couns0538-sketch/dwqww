diff --git a/tests/nonpawn_key_tests.cpp b/tests/nonpawn_key_tests.cpp
new file mode 100644
index 0000000..e293166
--- /dev/null
+++ b/tests/nonpawn_key_tests.cpp
@@ -0,0 +1,133 @@
+// Checks Board::nonpawn_key(colour) against a full recompute at every ply of
+// random legal-move walks (make, null move, unmake), plus FEN round trips.
+#include "forge/board.hpp"
+
+#include <cstdint>
+#include <iostream>
+#include <string>
+#include <vector>
+
+namespace {
+
+int failures = 0;
+
+void check(bool ok, const std::string& what) {
+    if (!ok) {
+        ++failures;
+        if (failures <= 20) std::cerr << "FAIL: " << what << '\n';
+    }
+}
+
+std::uint64_t rng_state = 0x9E3779B97F4A7C15ULL;
+std::uint64_t next_random() {
+    rng_state ^= rng_state << 13;
+    rng_state ^= rng_state >> 7;
+    rng_state ^= rng_state << 17;
+    return rng_state;
+}
+
+struct Keys {
+    std::uint64_t white, black;
+};
+
+Keys keys_of(const forge::Board& board) {
+    return {board.nonpawn_key(forge::White), board.nonpawn_key(forge::Black)};
+}
+
+void check_consistent(const forge::Board& board, const std::string& label) {
+    check(board.nonpawn_key(forge::White) == board.compute_nonpawn_key(forge::White), label + ": white key vs recompute");
+    check(board.nonpawn_key(forge::Black) == board.compute_nonpawn_key(forge::Black), label + ": black key vs recompute");
+}
+
+void walk(const std::string& fen, int games, int plies) {
+    forge::Board board;
+    check(board.set_fen(fen), "parse " + fen);
+    std::uint64_t checked = 0;
+    for (int game = 0; game < games; ++game) {
+        check(board.set_fen(fen), "reparse " + fen);
+        check_consistent(board, fen + " initial");
+        std::vector<forge::Move> moves_made;
+        std::vector<forge::Undo> undos;
+        std::vector<Keys> before;
+        for (int ply = 0; ply < plies; ++ply) {
+            const forge::MoveList legal = board.legal_moves();
+            if (legal.empty()) break;
+            const Keys here = keys_of(board);
+            // Every few plies: null move and back (not while in check).
+            if (!board.in_check() && next_random() % 5 == 0) {
+                forge::NullUndo null_undo;
+                board.make_null_move(null_undo);
+                check(keys_of(board).white == here.white && keys_of(board).black == here.black, fen + ": null move changed keys");
+                check_consistent(board, fen + " after null");
+                board.unmake_null_move(null_undo);
+                check(keys_of(board).white == here.white && keys_of(board).black == here.black, fen + ": unmake null changed keys");
+                ++checked;
+            }
+            // Try every legal move once and unmake it (covers all castling/ep/promotion/capture kinds).
+            for (const forge::Move move : legal) {
+                forge::Undo undo;
+                check(board.make_move(move, undo), "make_move");
+                check_consistent(board, fen + " after make " + forge::Board::move_to_uci(move));
+                board.unmake_move(move, undo);
+                check(keys_of(board).white == here.white && keys_of(board).black == here.black,
+                      fen + ": unmake restores keys " + forge::Board::move_to_uci(move));
+                ++checked;
+            }
+            const forge::Move chosen = legal[next_random() % legal.size()];
+            forge::Undo undo;
+            check(board.make_move(chosen, undo), "make chosen");
+            check_consistent(board, fen + " walk");
+            // FEN round trip rebuilds the keys from scratch.
+            forge::Board rebuilt;
+            check(rebuilt.set_fen(board.fen()), "fen round trip");
+            check(rebuilt.nonpawn_key(forge::White) == board.nonpawn_key(forge::White) &&
+                      rebuilt.nonpawn_key(forge::Black) == board.nonpawn_key(forge::Black),
+                  fen + ": FEN rebuild equals incremental keys");
+            moves_made.push_back(chosen);
+            undos.push_back(undo);
+            before.push_back(here);
+            ++checked;
+        }
+        while (!moves_made.empty()) {
+            board.unmake_move(moves_made.back(), undos.back());
+            const Keys expected = before.back();
+            check(keys_of(board).white == expected.white && keys_of(board).black == expected.black, fen + ": unwind restores keys");
+            check_consistent(board, fen + " unwind");
+            moves_made.pop_back();
+            undos.pop_back();
+            before.pop_back();
+            ++checked;
+        }
+    }
+    std::cout << "nonpawn_key walk ok: " << fen << " (" << checked << " checks)\n";
+}
+
+} // namespace
+
+int main() {
+    forge::Board start;
+    check(start.nonpawn_key(forge::White) != 0 && start.nonpawn_key(forge::Black) != 0, "startpos keys nonzero");
+    check(start.nonpawn_key(forge::White) != start.nonpawn_key(forge::Black), "colour keys differ");
+    // Kings-and-pawns only: only the kings contribute.
+    forge::Board kp;
+    check(kp.set_fen("4k3/pppppppp/8/8/8/8/PPPPPPPP/4K3 w - - 0 1"), "kp fen");
+    check_consistent(kp, "kp");
+
+    const std::vector<std::string> fens = {
+        std::string(forge::Board::StandardStartFen),
+        "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",   // castling, captures
+        "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",                                // ep / rook endgame
+        "r3k2r/Pppp1ppp/1b3nbN/nP6/BBP1P3/q4N2/Pp1P2PP/R2Q1RK1 w kq - 0 1",        // promotions
+        "rnbq1k1r/pp1Pbppp/2p5/8/2B5/8/PPP1NnPP/RNBQK2R w KQ - 1 8",               // promotion captures
+        "r4rk1/1pp1qppp/p1np1n2/2b1p1B1/2B1P1b1/P1NP1N2/1PP1QPPP/R4RK1 w - - 0 10",
+        "rnbqkbnr/ppp1p1pp/8/3pPp2/8/8/PPPP1PPP/RNBQKBNR w KQkq f6 0 3",           // en passant available
+        "4k3/1P6/8/8/8/8/6p1/4K3 w - - 0 1",                                        // both sides promote
+    };
+    for (const std::string& fen : fens) walk(fen, 40, 120);
+    if (failures != 0) {
+        std::cerr << failures << " nonpawn_key test failure(s)\n";
+        return 1;
+    }
+    std::cout << "nonpawn_key tests passed\n";
+    return 0;
+}
