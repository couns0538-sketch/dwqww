new file mode 100644
index 0000000..475806f
--- /dev/null
+++ b/tests/pack_e_tests.cpp
@@ -0,0 +1,379 @@
+// Own tests for Pack E2: ContHist4Pct (quiet move ordering only) and EvalOnlyStore (eval-only TT entry).
+// P14 ThreatOrderPct and P18 LowPlyPct were removed for provenance (parked).
+// EvalOnlyStoreMinDepth (fc_packe2r): depth gate on the eval-only store, checked below.
+// Uses only the public Searcher / TranspositionTable API.
+// No copied code: written for Forge from the idea descriptions in FORGE_IDEA_BOARD.md batch 3.
+#include "forge/board.hpp"
+#include "forge/nnue.hpp"
+#include "forge/search.hpp"
+
+#include <chrono>
+#include <cstdlib>
+#include <iostream>
+#include <string>
+#include <vector>
+
+namespace forge {
+// Same friendship the existing rule50/tests.cpp diagnostics use: run one non-root node of the real
+// search (ply 1, caller's window) against the shared table, with worker-local state reset.
+struct SearcherTestProbe {
+    static Worker& prepare(Searcher& searcher, const Board& board) {
+        auto& worker = searcher.main_worker();
+        worker.clear();
+        worker.shared_.stop.store(false, std::memory_order_relaxed);
+        worker.shared_.ponder_hit_ns.store(0, std::memory_order_relaxed);
+        worker.all_workers_ = nullptr;
+        worker.aborted_ = false;
+        worker.local_nodes_ = 0;
+        worker.nodes_.store(0, std::memory_order_relaxed);
+        worker.node_limit_ = 0;
+        worker.node_limit_specified_ = false;
+        worker.hard_limit_ms_ = worker.soft_limit_ms_ = 0;
+        worker.time_managed_ = worker.pondering_ = false;
+        worker.start_ = std::chrono::steady_clock::now();
+        worker.seldepth_ = 0;
+        worker.root_history_index_ = board.history_size() - 1;
+        for (SearchStack& entry : worker.stack_) {
+            entry = SearchStack{};
+            entry.continuation = &(*worker.continuation_history_)[Empty][0];
+        }
+        for (int i = 0; i < MaxPly + 4; ++i) worker.stack_[static_cast<std::size_t>(i)].ply = i - 4;
+        auto* ss = &worker.stack_[5];
+        nnue::refresh(board, ss->accumulator);
+        return worker;
+    }
+    static int run(Searcher& searcher, Board board, int depth, int alpha, int beta) {
+        Worker& worker = prepare(searcher, board);
+        auto* ss = &worker.stack_[5];
+        return depth == 0 ? worker.qsearch(board, ss, alpha, beta) : worker.search(board, ss, depth, alpha, beta, false);
+    }
+    static std::uint64_t visited(Searcher& searcher) { return searcher.main_worker().local_nodes_; }
+    static int raw_eval(Searcher& searcher, const Board& board) {
+        Worker& worker = prepare(searcher, board);
+        return worker.static_evaluate(board, &worker.stack_[5]);
+    }
+};
+} // namespace forge
+
+namespace {
+int assertions = 0, failures = 0;
+void check(bool okay, const std::string& label) {
+    ++assertions;
+    if (!okay) { ++failures; std::cerr << "FAIL " << label << '\n'; }
+}
+
+struct Options { int cont4 = 0, store = 0; const char* name = "off"; };
+
+struct Restore {
+    int cont4 = forge::tune::ContHist4Pct, store = forge::tune::EvalOnlyStore, min_depth = forge::tune::EvalOnlyStoreMinDepth;
+    ~Restore() {
+        forge::tune::ContHist4Pct = cont4; forge::tune::EvalOnlyStore = store; forge::tune::EvalOnlyStoreMinDepth = min_depth;
+    }
+};
+
+void apply(const Options& o) {
+    forge::tune::ContHist4Pct = o.cont4; forge::tune::EvalOnlyStore = o.store;
+}
+
+forge::SearchInfo run_depth(forge::Searcher& searcher, const forge::Board& board, int depth, bool clear = true) {
+    forge::SearchLimits limits;
+    limits.depth = depth;
+    searcher.reset_stop();
+    if (clear) searcher.clear();
+    return searcher.search(board, limits);
+}
+
+int mate_distance(int score) { return score > 0 ? forge::MateValue - score : -(forge::MateValue + score); }
+} // namespace
+
+int main() {
+    using namespace forge;
+    Restore restore;
+
+    check(tune::ContHist4Pct == 0 && tune::EvalOnlyStore == 0, "Pack E2 defaults are all off");
+    check(tune::EvalOnlyStoreMinDepth == 0, "EvalOnlyStoreMinDepth default is 0 (original EvalOnlyStore behaviour)");
+    bool listed[3] = {false, false, false};
+    bool removed_present = false;
+    for (const tune::Parameter& p : tune::parameters()) {
+        const std::string name = p.name;
+        if (name == "ContHist4Pct") listed[0] = p.minimum == 0 && p.maximum == 200 && *p.value == 0;
+        if (name == "EvalOnlyStore") listed[1] = p.minimum == 0 && p.maximum == 1 && *p.value == 0;
+        if (name == "EvalOnlyStoreMinDepth") listed[2] = p.minimum == 0 && p.maximum == 64 && *p.value == 0;
+        if (name == "ThreatOrderPct" || name == "LowPlyPct") removed_present = true;
+    }
+    check(listed[0] && listed[1], "Pack E2 options are in the tunables table with default 0");
+    check(listed[2], "EvalOnlyStoreMinDepth is in the tunables table, 0..64, default 0");
+    check(!removed_present, "removed P14/P18 options are not in the tunables table");
+
+    // --- EvalOnlyStore entry semantics on the table itself ---
+    {
+        TranspositionTable tt(1);
+        const std::uint64_t key = 0x9E3779B97F4A7C15ULL;
+        TTProbe miss = tt.probe(key);
+        check(!miss.hit, "fresh table misses");
+        tt.store(miss, key, ValueNone, 123, Move::none(), 0, BoundUpper, false, 0);
+        TTProbe hit = tt.probe(key);
+        check(hit.hit && hit.entry.score == ValueNone && hit.entry.eval == 123 && hit.entry.move.is_none() &&
+                  hit.entry.depth == 0 && hit.entry.bound() == BoundUpper,
+              "eval-only entry: occupied, score ValueNone, eval kept, no move, depth 0");
+        // Any later store for the same key replaces the whole payload (depth + 4 > 0), including a
+        // depth-0 qsearch store with a non-exact bound.
+        tt.store(hit, key, -57, 99, Move::none(), 0, BoundLower, false, 0);
+        TTProbe after = tt.probe(key);
+        check(after.hit && after.entry.score == -57 && after.entry.eval == 99 && after.entry.bound() == BoundLower,
+              "eval-only entry is replaced by a depth-0 bound store");
+        tt.store(miss, key, ValueNone, 5, Move::none(), 0, BoundUpper, false, 0);
+        TTProbe again = tt.probe(key);
+        tt.store(again, key, 300, 5, Move{12, 28, 0, 0}, 7, BoundExact, true, 0);
+        TTProbe main_store = tt.probe(key);
+        check(main_store.hit && main_store.entry.score == 300 && main_store.entry.depth == 7 &&
+                  main_store.entry.bound() == BoundExact && !main_store.entry.move.is_none(),
+              "eval-only entry is replaced by the main search store");
+    }
+
+    // --- An eval-only entry never yields a cutoff, a TT-derived score or a mate-range score (real search code) ---
+    {
+        const std::vector<std::string> probe_fens = {
+            "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
+            "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",
+            "rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR b KQkq - 0 1",
+            "6k1/5ppp/8/8/8/8/5PPP/3R2K1 w - - 0 1",
+            "8/8/8/8/8/5k2/8/4K2q w - - 89 120",
+            "7k/8/8/8/8/8/8/K6R b - - 99 80",
+        };
+        apply(Options{});
+        int compared = 0;
+        int engine_eval_only_seen = 0;
+        int early_exit_windows = 0;
+        int min_depth_windows = 0;
+        for (const std::string& fen : probe_fens) {
+            Board board;
+            check(board.set_fen(fen), "probe fen parses: " + fen);
+            Searcher cold(16, 1), warm(16, 1), planted_score(16, 1);
+            const int raw = SearcherTestProbe::raw_eval(cold, board);
+            for (const Bound bound : {BoundUpper, BoundLower}) {
+                for (const int planted_eval : {raw, static_cast<int>(ValueNone)}) {
+                    for (int depth = 0; depth <= 4; ++depth) {
+                        for (const int centre : {-31990, -600, -1, 0, 1, 250, 31990}) {
+                            const int alpha = centre - 1, beta = centre;
+                            cold.clear_hash();
+                            const int cold_score = SearcherTestProbe::run(cold, board, depth, alpha, beta);
+                            const std::uint64_t cold_nodes = SearcherTestProbe::visited(cold);
+                            warm.clear_hash();
+                            TranspositionTable& tt = warm.transposition_table();
+                            tt.store(tt.probe(board.key()), board.key(), ValueNone, planted_eval, Move::none(), 0, bound, false,
+                                     static_cast<std::uint16_t>(board.halfmove_clock()));
+                            const TTProbe planted = tt.probe(board.key());
+                            check(planted.hit && planted.entry.score == ValueNone, "planted eval-only entry is a hit with no score");
+                            const int warm_score = SearcherTestProbe::run(warm, board, depth, alpha, beta);
+                            const std::string tag = fen + " d" + std::to_string(depth) + " w" + std::to_string(beta) +
+                                                    (bound == BoundUpper ? " upper" : " lower") +
+                                                    (planted_eval == ValueNone ? " evalnone" : " evalraw");
+                            // Same score and same node count as a miss: no cutoff and no TT-derived score.
+                            check(warm_score == cold_score, "eval-only entry behaves like a miss (score): " + tag);
+                            check(SearcherTestProbe::visited(warm) == cold_nodes, "eval-only entry behaves like a miss (nodes): " + tag);
+                            check(warm_score > -MateValue && warm_score < MateValue, "eval-only entry: score in bounds: " + tag);
+                            if (!is_mate_score(cold_score)) check(!is_mate_score(warm_score), "eval-only entry: no mate-range score: " + tag);
