diff --git a/include/forge/large_pages.hpp b/include/forge/large_pages.hpp
new file mode 100644
index 0000000..98e9041
--- /dev/null
+++ b/include/forge/large_pages.hpp
@@ -0,0 +1,83 @@
+#pragma once
+
+// Optional large-page backing for the big read-mostly tables (transposition
+// table, NNUE first-layer weights). Off by default (UCI option LargePages);
+// when off, every table is allocated exactly as before (new T[n]()).
+//
+// Windows: needs the "Lock pages in memory" user right (SeLockMemoryPrivilege)
+// for the account that runs the engine; without it the allocation falls back
+// to the normal heap and the engine says so in one info string.
+// Linux: a 2 MiB-aligned block advised with madvise(MADV_HUGEPAGE) (a hint to
+// transparent huge pages, not a guarantee). Other systems: always fallback.
+
+#include <cstddef>
+#include <memory>
+#include <string>
+#include <type_traits>
+
+namespace forge::large_pages {
+
+// Process-wide request (UCI option LargePages). Read only when a table is
+// (re)allocated, never on the search path.
+extern bool requested;
+
+enum class Kind : unsigned char { Heap, WindowsLarge, LinuxHuge };
+
+// Outcome of the last allocation attempt of one table, for the info line.
+struct Report {
+    bool attempted = false;   // LargePages was on when the table was allocated
+    bool ok = false;          // the table lives in large / huge-advised pages
+    std::size_t bytes = 0;    // bytes reserved (rounded up to the page size)
+    std::string reason;       // why it fell back (empty when ok)
+};
+
+struct Block {
+    void* ptr = nullptr;
+    std::size_t bytes = 0;
+    Kind kind = Kind::Heap;
+};
+
+// Zero-filled large-page block of at least `bytes` bytes, aligned to at least
+// `alignment`. Returns ptr == nullptr (and fills report.reason) on failure.
+[[nodiscard]] Block allocate(std::size_t bytes, std::size_t alignment, Report& report);
+void release(void* ptr, std::size_t bytes, Kind kind) noexcept;
+
+// unique_ptr deleter that frees memory the way it was allocated.
+struct Deleter {
+    Kind kind = Kind::Heap;
+    std::size_t bytes = 0;
+    template <class T>
+    void operator()(T* pointer) const noexcept {
+        if (kind == Kind::Heap) delete[] pointer;
+        else release(pointer, bytes, kind);
+    }
+};
+
+template <class T>
+using Array = std::unique_ptr<T[], Deleter>;
+
+// Value-initialised array of n elements. With large == false this is exactly
+// the base allocation (new T[n](), as std::make_unique<T[]>(n) does).
+template <class T>
+[[nodiscard]] Array<T> make_array(std::size_t n, bool large, Report& report) {
+    static_assert(std::is_trivially_destructible_v<T>, "large-page arrays skip destructors");
+    report = Report{};
+    report.attempted = large;
+    if (large) {
+        Block block = allocate(n * sizeof(T), alignof(T), report);
+        if (block.ptr != nullptr) {
+            T* elements = static_cast<T*>(block.ptr);
+            std::uninitialized_value_construct_n(elements, n);
+            report.ok = true;
+            report.bytes = block.bytes;
+            return Array<T>(elements, Deleter{block.kind, block.bytes});
+        }
+    }
+    return Array<T>(new T[n](), Deleter{});
+}
+
+// One UCI info line ("LargePages: on (<MiB> MiB <what>)" or
+// "LargePages: fallback (<what>: <reason>)"); empty when not attempted.
+[[nodiscard]] std::string describe(const Report& report, const char* what);
+
+} // namespace forge::large_pages
