+large_pages::Report set_large_pages(bool large) {
+    Weights& w = weights_storage();
+    large_pages::Report report;
+    const bool is_large = w.w1.get_deleter().kind != large_pages::Kind::Heap;
+    if (large == is_large) {
+        // Nothing to move; still report the state for the info line.
+        report.attempted = large;
+        report.ok = large;
+        report.bytes = w.w1.get_deleter().bytes;
+        return report;
+    }
+    if (large) w.w1.reset();   // free first: locked large pages are scarce
+    auto fresh = large_pages::make_array<float>(W1Count, large, report);
+    fill_w1(fresh.get());
+    w.w1 = std::move(fresh);
+    return report;
+}
