diff --git a/src/large_pages.cpp b/src/large_pages.cpp
new file mode 100644
index 0000000..08a295e
--- /dev/null
+++ b/src/large_pages.cpp
@@ -0,0 +1,161 @@
+#include "forge/large_pages.hpp"
+
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#elif defined(__linux__)
+#include <cerrno>
+#include <sys/mman.h>
+#endif
+
+namespace forge::large_pages {
+
+bool requested = false;
+
+namespace {
+
+bool round_up(std::size_t bytes, std::size_t page, std::size_t& out) {
+    if (page == 0) return false;
+    const std::size_t remainder = bytes % page;
+    if (remainder == 0) { out = bytes; return bytes != 0; }
+    const std::size_t pad = page - remainder;
+    if (bytes > std::numeric_limits<std::size_t>::max() - pad) return false;
+    out = bytes + pad;
+    return true;
+}
+
+#if defined(_WIN32)
+// Enables SeLockMemoryPrivilege in the process token (Microsoft docs:
+// "Large-Page Support", AdjustTokenPrivileges). AdjustTokenPrivileges returns
+// TRUE even when the account lacks the right; only GetLastError() ==
+// ERROR_SUCCESS means the privilege is really enabled.
+bool enable_lock_memory_privilege(std::string& reason) {
+    HANDLE token = nullptr;
+    if (OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &token) == 0) {
+        reason = "OpenProcessToken error " + std::to_string(GetLastError());
+        return false;
+    }
+    TOKEN_PRIVILEGES privileges{};
+    privileges.PrivilegeCount = 1;
+    privileges.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+    if (LookupPrivilegeValue(nullptr, SE_LOCK_MEMORY_NAME, &privileges.Privileges[0].Luid) == 0) {
+        reason = "LookupPrivilegeValue error " + std::to_string(GetLastError());
+        CloseHandle(token);
+        return false;
+    }
+    const BOOL adjusted = AdjustTokenPrivileges(token, FALSE, &privileges, 0, nullptr, nullptr);
+    const DWORD error = GetLastError();
+    CloseHandle(token);
+    if (adjusted == 0) {
+        reason = "AdjustTokenPrivileges error " + std::to_string(error);
+        return false;
+    }
+    if (error == ERROR_NOT_ALL_ASSIGNED) {
+        reason = "account lacks 'Lock pages in memory' (SeLockMemoryPrivilege)";
+        return false;
+    }
+    if (error != ERROR_SUCCESS) {
+        reason = "AdjustTokenPrivileges last error " + std::to_string(error);
+        return false;
+    }
+    return true;
+}
+#endif
+
+} // namespace
+
+Block allocate(std::size_t bytes, std::size_t alignment, Report& report) {
+    Block block;
+#if defined(_WIN32)
+    if (!enable_lock_memory_privilege(report.reason)) return block;
+    const SIZE_T page = GetLargePageMinimum();
+    if (page == 0) {
+        report.reason = "GetLargePageMinimum is 0 (no large-page support)";
+        return block;
+    }
+    if (alignment > page) {
+        report.reason = "alignment above large-page size";
+        return block;
+    }
+    std::size_t size = 0;
+    if (!round_up(bytes, static_cast<std::size_t>(page), size)) {
+        report.reason = "size overflow";
+        return block;
+    }
+    void* memory = VirtualAlloc(nullptr, size, MEM_RESERVE | MEM_COMMIT | MEM_LARGE_PAGES, PAGE_READWRITE);
+    if (memory == nullptr) {
+        report.reason = "VirtualAlloc MEM_LARGE_PAGES error " + std::to_string(GetLastError());
+        return block;
+    }
+    block.ptr = memory;   // VirtualAlloc memory is zero-filled
+    block.bytes = size;
+    block.kind = Kind::WindowsLarge;
+#elif defined(__linux__) && defined(MADV_HUGEPAGE)
+    constexpr std::size_t page = std::size_t{2} * 1024U * 1024U;
+    if (alignment > page) {
+        report.reason = "alignment above huge-page size";
+        return block;
+    }
+    std::size_t size = 0;
+    if (!round_up(bytes, page, size)) {
+        report.reason = "size overflow";
+        return block;
+    }
+    void* memory = std::aligned_alloc(page, size);
+    if (memory == nullptr) {
+        report.reason = "aligned_alloc failed";
+        return block;
+    }
+    if (madvise(memory, size, MADV_HUGEPAGE) != 0) {
+        report.reason = std::string("madvise(MADV_HUGEPAGE) failed: ") + std::strerror(errno);
+        std::free(memory);
+        return block;
+    }
+    std::memset(memory, 0, size);
+    block.ptr = memory;
+    block.bytes = size;
+    block.kind = Kind::LinuxHuge;
+#else
+    (void)bytes;
+    (void)alignment;
+    report.reason = "not supported on this OS";
+#endif
+    return block;
+}
+
+void release(void* ptr, std::size_t bytes, Kind kind) noexcept {
+    (void)bytes;
+    if (ptr == nullptr) return;
+#if defined(_WIN32)
+    if (kind == Kind::WindowsLarge) { VirtualFree(ptr, 0, MEM_RELEASE); return; }
+#endif
+#if defined(__linux__)
+    if (kind == Kind::LinuxHuge) { std::free(ptr); return; }
+#endif
+    (void)kind;
+}
+
+std::string describe(const Report& report, const char* what) {
+    if (!report.attempted) return {};
+    if (report.ok) {
+        const std::size_t mib = (report.bytes + 1024U * 1024U - 1U) / (1024U * 1024U);
+        return std::string("LargePages: on (") + std::to_string(mib) + " MiB " + what +
+#if defined(_WIN32)
+               ")";
+#else
+               ", madvise THP hint)";
+#endif
+    }
+    return std::string("LargePages: fallback (") + what + ": " + report.reason + ")";
+}
+
+} // namespace forge::large_pages
