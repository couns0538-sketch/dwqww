+// FORGE_ALIGN_WEIGHTS (R13 P2 step 1a, build switch, default 0): net weight storage that is not in large pages
+// starts on a 64-byte boundary (one cache line), so no 64-byte SIMD load of a weight row splits two lines. 0 = the
+// S1 / lock allocation (new T[n]() and std::vector: 16-byte aligned on MinGW-w64). Large pages are 2 MiB aligned
+// either way. Weight values and order are unchanged, so search nodes are identical.
+#ifndef FORGE_ALIGN_WEIGHTS
+#define FORGE_ALIGN_WEIGHTS 0
+#endif
+inline constexpr std::size_t WeightAlignment = 64;
+
+enum class Kind : unsigned char { Heap, WindowsLarge, LinuxHuge, HeapAligned };
