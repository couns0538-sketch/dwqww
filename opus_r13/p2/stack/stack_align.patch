         else release(pointer, bytes, kind);
     }
 };
@@ -78,6 +91,49 @@ template <class T>
 
 // One UCI info line ("LargePages: on (<MiB> MiB <what>)" or
 // "LargePages: fallback (<what>: <reason>)"); empty when not attempted.
+// Net weights: make_array, but under FORGE_ALIGN_WEIGHTS the heap block (no large pages, or their fallback) is
+// 64-byte aligned. The large-page report of a requested attempt is kept.
+template <class T>
+[[nodiscard]] Array<T> make_weight_array(std::size_t n, bool large, Report& report) {
+#if FORGE_ALIGN_WEIGHTS
+    if (large) {
+        Array<T> block = make_array<T>(n, true, report);
+        if (report.ok) return block;
+    } else {
+        report = Report{};
+    }
+    T* elements = static_cast<T*>(::operator new[](n * sizeof(T), std::align_val_t{WeightAlignment}));
+    std::uninitialized_value_construct_n(elements, n);
+    return Array<T>(elements, Deleter{Kind::HeapAligned, n * sizeof(T)});
+#else
+    return make_array<T>(n, large, report);
+#endif
+}
+
+// Allocator for heap weight vectors under FORGE_ALIGN_WEIGHTS (64-byte aligned blocks).
+template <class T>
+struct AlignedAllocator {
+    using value_type = T;
+    AlignedAllocator() noexcept = default;
+    template <class U>
+    AlignedAllocator(const AlignedAllocator<U>&) noexcept {}
+    [[nodiscard]] T* allocate(std::size_t n) {
+        return static_cast<T*>(::operator new(n * sizeof(T), std::align_val_t{WeightAlignment}));
+    }
+    void deallocate(T* pointer, std::size_t) noexcept { ::operator delete(pointer, std::align_val_t{WeightAlignment}); }
+    template <class U>
+    bool operator==(const AlignedAllocator<U>&) const noexcept { return true; }
+    template <class U>
+    bool operator!=(const AlignedAllocator<U>&) const noexcept { return false; }
+};
+#if FORGE_ALIGN_WEIGHTS
+template <class T>
+using WeightVector = std::vector<T, AlignedAllocator<T>>;
+#else
+template <class T>
+using WeightVector = std::vector<T>;
+#endif
+
 [[nodiscard]] std::string describe(const Report& report, const char* what);
 
 } // namespace forge::large_pages
