@@ -28,6 +28,18 @@
 // Build switch, default 0 (= the lock's code): search prefetches the child's TT
 // cluster before make_move from Board::key_after where that key is cheap and exact.
 #define FORGE_SPD_PREFETCH_EARLY 0
+#endif
+
+#ifndef FORGE_SPD_PREFETCH_PICK
+// Build switch, default 0 (= the lock's code), on top of FORGE_SPD_PREFETCH_EARLY=1:
+// the child's TT cluster is prefetched as soon as a move has passed the legality
+// test, before the pruning and extension tests of the move loop, so the load has
+// more time to arrive. A move that is then pruned has cost one unused prefetch.
+// Only the moment of the prefetch changes; no value the search reads differs.
+#define FORGE_SPD_PREFETCH_PICK 0
+#endif
+#if FORGE_SPD_PREFETCH_PICK && !FORGE_SPD_PREFETCH_EARLY
+#error "FORGE_SPD_PREFETCH_PICK=1 needs FORGE_SPD_PREFETCH_EARLY=1 (it moves that prefetch)"
 #endif
 
