+#if FORGE_SPD_CHECKERS_KL >= 2
+        if (checkers_ != (attackers_to(king_square(them), occupied()) & occupied(us))) std::abort();
+#endif
+    } else {
+        checkers_ = attackers_to(king_square(them), occupied()) & occupied(us);
+    }
