 #endif
             }
+#if FORGE_SPD_PICK_FIRST
+            if (count_ == 0 || score > first_score) {
+                first_score = score;
+                first = count_;
+            }
+#endif
             moves_[count_++] = Scored{move, score};
         }
+#if FORGE_SPD_PICK_FIRST
+        first_best_ = first;
+#endif
