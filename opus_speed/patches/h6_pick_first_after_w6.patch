             moves_[count_++] = Scored{move, scorer.score(move, check_squares_)};
+#endif
         }
+#if FORGE_SPD_PICK_FIRST
+        first_best_ = first;
+#endif
 #else
         for (const Move move : buffer_) {
             int score = searcher_.quiet_history(board_, ss_, move);
@@ -721,6 +770,10 @@
 #if FORGE_SEARCH_SPEED2
