+
 void TranspositionTable::resize(std::size_t mb) {
     const std::size_t bytes = std::max<std::size_t>(1, mb) * 1024U * 1024U;
     const std::size_t new_count = std::max<std::size_t>(1, bytes / sizeof(TTCluster));
+#if FORGE_SPD_LARGEPAGES
+    // Same count as the lock; only the block may be rounded up to whole large pages.
+    // A large-page block arrives zeroed and is constructed like new TTCluster[n](),
+    // which is make_unique<TTCluster[]>(n) of the lock: the same initial contents.
+    std::size_t block_bytes = 0;
+    TTCluster* storage = static_cast<TTCluster*>(large_pages::alloc(new_count * sizeof(TTCluster), block_bytes));
+    if (storage != nullptr) {
+        for (std::size_t i = 0; i < new_count; ++i) ::new (static_cast<void*>(storage + i)) TTCluster{};
+    } else {
+        block_bytes = 0;
+        storage = new TTCluster[new_count]();
+    }
+    std::unique_ptr<TTCluster[], TTClusterDeleter> new_clusters(storage, TTClusterDeleter{block_bytes});
+#else
     auto new_clusters = std::make_unique<TTCluster[]>(new_count);
+#endif
     clusters_ = std::move(new_clusters);
     cluster_count_ = new_count;
     generation_ = 0;
