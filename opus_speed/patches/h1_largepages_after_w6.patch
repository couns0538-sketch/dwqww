+
+#if FORGE_SPD_LARGEPAGES
+// Large pages for the transposition table (build switch FORGE_SPD_LARGEPAGES). Kept at
+// the end of the translation unit: the Windows headers' macros reach no other code.
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOGDI
+#define NOGDI
+#endif
+#include <windows.h>
+#if defined(_MSC_VER)
+#pragma comment(lib, "advapi32.lib")   // token calls; MinGW links advapi32 by default
+#endif
+#endif
+
+namespace forge::large_pages {
+#if defined(_WIN32)
+namespace {
+// Once per process: enable SeLockMemoryPrivilege in the own token and read the large
+// page size; 0 means "no large pages" (the account lacks the right, or a call failed).
+// AdjustTokenPrivileges also returns nonzero when it could not enable the privilege
+// (ERROR_NOT_ALL_ASSIGNED), so the last error decides.
+std::size_t page_size() {
+    static const std::size_t size = [] {
+        HANDLE token = nullptr;
+        if (!OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &token)) return std::size_t{0};
+        TOKEN_PRIVILEGES privileges{};
+        bool enabled = false;
+        if (LookupPrivilegeValueA(nullptr, "SeLockMemoryPrivilege", &privileges.Privileges[0].Luid)) {
+            privileges.PrivilegeCount = 1;
+            privileges.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+            SetLastError(ERROR_SUCCESS);
+            enabled = AdjustTokenPrivileges(token, FALSE, &privileges, 0, nullptr, nullptr) != 0 &&
+                      GetLastError() == ERROR_SUCCESS;
+        }
+        CloseHandle(token);
+        return enabled ? static_cast<std::size_t>(GetLargePageMinimum()) : std::size_t{0};
+    }();
+    return size;
+}
+} // namespace
+#endif
+
+void* alloc(std::size_t bytes, std::size_t& block_bytes) {
+    block_bytes = 0;
+#if defined(_WIN32)
+    const std::size_t page = page_size();
+    if (page == 0 || bytes == 0) return nullptr;
+    const std::size_t rounded = (bytes + page - 1) / page * page;
+    void* block = VirtualAlloc(nullptr, rounded, MEM_RESERVE | MEM_COMMIT | MEM_LARGE_PAGES, PAGE_READWRITE);
+    if (block != nullptr) block_bytes = rounded;
+    return block;
+#else
+    (void)bytes;
+    return nullptr;
+#endif
+}
+
+void release(void* block) {
+#if defined(_WIN32)
+    if (block != nullptr) (void)VirtualFree(block, 0, MEM_RELEASE);
+#else
+    (void)block;
+#endif
+}
+
+} // namespace forge::large_pages
+#endif
