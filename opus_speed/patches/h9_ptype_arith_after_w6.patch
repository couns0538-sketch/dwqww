diff -ruN trial_w6/include/forge/board.hpp h9dev_ptype_arith/include/forge/board.hpp
--- trial_w6/include/forge/board.hpp	2026-11-05 12:12:59.003567800 -0800
+++ h9dev_ptype_arith/include/forge/board.hpp	2026-11-05 21:31:43.438091300 -0800
@@ -248,7 +248,26 @@
 // the table to 16 so the index mask stays in bounds; no valid Piece reaches them (same values as the modulo form).
 inline constexpr std::array<std::uint8_t, 16> PieceTypeTable{0, 1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6, 0, 0, 0};
 } // namespace detail
+// Build switch (default 0 = the lock code): 1 = piece_type() computes the table's value
+// for every Piece (Empty 0 -> 0, 1..6 -> 1..6, 7..12 -> 1..6) without the table load,
+// checked against the table for all thirteen values at compile time.
+#ifndef FORGE_SPD_PTYPE_ARITH
+#define FORGE_SPD_PTYPE_ARITH 0
+#endif
+#if FORGE_SPD_PTYPE_ARITH
+[[nodiscard]] constexpr int piece_type(Piece piece) {
+    const int p = static_cast<int>(piece);
+    return p > 6 ? p - 6 : p;
+}
+static_assert([] {
+    for (int p = 0; p <= 12; ++p) {
+        if (piece_type(static_cast<Piece>(p)) != detail::PieceTypeTable[static_cast<std::size_t>(p)]) return false;
+    }
+    return true;
+}(), "piece_type arithmetic must equal PieceTypeTable for every Piece");
+#else
 [[nodiscard]] constexpr int piece_type(Piece piece) { return detail::PieceTypeTable[static_cast<unsigned>(piece) & 15U]; }
+#endif
 #else
 [[nodiscard]] constexpr int piece_type(Piece piece) { return piece == Empty ? 0 : ((static_cast<int>(piece) - 1) % 6) + 1; }
 #endif
