+namespace {
+// w1 column offsets (in floats) of one piece change for the White and the Black
+// perspective: feature_index() as integer arithmetic (relative colour = colour for
+// White and 1 - colour for Black; relative square = square or square ^ 56).
+struct ChangeColumns {
+    std::size_t white;
+    std::size_t black;
+};
+
+inline ChangeColumns change_columns(const PieceChange& change) {
+    const std::size_t colour = static_cast<std::size_t>(color_of(change.piece));
+    const std::size_t type = static_cast<std::size_t>(piece_type(change.piece) - 1);
+    const std::size_t square = change.square;
+    return {((colour * 6U + type) * 64U + square) * static_cast<std::size_t>(HiddenSize),
+            (((1U - colour) * 6U + type) * 64U + (square ^ 56U)) * static_cast<std::size_t>(HiddenSize)};
+}
+} // namespace
