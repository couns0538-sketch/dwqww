+        const ChangeColumns added = change_columns(dirty.changes[2]);
+        auto apply = [](const std::array<float, HiddenSize>& source, std::array<float, HiddenSize>& destination,
+                        const float* removed0_column, const float* removed1_column, const float* added_column) {
+            for (int h = 0; h < HiddenSize; ++h) {
+                const std::size_t index = static_cast<std::size_t>(h);
+                destination[index] = ((source[index] - removed0_column[index]) - removed1_column[index]) + added_column[index];
+            }
+        };
+        apply(parent.values[White], child.values[White], w1 + removed0.white, w1 + removed1.white, w1 + added.white);
+        apply(parent.values[Black], child.values[Black], w1 + removed0.black, w1 + removed1.black, w1 + added.black);
+        child.valid = true;
+        return;
+    }
+    std::array<ChangeColumns, 4> columns{};
+    for (int i = 0; i < dirty.count; ++i) columns[static_cast<std::size_t>(i)] = change_columns(dirty.changes[static_cast<std::size_t>(i)]);
+    for (const Color perspective : {White, Black}) {
+        auto& acc = child.values[static_cast<std::size_t>(perspective)];
+        acc = parent.values[static_cast<std::size_t>(perspective)];
