+            const ChangeColumns& c = columns[static_cast<std::size_t>(i)];
+            const float* column = w1 + (perspective == White ? c.white : c.black);
+            if (dirty.changes[static_cast<std::size_t>(i)].add) add_feature(acc, column);
+            else sub_feature(acc, column);
+        }
+    }
+    child.valid = true;
