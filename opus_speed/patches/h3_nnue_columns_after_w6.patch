+void update(const Accumulator& parent, Accumulator& child, const DirtyPieces& dirty) {
+    const float* const w1 = weights().w1.get();
+    // The lock's three paths with the same per-lane operation order; only the
+    // column addresses come from change_columns().
+    if (dirty.count == 2 && !dirty.changes[0].add && dirty.changes[1].add) {
+        const ChangeColumns removed = change_columns(dirty.changes[0]);
+        const ChangeColumns added = change_columns(dirty.changes[1]);
+        auto apply = [](const std::array<float, HiddenSize>& source, std::array<float, HiddenSize>& destination,
+                        const float* removed_column, const float* added_column) {
+            for (int h = 0; h < HiddenSize; ++h) {
+                const std::size_t index = static_cast<std::size_t>(h);
+                destination[index] = (source[index] - removed_column[index]) + added_column[index];
+            }
+        };
+        apply(parent.values[White], child.values[White], w1 + removed.white, w1 + added.white);
+        apply(parent.values[Black], child.values[Black], w1 + removed.black, w1 + added.black);
+        child.valid = true;
+        return;
+    }
+    if (dirty.count == 3 && !dirty.changes[0].add && !dirty.changes[1].add && dirty.changes[2].add) {
+        const ChangeColumns removed0 = change_columns(dirty.changes[0]);
