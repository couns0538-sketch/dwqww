+#if FORGE_SPD_MOVE_STORE32
+    // bits = from | to << 8 | promotion << 16 | flags << 24: the Move's bytes in member order (little endian).
+    void push_back_bits(std::uint32_t bits) {
+        assert(size_ < Capacity);
+        std::memcpy(static_cast<void*>(&data_[size_++]), &bits, sizeof(bits));
+    }
+#endif
     void reserve(std::size_t) {}
     void resize(std::size_t size) { assert(size <= Capacity); size_ = size; }
     void clear() { size_ = 0; }
