 // after overhead, or when increment would place soft above hard.
 // soft_divisor must be positive; the UCI spin starts at 5.
+// Stockfish timeAdvantage clock-deficit feedback (def601cc156f7d41f9ddea76d74515eddf232aaf,
+// timeman.cpp:151-156): damps soft_ms when behind on the clock, skipped at pct<=0,
+// moves_to_go == 1, or opp_time_ms <= 0. Clamped to [1, soft_ms].
+[[nodiscard]] inline std::int64_t apply_time_advantage(std::int64_t soft_ms, std::int64_t time_ms,
+                                                       std::int64_t opp_time_ms, std::int64_t moves_to_go,
+                                                       int time_advantage_percent) {
+    if (time_advantage_percent <= 0 || soft_ms <= 1 || time_ms <= 0 || opp_time_ms <= 0 ||
+        moves_to_go == 1 || time_ms >= opp_time_ms) {
+        return soft_ms;
+    }
+    const int pct = time_advantage_percent > 100 ? 100 : time_advantage_percent;
+    const double time_advantage =
+        (static_cast<double>(time_ms) - static_cast<double>(opp_time_ms)) /
+        (1.0 + static_cast<double>(time_ms) + static_cast<double>(opp_time_ms));
+    if (time_advantage >= 0.0) return soft_ms;
+    const double scale = 1.0 + (static_cast<double>(pct) / 100.0) * time_advantage;
+    if (scale <= 0.0) return 1;
+    const double product = static_cast<double>(soft_ms) * scale;
+    if (product <= 1.0) return 1;
+    if (product >= static_cast<double>(soft_ms)) return soft_ms;
+    const std::int64_t damped = static_cast<std::int64_t>(product);
+    return damped < 1 ? 1 : (damped > soft_ms ? soft_ms : damped);
+}
