+// Score-magnitude-adaptive initial aspiration half-width: keeps balanced
+// positions unchanged while scaling quadratically in decided evaluations and
+// opening wide on mate scores to avoid redundant root re-searches.
+[[nodiscard]] constexpr int initial_aspiration_delta(int base_delta, int prev_score) noexcept {
+    if (prev_score == ValueNone || is_mate_score(prev_score)) return Infinite;
+    const std::int64_t sq = static_cast<std::int64_t>(prev_score) * static_cast<std::int64_t>(prev_score);
+    const std::int64_t scaled = static_cast<std::int64_t>(base_delta) + sq / 16384;
+    return static_cast<int>(scaled < Infinite ? scaled : Infinite);
+}
