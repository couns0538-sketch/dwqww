+def _parse_uci_pv(line: str) -> list[str]:
+    if not isinstance(line, str) or not line:
+        return []
+    tokens = line.split()
+    if not tokens or tokens[0] != "info":
+        return []
+    if len(tokens) > 1 and tokens[1] == "string":
+        return []
+    if "pv" not in tokens:
+        return []
+    pv_idx = tokens.index("pv")
+    if "string" in tokens[:pv_idx]:
+        return []
+    pv: list[str] = []
+    for tok in tokens[pv_idx + 1:]:
+        if not _UCI_MOVE_RE.match(tok):
+            break
+        pv.append(tok)
+    return pv
+
+
+def _is_move_noisy(board, move_uci: str) -> bool:
+    import chess
+
+    if not isinstance(move_uci, str):
+        return False
+    s = move_uci.strip()
+    if not s or s in ("0000", "(none)", "none"):
+        return False
+    try:
+        mv = chess.Move.from_uci(s)
+    except ValueError:
+        return False
+    if not mv or not board.is_legal(mv):
+        return False
+    return bool(board.is_capture(mv) or board.is_en_passant(mv) or (mv.promotion is not None))
+
+
+def _is_pv2_noisy(board, pv, bestmove: str | None = None) -> bool:
+    pv_list = list(pv) if pv is not None else []
+    if bestmove is not None:
+        bm = bestmove.strip() if isinstance(bestmove, str) else ""
+        if not pv_list or not isinstance(pv_list[0], str) or pv_list[0].strip() != bm:
+            return _is_move_noisy(board, bm)
+    if not pv_list or not isinstance(pv_list[0], str):
+        return False
+    import chess
+
+    s0 = pv_list[0].strip()
+    if not s0 or s0 in ("0000", "(none)", "none"):
+        return False
+    try:
+        mv0 = chess.Move.from_uci(s0)
+    except ValueError:
+        return False
+    if not mv0 or not board.is_legal(mv0):
+        return False
+    if board.is_capture(mv0) or board.is_en_passant(mv0) or (mv0.promotion is not None):
+        return True
+    if len(pv_list) < 2:
+        return False
+    after = board.copy(stack=False)
+    after.push(mv0)
+    return _is_move_noisy(after, pv_list[1])
+
+
+def _search_with_pv(eng: UciEngine, position_cmd: str, go_cmd: str, timeout: float = 60.0):
+    """Mirror UciEngine.search while also returning the primary PV move list."""
+    eng.send(position_cmd)
+    eng.send(go_cmd)
+    deadline = time.time() + timeout
+    exact = None
+    bound = None
+    exact_pv: list[str] = []
+    bound_pv: list[str] = []
+    last_pv: list[str] = []
+    while True:
+        line = eng._get(deadline)
+        if line.startswith("info"):
+            t = line.split()
+            if len(t) > 1 and t[1] == "string":
+                continue
+            if "multipv" in t:
+                mpv_idx = t.index("multipv")
+                if "string" not in t[:mpv_idx]:
+                    try:
+                        if int(t[mpv_idx + 1]) != 1:
+                            continue
+                    except (ValueError, IndexError):
+                        continue
+            pv_here = _parse_uci_pv(line)
+            if pv_here:
+                last_pv = pv_here
+            if "score" in t:
+                i = t.index("score")
+                if "string" not in t[:i]:
+                    try:
+                        sc = (t[i + 1], int(t[i + 2]))
+                        if len(t) > i + 3 and t[i + 3] in ("lowerbound", "upperbound"):
+                            bound = sc
+                            bound_pv = pv_here
+                        else:
+                            exact = sc
+                            exact_pv = pv_here
+                    except (ValueError, IndexError):
+                        pass
+        elif line.startswith("bestmove"):
+            parts = line.split()
+            bm = parts[1] if len(parts) > 1 else None
+            pv = (exact_pv if exact is not None else bound_pv) or last_pv
+            return bm, (exact or bound), pv
+
