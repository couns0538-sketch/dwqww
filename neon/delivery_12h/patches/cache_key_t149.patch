+def _hce_exe_fingerprint(hce_exe: str) -> str:
+    """Identity of hce_dump.exe for the cache key (Target 149): size + mtime + first 16 hex of sha256."""
+    import hashlib
+    p = Path(hce_exe)
+    st = p.stat()
+    h = hashlib.sha256()
+    with p.open("rb") as fh:
+        for blk in iter(lambda: fh.read(1 << 20), b""):
+            h.update(blk)
+    return f"{st.st_size}:{int(st.st_mtime)}:{h.hexdigest()[:16]}"
+
+
+def _cache_key(st: os.stat_result, hce_exe: str, skip_noisy: bool, skip_check: bool) -> str:
+    return f"{st.st_size}:{int(st.st_mtime)}:{int(skip_noisy)}{int(skip_check)}:{_hce_exe_fingerprint(hce_exe)}:v2"
+
