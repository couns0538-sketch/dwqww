+
+// Hash of minor pieces (knights and bishops of both sides) for minor-piece correction history.
+[[nodiscard]] std::uint64_t minor_piece_key(const Board& board) {
+    const Bitboard wn = board.pieces(White, Knight);
+    const Bitboard wb = board.pieces(White, Bishop);
+    const Bitboard bn = board.pieces(Black, Knight);
+    const Bitboard bb = board.pieces(Black, Bishop);
+    if ((wn | wb | bn | bb) == 0) return 0;
+    const std::uint64_t key = wn * 0x9E3779B97F4A7C15ULL ^
+                              wb * 0xBF58476D1CE4E5B9ULL ^
+                              bn * 0x94D049BB133111EBULL ^
+                              bb * 0x517CC1B727220A95ULL;
+    return b4::mix64(key ^ 0x243F6A8885A308D3ULL);
+}
