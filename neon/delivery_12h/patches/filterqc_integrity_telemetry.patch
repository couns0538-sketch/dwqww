 """Filter and quality-check one round of data.
 
 Input: raw files from datagen (.binpack from the official generator, .plain from self-play).
-Output: filtered.binpack (what the trainer reads), raw.binpack (untouched archive), qc.json.
-
-A filtered position is not deleted. Its score is set to VALUE_NONE (32002), which the nnue-pytorch
-loader skips. Keeping the record keeps the move chains intact, so the binpack stays small.
-Positions in check and positions whose best move is a capture are skipped by the loader itself
-(its `filtered` option), so they are not handled here.
+Output: filtered.plain or filtered.binpack (what the trainer reads), raw_selfplay.binpack (archive), qc.json.
+
+When output is "binpack", filtered positions are marked VALUE_NONE (32002) to preserve move chains.
+When output is "plain", Forge trains with --keep-noisy (captures kept) and skips in-check positions in
+forge_parse.py; qc.json now records noisy telemetry so downstream distributions are visible.
 """
 from __future__ import annotations
 
+import hashlib
 import os
+import struct
 import time
 from pathlib import Path
 
 from .common import VALUE_NONE, atomic_write_json, child_env, log, run_logged, tail_text
 
 SCORE_EDGES = [50, 100, 200, 400, 800, 1600]
+
+
+def _fen4_hash64(parts: list[str]) -> int:
+    """Deterministic 64-bit hash of FEN fields 1..4 (replaces process-randomized Python hash())."""
+    key = " ".join(parts[:4]).encode("ascii", errors="ignore")
+    return struct.unpack("<Q", hashlib.blake2b(key, digest_size=8).digest())[0]
+
+
+def _is_noisy_fen(board_field: str, move: str) -> bool:
+    if len(move) > 4:
+        return True
+    if len(move) < 4:
+        return False
+    fr_f, fr_r = ord(move[0]) - 97, ord(move[1]) - 49
+    to_f, to_r = ord(move[2]) - 97, ord(move[3]) - 49
+    if not (0 <= fr_f < 8 and 0 <= fr_r < 8 and 0 <= to_f < 8 and 0 <= to_r < 8):
+        return False
+    ranks = board_field.split("/")
+    if len(ranks) != 8:
+        return False
+    def at(r: int, fl: int) -> str:
+        col = 0
+        for ch in ranks[7 - r]:
+            if "1" <= ch <= "8":
+                nxt = col + (ord(ch) - 48)
+                if col <= fl < nxt:
+                    return ""
+                col = nxt
+            else:
+                if col == fl:
+                    return ch
+                col += 1
+        return ""
+    if at(to_r, to_f) != "":
+        return True
+    return fr_f != to_f and at(fr_r, fr_f) in ("P", "p")
 
 
