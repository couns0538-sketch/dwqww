+[[nodiscard]] int lmp_threshold(int depth, bool improving, bool cut_node = false) {
+    const int base = tune::LmpBase + depth * depth;
+    if (tune::HistMalusLmpRefine == 0) return improving ? base : base / 2;
+    // Clean-room Stockfish/Stormphrax: scale LMP by improving and tighten on cut nodes.
+    int thresh = improving ? base : base / 2;
+    if (cut_node) thresh = std::max(2, thresh * 3 / 4);
+    return thresh;
 }
 
 [[nodiscard]] int history_bonus(int depth) {
