+[[nodiscard]] int history_malus(int depth) {
+    // Clean-room Stockfish/Stormphrax: gentler depth-scaled quiet malus than cutoff bonus.
+    return std::min(tune::HistoryBonusMax * 3 / 4,
+                    tune::HistoryBonusQuadratic * depth * depth * 2 / 3 +
+                        tune::HistoryBonusLinear * depth * 3 / 4);
 }
 
