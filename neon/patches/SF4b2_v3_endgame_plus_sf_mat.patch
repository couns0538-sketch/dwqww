+int scale_v3_eval(const Board& board, int stm_eval) {
+    if (stm_eval == 0) return 0;
+    const Color strong = stm_eval > 0 ? board.side_to_move() : opposite(board.side_to_move());
+    const Color weak = opposite(strong);
+    const Bitboard strong_pawns = board.pieces(strong, Pawn);
+    auto non_pawn = [&](Color c) {
+        return PieceValueMg[Knight] * popcount(board.pieces(c, Knight)) +
+               PieceValueMg[Bishop] * popcount(board.pieces(c, Bishop)) +
+               PieceValueMg[Rook] * popcount(board.pieces(c, Rook)) +
+               PieceValueMg[Queen] * popcount(board.pieces(c, Queen));
+    };
+    const int strong_np = non_pawn(strong);
+    const int weak_np = non_pawn(weak);
+    // Exact dead draws & pawnless <=1-minor-ahead endings (reusing eval.cpp scale_factor logic).
+    if (strong_pawns == 0 && strong_np - weak_np <= PieceValueMg[Bishop]) {
+        if (strong_np < PieceValueMg[Rook]) return 0;
+        return stm_eval * 12 / 64;
+    }
+    // Opposite-coloured bishops damping.
+    const Bitboard wb = board.pieces(White, Bishop);
+    const Bitboard bb = board.pieces(Black, Bishop);
+    if (popcount(wb) == 1 && popcount(bb) == 1 &&
+        ((wb & DarkSquares) != 0) != ((bb & DarkSquares) != 0)) {
+        const bool only_b = (board.pieces(Knight) | board.pieces(Rook) | board.pieces(Queen)) == 0;
+        const int sp = popcount(strong_pawns);
+        const int sf = only_b ? std::min(64, 32 + 4 * sp) : std::min(64, 48 + 2 * sp);
+        stm_eval = stm_eval * sf / 64;
+    }
+    // Stockfish src/evaluate.cpp scale_evaluation material scaling:
+    const int total_mat = 521 * popcount(board.pieces(Pawn)) +
+        300 * popcount(board.pieces(Knight) | board.pieces(Bishop)) +
+        500 * popcount(board.pieces(Rook)) + 900 * popcount(board.pieces(Queen));
+    // Recentered around typical middlegame material (~4600) so average scale stays near 1.0:
+    stm_eval = static_cast<int>(stm_eval + static_cast<std::int64_t>(total_mat - 4600) * stm_eval / 90649);
+    return stm_eval;
+}
