+// Hash of minor pieces + kings of both sides, for conservative minor-piece correction history (SF9).
+[[nodiscard]] std::uint64_t minor_piece_key(const Board& board) {
+    std::uint64_t key = 0x243F6A8885A308D3ULL;
+    for (const Color color : {White, Black}) {
+        const std::uint64_t csalt = static_cast<std::uint64_t>(color) * 0x517CC1B727220A95ULL;
+        for (const PieceType pt : {Knight, Bishop, King}) {
+            const Bitboard bb = board.pieces(color, pt);
+            key ^= (bb + csalt) * (0x9E3779B97F4A7C15ULL + static_cast<std::uint64_t>(pt) * 0xBF58476D1CE4E5B9ULL);
+            key = (key ^ (key >> 30U)) * 0x94D049BB133111EBULL;
+        }
+    }
+    return key ^ (key >> 31U);
 }
 
