+// The follow-up table a move indexes for the plies after it. Off: always the lock's table. On: a move made while in
+// check and / or capturing gets its own table (index in_check * 2 + capture - 1: 0 capture, 1 evasion, 2 both).
+PieceToHistory* Worker::continuation_for(bool in_check, bool capture, Piece piece, int to) {
+    ContinuationHistory& table = tune::ContHistSplit != 0 && (in_check || capture)
+        ? (*continuation_split_)[static_cast<std::size_t>(in_check) * 2U + static_cast<std::size_t>(capture) - 1U]
+        : *continuation_history_;
+    return &table[static_cast<std::size_t>(piece)][static_cast<std::size_t>(to)];
+}
