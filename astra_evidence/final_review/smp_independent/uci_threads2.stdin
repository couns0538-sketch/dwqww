uci
setoption name OwnBook value false
setoption name Hash value 16
setoption name Threads value 2
setoption name SmpBestThread value true
setoption name SmpProtectProvenScore value false
isready
position startpos
go infinite
setoption name SmpProtectProvenScore value true
isready
position startpos
go depth 5
position startpos
go infinite
setoption name SmpProtectProvenScore value false
isready
quit
