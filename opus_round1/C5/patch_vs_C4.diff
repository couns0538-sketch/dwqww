+        std::vector<int> used(static_cast<std::size_t>(n), 0);
+        for (int pieces = 2; pieces <= 32; ++pieces) ++used[m[static_cast<std::size_t>(pieces)]];
+        for (const int u : used) shapes = shapes && u > 0;
