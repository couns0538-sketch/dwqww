# MinGW UBSan trap-mode positive control (g++ 15.2 ucrt64): overflow.cpp computes (INT_MAX - 1 + argc) + argc
$ g++ -std=c++20 -O2 -static overflow.cpp -o overflow_plain.exe && ./overflow_plain.exe
no trap: -2147483648
exit=0
$ g++ -std=c++20 -O2 -static -fsanitize=undefined -fno-sanitize=vptr -fsanitize-undefined-trap-on-error overflow.cpp -o overflow_ubsan.exe && ./overflow_ubsan.exe
/usr/bin/bash: line 1: 59353 Illegal instruction        ./overflow_ubsan.exe
exit=132 (132 = SIGILL from the ud2 trap)
--- source:
// Positive control for the MinGW UBSan trap build: a signed overflow that depends on argc.
#include <climits>
#include <cstdio>
int main(int argc, char**) {
    int x = INT_MAX - 1 + argc;   // INT_MAX when run without arguments
    int y = x + argc;             // overflows: must trap under -fsanitize=undefined
    std::printf("no trap: %d\n", y);
    return 0;
}
