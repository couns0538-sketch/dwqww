diff --git a/tests/corr_margins_tests.cpp b/tests/corr_margins_tests.cpp
new file mode 100644
index 00000000..e5fb09d7
--- /dev/null
+++ b/tests/corr_margins_tests.cpp
@@ -0,0 +1,385 @@
+// UCI CorrMargins (forge/corr_margins.hpp, test plan G-B3): correction-size
+// pruning margins.
+//   1. The margin functions against the AL1 s198 formulas written out here:
+//      identical at |correction| = 0, monotonic in |correction| (margins never
+//      shrink, the reduction never grows), no change at all when the weight is
+//      0, a strict change when it is not; over default, zero and random tunables.
+//   2. Node decisions of the CorrMargins search instance through the test
+//      probe: with a correction planted in the pawn correction table, reverse
+//      futility pruning and the null-move try happen exactly when the widened
+//      margin allows them (boundary cases included); the default instance
+//      ignores the correction size.
+//   3. Whole searches through the public Searcher: CorrMargins 1 with every
+//      weight 0 is node-for-node the default search; each weight alone changes
+//      the search; the weights do nothing while CorrMargins is 0; ON is
+//      deterministic.
+#include "forge/board.hpp"
+#include "forge/corr_margins.hpp"
+#include "forge/nnue.hpp"
+#include "forge/search.hpp"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace forge {
+// Direct node searches as in tests/rule50_tests.cpp (non-root frame, ply 1).
+struct SearcherTestProbe {
+    static SearchStack* prepare(Searcher& searcher, const Board& board) {
+        searcher.clear_hash();
+        Worker& w = searcher.main_worker();
+        w.clear();
+        w.shared_.stop.store(false, std::memory_order_relaxed);
+        w.shared_.ponder_hit_ns.store(0, std::memory_order_relaxed);
+        w.all_workers_ = nullptr;
+        w.aborted_ = false;
+        w.local_nodes_ = 0;
+        w.nodes_.store(0, std::memory_order_relaxed);
+        w.node_limit_ = 0;
+        w.node_limit_specified_ = false;
+        w.hard_limit_ms_ = w.soft_limit_ms_ = 0;
+        w.time_managed_ = w.pondering_ = false;
+        w.start_ = std::chrono::steady_clock::now();
+        w.seldepth_ = 0;
+        w.null_tries_ = w.null_cutoffs_ = 0;
+        w.root_history_index_ = board.history_size() - 1;
+        SearchStack* ss = &w.stack_[5];
+        ss->ply = 1;
+        nnue::refresh(board, ss->accumulator);
+        return ss;
+    }
+    static int search(Searcher& searcher, Board& board, SearchStack* ss, int depth, int alpha, int beta, bool corr) {
+        Worker& w = searcher.main_worker();
+        return corr ? w.search_corr_margins(board, ss, depth, alpha, beta, false)
+                    : w.search(board, ss, depth, alpha, beta, false);
+    }
+    static std::uint64_t nodes(Searcher& searcher) { return searcher.main_worker().local_nodes_; }
+    static std::uint64_t null_tries(Searcher& searcher) { return searcher.main_worker().null_tries_; }
+    static int raw_eval(Searcher& searcher, const Board& board, SearchStack* ss) {
+        return searcher.main_worker().static_evaluate(board, ss);
+    }
+    static int corrected(Searcher& searcher, const Board& board, int raw) {
+        return searcher.main_worker().corrected_eval(board, raw);
+    }
+    static CorrectionHistory& pawns(Searcher& searcher) { return *searcher.main_worker().correction_history_; }
+};
+} // namespace forge
+
+using namespace forge;
+using Probe = SearcherTestProbe;
+
+namespace {
+
+int failures = 0;
+int checks = 0;
+
+void check(bool ok, const std::string& what) {
+    ++checks;
+    if (!ok) {
+        ++failures;
+        if (failures <= 40) std::cout << "FAIL " << what << '\n';
+        else if (failures == 41) std::cout << "(further failures not printed)\n";
+    }
+}
+
+// The AL1 s198 formulas (src/search/alphabeta.inc of the lock), written out independently.
+int lock_rfp_margin(int depth, bool improving) { return tune::RfpMargin * depth - tune::RfpImproving * improving; }
+int lock_futility_margin(int lmr_depth) { return tune::FutilityBase + tune::FutilityMultiplier * lmr_depth; }
+int lock_null_threshold(int beta, int depth) { return beta - 24 * depth + 180; }
+
+struct Weights {
+    int rfp, futility, null_move, lmr;
+};
+
+void set_weights(const Weights& w) {
+    tune::CorrRfpPct = w.rfp;
+    tune::CorrFutilityPct = w.futility;
+    tune::CorrNullMovePct = w.null_move;
+    tune::CorrLmrPct = w.lmr;
+}
+
+std::uint64_t lcg(std::uint64_t& state) {
+    state = state * 6364136223846793005ULL + 1442695040888963407ULL;
+    return state >> 33U;
+}
+int uniform(std::uint64_t& state, int lo, int hi) { return lo + static_cast<int>(lcg(state) % static_cast<std::uint64_t>(hi - lo + 1)); }
+
+// Largest |correction| the tables can produce (MaterialCorrectionWeight at its maximum, 300).
+constexpr int MaxCorrection = (CorrectionLimit + CorrectionLimit * 3) / CorrectionGrain;
+
+void check_margin_functions(const std::string& label) {
+    const std::array<int, 7> betas{-MateInMaxPly + 1, -1500, -37, 0, 41, 900, MateInMaxPly - 1};
+    for (int depth = 0; depth <= 64; ++depth) {
+        for (const bool improving : {false, true}) {
+            const std::string at = label + " depth " + std::to_string(depth) + " improving " + std::to_string(improving);
+            check(corr_margins::rfp_margin(depth, improving, 0) == lock_rfp_margin(depth, improving), "rfp lock identity " + at);
+            for (int c = 0; c < MaxCorrection + 8; ++c) {
+                const int m0 = corr_margins::rfp_margin(depth, improving, c);
+                const int m1 = corr_margins::rfp_margin(depth, improving, c + 1);
+                if (m1 < m0) check(false, "rfp monotonic " + at + " c " + std::to_string(c));
+                if (tune::CorrRfpPct == 0 && m0 != lock_rfp_margin(depth, improving))
+                    check(false, "rfp inert at weight 0 " + at + " c " + std::to_string(c));
+            }
+            if (tune::CorrRfpPct > 0)
+                check(corr_margins::rfp_margin(depth, improving, 100) > lock_rfp_margin(depth, improving), "rfp widens " + at);
+        }
+        const std::string at = label + " lmr_depth " + std::to_string(depth);
+        check(corr_margins::futility_margin(depth, 0) == lock_futility_margin(depth), "futility lock identity " + at);
+        for (int c = 0; c < MaxCorrection + 8; ++c) {
+            const int m0 = corr_margins::futility_margin(depth, c);
+            if (corr_margins::futility_margin(depth, c + 1) < m0) check(false, "futility monotonic " + at + " c " + std::to_string(c));
+            if (tune::CorrFutilityPct == 0 && m0 != lock_futility_margin(depth))
+                check(false, "futility inert at weight 0 " + at + " c " + std::to_string(c));
+        }
+        if (tune::CorrFutilityPct > 0)
+            check(corr_margins::futility_margin(depth, 100) > lock_futility_margin(depth), "futility widens " + at);
+        for (const int beta : betas) {
+            const std::string bt = label + " depth " + std::to_string(depth) + " beta " + std::to_string(beta);
+            check(corr_margins::null_move_threshold(beta, depth, 0) == lock_null_threshold(beta, depth), "null-move lock identity " + bt);
+            for (int c = 0; c < MaxCorrection + 8; ++c) {
+                const int t0 = corr_margins::null_move_threshold(beta, depth, c);
+                if (corr_margins::null_move_threshold(beta, depth, c + 1) < t0)
+                    check(false, "null-move monotonic " + bt + " c " + std::to_string(c));
+                if (tune::CorrNullMovePct == 0 && t0 != lock_null_threshold(beta, depth))
+                    check(false, "null-move inert at weight 0 " + bt + " c " + std::to_string(c));
+            }
+            if (tune::CorrNullMovePct > 0)
+                check(corr_margins::null_move_threshold(beta, depth, 100) > lock_null_threshold(beta, depth), "null-move widens " + bt);
+        }
+    }
+    for (int r = -6; r <= 24; ++r) {
+        const std::string at = label + " r " + std::to_string(r);
+        check(corr_margins::lmr_reduction(r, 0) == r, "lmr lock identity " + at);
+        for (int c = 0; c < MaxCorrection + 8; ++c) {
+            const int v0 = corr_margins::lmr_reduction(r, c);
+            const int v1 = corr_margins::lmr_reduction(r, c + 1);
+            if (v1 > v0) check(false, "lmr monotonic " + at + " c " + std::to_string(c));
+            if (r <= 0 && v0 != r) check(false, "lmr leaves r <= 0 alone " + at + " c " + std::to_string(c));
+            if (r > 0 && (v0 < 0 || v0 > r)) check(false, "lmr stays in [0, r] " + at + " c " + std::to_string(c));
+            if (tune::CorrLmrPct == 0 && v0 != r) check(false, "lmr inert at weight 0 " + at + " c " + std::to_string(c));
+        }
+    }
+    // CorrLmrPct percent of the reduction per 64 cp, rounded down.
+    if (tune::CorrLmrPct > 0) {
+        const int r = 8;
+        const int expected = r - std::min(r, r * 64 * tune::CorrLmrPct / 6400);
+        check(corr_margins::lmr_reduction(r, 64) == expected, label + " lmr share at 64 cp");
+        check(corr_margins::lmr_reduction(r, 64) < r || r * tune::CorrLmrPct < 100, label + " lmr relief happens");
+    }
+}
+
+void test_correction_size() {
+    check(corr_margins::correction_size(true, 120, 80) == 0, "correction size 0 in check");
+    check(corr_margins::correction_size(false, ValueNone, ValueNone) == 0, "correction size 0 without evaluation");
+    check(corr_margins::correction_size(false, ValueNone, 30) == 0, "correction size 0 without static eval");
+    check(corr_margins::correction_size(false, 30, ValueNone) == 0, "correction size 0 without raw eval");
+    for (int raw = -300; raw <= 300; raw += 17) {
+        for (int corr = -70; corr <= 70; corr += 7) {
+            const int size = corr_margins::correction_size(false, raw + corr, raw);
+            if (size != (corr < 0 ? -corr : corr)) check(false, "correction size = |static - raw| raw " + std::to_string(raw));
+        }
+    }
+}
+
+void test_margin_functions() {
+    const Weights defaults{tune::CorrRfpPct, tune::CorrFutilityPct, tune::CorrNullMovePct, tune::CorrLmrPct};
+    const std::array<int, 4> lock_values{tune::RfpMargin, tune::RfpImproving, tune::FutilityBase, tune::FutilityMultiplier};
+    check(defaults.rfp == 50 && defaults.futility == 100 && defaults.null_move == 50 && defaults.lmr == 25,
+          "documented default weights 50/100/50/25");
+    check_margin_functions("default weights");
+    set_weights({0, 0, 0, 0});
+    check_margin_functions("zero weights");
+    std::uint64_t state = 0x5eed0c0aULL;
+    for (int round = 0; round < 40; ++round) {
+        set_weights({uniform(state, 0, 400), uniform(state, 0, 400), uniform(state, 0, 400), uniform(state, 0, 400)});
+        tune::RfpMargin = uniform(state, 10, 300);
+        tune::RfpImproving = uniform(state, 0, 200);
+        tune::FutilityBase = uniform(state, 0, 500);
+        tune::FutilityMultiplier = uniform(state, 0, 500);
+        check_margin_functions("random tunables round " + std::to_string(round));
+    }
+    set_weights(defaults);
+    tune::RfpMargin = lock_values[0];
+    tune::RfpImproving = lock_values[1];
+    tune::FutilityBase = lock_values[2];
+    tune::FutilityMultiplier = lock_values[3];
+}
+
+Board board_from(const std::string& fen) {
+    Board board;
+    if (!board.set_fen(fen)) throw std::runtime_error("invalid FEN " + fen);
+    return board;
+}
+
+// White to move, a queen up, quiet: reverse futility and null-move candidates.
+const std::string QueenUp = "4k3/pp6/8/8/8/8/PP1Q4/4K3 w - - 0 1";
+
+struct NodeResult {
+    int score;
+    std::uint64_t nodes;
+    std::uint64_t null_tries;
+};
+
+// One direct non-PV node search at ply 1 with `correction_cp` planted in the
+// pawn correction entry of the position; beta is placed `beta_offset` below
+// the corrected static evaluation.
+NodeResult node_search(bool corr_instance, int depth, int correction_cp, int beta_offset, int* eval_out = nullptr) {
+    Searcher searcher(1, 1);
+    Board board = board_from(QueenUp);
+    SearchStack* ss = Probe::prepare(searcher, board);
+    if (depth >= tune::NullMoveMinDepth) (ss - 1)->current_move = Move{8, 16, 0, 0};  // a parent move (not none)
+    const std::size_t side = static_cast<std::size_t>(board.side_to_move());
+    Probe::pawns(searcher)[side][board.pawn_key() & (CorrectionSize - 1U)] = correction_cp * CorrectionGrain;
+    const int raw = Probe::raw_eval(searcher, board, ss);
+    const int eval = Probe::corrected(searcher, board, raw);
+    if (eval_out) *eval_out = eval;
+    const int beta = eval - beta_offset;
+    const int score = Probe::search(searcher, board, ss, depth, beta - 1, beta, corr_instance);
+    return {score, Probe::nodes(searcher), Probe::null_tries(searcher)};
+}
+
+void test_rfp_decision() {
+    const Weights saved{tune::CorrRfpPct, tune::CorrFutilityPct, tune::CorrNullMovePct, tune::CorrLmrPct};
+    // Depth 1, improving (no earlier static evals): AL1 s198 margin 72 - 40 = 32; slack 10.
+    const int margin = lock_rfp_margin(1, true);
+    const int slack = 10;
+    struct Case { int weight; int correction; bool prunes; };
+    const std::array<Case, 9> cases{{
+        {0, 40, true}, {100, 0, true}, {100, 40, false}, {100, -40, false},
+        {20, 40, true},   // widening 8 < slack
+        {25, 40, true},   // widening 10 == slack: eval - margin >= beta still holds
+        {26, 40, true},   // 40 * 26 / 100 = 10 (rounded down)
+        {28, 40, false},  // widening 11 > slack
+        {28, -40, false},
+    }};
+    for (const Case& c : cases) {
+        set_weights({c.weight, 0, 0, 0});
+        int eval = 0;
+        const NodeResult on = node_search(true, 1, c.correction, margin + slack, &eval);
+        const NodeResult off = node_search(false, 1, c.correction, margin + slack);
+        const std::string at = "rfp node weight " + std::to_string(c.weight) + " correction " + std::to_string(c.correction);
+        check(eval != 0, at + ": evaluation available");
+        check(off.nodes == 1 && off.score == eval, at + ": default instance prunes");
+        if (c.prunes) check(on.nodes == 1 && on.score == eval, at + ": CorrMargins instance prunes");
+        else check(on.nodes > 1, at + ": CorrMargins instance searches the node");
+    }
+    set_weights(saved);
+}
+
+void test_null_move_decision() {
+    const Weights saved{tune::CorrRfpPct, tune::CorrFutilityPct, tune::CorrNullMovePct, tune::CorrLmrPct};
+    // Depth 3, beta = eval - 120: no reverse futility (margin 3 * 72 - 40 = 176 > 120), and the
+    // AL1 s198 null-move condition static_eval >= beta - 72 + 180 = eval - 12 holds with slack 12.
+    const int depth = 3;
+    const int beta_offset = 120;
+    check(lock_rfp_margin(depth, true) > beta_offset, "null-move fixture has no reverse futility");
+    struct Case { int weight; int correction; bool tries; };
+    const std::array<Case, 7> cases{{
+        {0, 40, true}, {100, 0, true}, {100, 40, false}, {100, -40, false},
+        {100, 12, true},  // threshold + 12 == static eval: >= holds
+        {100, 13, false},
+        {30, 40, true},   // 40 * 30 / 100 = 12
+    }};
+    for (const Case& c : cases) {
+        set_weights({0, 0, c.weight, 0});
+        const NodeResult on = node_search(true, depth, c.correction, beta_offset);
+        const NodeResult off = node_search(false, depth, c.correction, beta_offset);
+        const std::string at = "null-move node weight " + std::to_string(c.weight) + " correction " + std::to_string(c.correction);
+        check(off.null_tries == 1, at + ": default instance tries the null move");
+        check(on.null_tries == (c.tries ? 1U : 0U), at + ": CorrMargins instance null-move try");
+    }
+    set_weights(saved);
+}
+
+struct SearchResult {
+    std::uint64_t nodes;
+    Move best;
+    int score;
+    bool operator==(const SearchResult&) const = default;
+};
+
+const std::array<std::string, 8> BenchFens{
+    "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
+    "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
+    "r4rk1/1pp1qppp/p1np1n2/8/2B1P1b1/2N2N2/PPP1QPPP/2KR3R w - - 0 10",
+    "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",
+    "r1bq1rk1/pp2bppp/2n1pn2/3p4/2PP4/2N1PN2/PP3PPP/R2QKB1R w KQ - 0 8",
+    "2rr3k/pp3pp1/1nnqbN1p/3pN3/2pP4/2P3Q1/PPB4P/R4RK1 w - - 0 1",
+    "6k1/5ppp/8/8/8/8/5PPP/3R2K1 b - - 0 1",
+    "r2q1rk1/ppp2ppp/2n1bn2/2bpp3/3PP3/2N1BN2/PPP1BPPP/R2Q1RK1 w - - 0 9",
+};
+
+std::vector<SearchResult> run_set(int depth) {
+    std::vector<SearchResult> out;
+    Searcher searcher(16, 1);
+    for (const std::string& fen : BenchFens) {
+        searcher.clear();
+        SearchLimits limits;
+        limits.depth = depth;
+        const SearchInfo info = searcher.search(board_from(fen), limits, false, Searcher::TTAccess::Exclusive);
+        out.push_back({info.nodes, info.best_move, info.score});
+    }
+    return out;
+}
+
+std::uint64_t total(const std::vector<SearchResult>& results) {
+    std::uint64_t sum = 0;
+    for (const SearchResult& r : results) sum += r.nodes;
+    return sum;
+}
+
+void test_whole_search() {
+    const Weights defaults{tune::CorrRfpPct, tune::CorrFutilityPct, tune::CorrNullMovePct, tune::CorrLmrPct};
+    const int depth = 11;
+    options::corr_margins = 0;
+    const auto off = run_set(depth);
+    std::cout << "whole search depth " << depth << ": off nodes " << total(off) << '\n';
+    check(total(off) == 312866, "CorrMargins 0 reproduces the AL1 s198 bench d11 node count 312866");
+
+    options::corr_margins = 1;
+    set_weights({0, 0, 0, 0});
+    const auto zero = run_set(depth);
+    check(zero == off, "CorrMargins 1 with all weights 0 == default search (nodes, best move, score)");
+
+    const std::array<std::pair<const char*, Weights>, 4> single{{
+        {"CorrRfpPct", {400, 0, 0, 0}}, {"CorrFutilityPct", {0, 400, 0, 0}},
+        {"CorrNullMovePct", {0, 0, 400, 0}}, {"CorrLmrPct", {0, 0, 0, 100}},
+    }};
+    for (const auto& [name, weights] : single) {
+        set_weights(weights);
+        const auto alone = run_set(depth);
+        std::cout << "whole search depth " << depth << ": " << name << " alone nodes " << total(alone) << '\n';
+        check(alone != off, std::string(name) + " alone changes the search");
+    }
+
+    set_weights(defaults);
+    const auto on = run_set(depth);
+    const auto again = run_set(depth);
+    std::cout << "whole search depth " << depth << ": on (default weights) nodes " << total(on) << '\n';
+    check(on != off, "CorrMargins 1 with the default weights changes the search");
+    check(on == again, "CorrMargins 1 is deterministic");
+
+    options::corr_margins = 0;
+    set_weights({400, 400, 400, 400});
+    const auto off_weighted = run_set(depth);
+    check(off_weighted == off, "weights are inert while CorrMargins is 0");
+    set_weights(defaults);
+}
+
+} // namespace
+
+int main() {
+    test_correction_size();
+    test_margin_functions();
+    test_rfp_decision();
+    test_null_move_decision();
+    test_whole_search();
+    std::cout << "corr_margins: checks=" << checks << " failures=" << failures << '\n';
+    std::cout << (failures == 0 ? "PASS" : "FAIL") << " corr_margins_tests\n";
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tests/history_tests.cpp b/tests/history_tests.cpp
new file mode 100644
index 00000000..a881af43
--- /dev/null
+++ b/tests/history_tests.cpp
@@ -0,0 +1,266 @@
+// History update math (forge/history.hpp) against independent reference
+// formulas: bonus shape, gravity saturation, killer shift, counter moves,
+// butterfly / continuation (plies 1, 2 and half at 4) / capture updates.
+#include "forge/search.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace forge {
+// The history rules are Worker members (src/search/history.inc); reach them
+// and the tables through the usual test probe.
+struct SearcherTestProbe {
+    static HistoryTables& histories(Worker& w) { return w.histories_; }
+    static int quiet_history(Worker& w, const Board& b, const SearchStack* ss, Move m) { return w.quiet_history(b, ss, m); }
+    static int capture_history_value(Worker& w, const Board& b, Move m) { return w.capture_history_value(b, m); }
+    static void update_continuation(Worker& w, SearchStack* ss, Piece p, int to, int bonus) { w.update_continuation(ss, p, to, bonus); }
+    static void update_quiet_stats(Worker& w, const Board& b, SearchStack* ss, Move m, int depth, const Move* q, int n) {
+        w.update_quiet_stats(b, ss, m, depth, q, n);
+    }
+    static void update_capture_stats(Worker& w, const Board& b, Move best, int depth, const Move* c, int n) {
+        w.update_capture_stats(b, best, depth, c, n);
+    }
+};
+} // namespace forge
+
+using namespace forge;
+using Probe = SearcherTestProbe;
+
+namespace {
+
+int failures = 0;
+int checks = 0;
+
+void check(bool okay, const std::string& name) {
+    ++checks;
+    if (!okay) {
+        ++failures;
+        if (failures <= 50) std::cout << "FAIL " << name << '\n';
+    }
+}
+
+Board position(const std::string& fen) {
+    Board board;
+    if (!board.set_fen(fen)) throw std::runtime_error("invalid fixture FEN: " + fen);
+    return board;
+}
+
+Move uci(Board& board, const std::string& text) {
+    const auto move = board.parse_uci(text);
+    if (!move) throw std::runtime_error("illegal fixture move " + text);
+    return *move;
+}
+
+int reference_bonus(int depth) {
+    return std::min(tune::HistoryBonusMax, tune::HistoryBonusQuadratic * depth * depth + tune::HistoryBonusLinear * depth - 32);
+}
+
+std::int16_t reference_gravity(int entry, int bonus) {
+    const int clamped = bonus < -16384 ? -16384 : (bonus > 16384 ? 16384 : bonus);
+    // C++ integer division truncates toward zero.
+    return static_cast<std::int16_t>(entry + clamped - entry * (clamped < 0 ? -clamped : clamped) / 16384);
+}
+
+void test_bonus_and_gravity() {
+    for (int depth = -2; depth <= 40; ++depth) {
+        check(history_bonus(depth) == reference_bonus(depth), "history_bonus depth " + std::to_string(depth));
+    }
+    // The bonus shape follows the tunables.
+    const int quadratic = tune::HistoryBonusQuadratic, linear = tune::HistoryBonusLinear, maximum = tune::HistoryBonusMax;
+    tune::HistoryBonusQuadratic = 7;
+    tune::HistoryBonusLinear = 100;
+    tune::HistoryBonusMax = 900;
+    for (int depth = 0; depth <= 20; ++depth) {
+        check(history_bonus(depth) == std::min(900, 7 * depth * depth + 100 * depth - 32),
+              "history_bonus with tuned shape depth " + std::to_string(depth));
+    }
+    tune::HistoryBonusQuadratic = quadratic;
+    tune::HistoryBonusLinear = linear;
+    tune::HistoryBonusMax = maximum;
+    check(HistoryMax == 16384, "HistoryMax is 16384");
+
+    const std::array<int, 15> bonuses{0, 1, -1, 31, -31, 400, -400, 2048, -2048, 16384, -16384, 16385, -16385, 50000, -50000};
+    bool exact = true;
+    bool bounded = true;
+    for (int entry = -HistoryMax; entry <= HistoryMax; entry += 37) {
+        for (const int bonus : bonuses) {
+            std::int16_t value = static_cast<std::int16_t>(entry);
+            apply_history(value, bonus);
+            exact &= value == reference_gravity(entry, bonus);
+            bounded &= value >= -HistoryMax && value <= HistoryMax;
+        }
+    }
+    check(exact, "apply_history matches the gravity formula on a grid");
+    check(bounded, "apply_history keeps entries inside +/-HistoryMax");
+
+    // Repeated rewards converge monotonically and never overshoot.
+    std::int16_t up = 0, down = 0;
+    bool monotonic = true;
+    for (int i = 0; i < 20000; ++i) {
+        const std::int16_t before_up = up, before_down = down;
+        apply_history(up, 2048);
+        apply_history(down, -2048);
+        monotonic &= up >= before_up && down <= before_down && up <= HistoryMax && down >= -HistoryMax;
+    }
+    check(monotonic, "repeated +/-2048 bonuses are monotonic and saturate inside the bound");
+    check(up > 16000 && down < -16000, "saturation approaches +/-HistoryMax");
+}
+
+struct Frames {
+    std::array<SearchStack, 10> stack{};
+    SearchStack* ss = &stack[6];
+};
+
+void test_quiet_stats() {
+    SharedSearchState shared(1);
+    auto worker = std::make_unique<Worker>(shared, 0);
+    Worker& w = *worker;
+    HistoryTables& h = Probe::histories(w);
+    Board board = position("r1bqkb1r/pppp1ppp/2n2n2/4p3/2B1P3/5N2/PPPP1PPP/RNBQK2R w KQkq - 4 4");
+    const Move best = uci(board, "d2d3");
+    const Move other1 = uci(board, "b1c3");
+    const Move other2 = uci(board, "e1g1");
+    const Move older_killer = uci(board, "a2a3");
+
+    for (const int depth : {1, 4, 9, 13}) {
+        h.clear();
+        Frames f;
+        SearchStack* ss = f.ss;
+        ss->killers = {older_killer, Move::none()};
+        // Previous moves: ply-1 knight to f6 (black), ply-2 a white move, ply-4 present, ply-3 absent.
+        PieceToHistory& c1 = (*h.continuation_history)[BN][45];
+        PieceToHistory& c2 = (*h.continuation_history)[WB][26];
+        PieceToHistory& c3 = (*h.continuation_history)[BP][36];
+        PieceToHistory& c4 = (*h.continuation_history)[WN][21];
+        (ss - 1)->continuation = &c1; (ss - 1)->current_move = Move{62, 45, 0, 0}; (ss - 1)->moved_piece = BN;
+        (ss - 2)->continuation = &c2; (ss - 2)->current_move = Move{5, 26, 0, 0}; (ss - 2)->moved_piece = WB;
+        (ss - 3)->continuation = &c3; (ss - 3)->current_move = Move::none(); (ss - 3)->moved_piece = Empty;
+        (ss - 4)->continuation = &c4; (ss - 4)->current_move = Move{6, 21, 0, 0}; (ss - 4)->moved_piece = WN;
+        // Seed some existing values so gravity is exercised from non-zero entries.
+        (*h.main_history)[White][best.from][best.to] = 1000;
+        (*h.main_history)[White][other1.from][other1.to] = -700;
+        c1[WP][best.to] = 3000;
+        c4[WN][other1.to] = 5000;
+
+        const int bonus = reference_bonus(depth);
+        const auto main_best = (*h.main_history)[White][best.from][best.to];
+        const auto main_o1 = (*h.main_history)[White][other1.from][other1.to];
+        const auto main_o2 = (*h.main_history)[White][other2.from][other2.to];
+        const auto c1_best = c1[WP][best.to], c2_best = c2[WP][best.to], c4_best = c4[WP][best.to];
+        const auto c1_o1 = c1[WN][other1.to], c4_o1 = c4[WN][other1.to];
+        const auto c3_snapshot = c3;
+        const std::array<Move, 4> quiets{other1, best, other2, best}; // best appears twice: never penalised
+        Probe::update_quiet_stats(w, board, ss, best, depth, quiets.data(), static_cast<int>(quiets.size()));
+
+        const std::string d = " depth " + std::to_string(depth);
+        check(ss->killers[0] == best && ss->killers[1] == older_killer, "killer shift" + d);
+        check((*h.counter_moves)[BN][45] == best, "counter move stored under the previous piece/to" + d);
+        check((*h.main_history)[White][best.from][best.to] == reference_gravity(main_best, bonus), "butterfly reward" + d);
+        check((*h.main_history)[White][other1.from][other1.to] == reference_gravity(main_o1, -bonus), "butterfly penalty 1" + d);
+        check((*h.main_history)[White][other2.from][other2.to] == reference_gravity(main_o2, -bonus), "butterfly penalty 2" + d);
+        check(c1[WP][best.to] == reference_gravity(c1_best, bonus), "continuation ply-1 reward" + d);
+        check(c2[WP][best.to] == reference_gravity(c2_best, bonus), "continuation ply-2 reward" + d);
+        check(c4[WP][best.to] == reference_gravity(c4_best, bonus / 2), "continuation ply-4 half reward" + d);
+        check(c1[WN][other1.to] == reference_gravity(c1_o1, -bonus), "continuation ply-1 penalty" + d);
+        check(c4[WN][other1.to] == reference_gravity(c4_o1, -bonus / 2), "continuation ply-4 half penalty" + d);
+        check(c3 == c3_snapshot, "ply-3 continuation untouched (and absent ply skipped)" + d);
+    }
+
+    // Same killer again: the killer pair is unchanged.
+    {
+        h.clear();
+        Frames f;
+        f.ss->killers = {best, older_killer};
+        Probe::update_quiet_stats(w, board, f.ss, best, 5, nullptr, 0);
+        check(f.ss->killers[0] == best && f.ss->killers[1] == older_killer, "repeated killer keeps the pair");
+        // No previous move: no counter move is written anywhere.
+        bool counters_empty = true;
+        for (const auto& piece : *h.counter_moves)
+            for (const Move move : piece) counters_empty &= move.is_none();
+        check(counters_empty, "no counter move without a previous move");
+    }
+    // Null continuation pointers and missing previous moves are skipped safely.
+    {
+        h.clear();
+        Frames f;
+        PieceToHistory& c2 = (*h.continuation_history)[BQ][3];
+        (f.ss - 2)->continuation = &c2;
+        (f.ss - 2)->current_move = Move::none();
+        Probe::update_continuation(w, f.ss, WP, best.to, 999);
+        bool all_zero = true;
+        for (const auto& piece : c2)
+            for (const auto entry : piece) all_zero &= entry == 0;
+        check(all_zero, "continuation of a ply without a move is not updated");
+    }
+}
+
+void test_quiet_history_sum() {
+    SharedSearchState shared(1);
+    auto worker = std::make_unique<Worker>(shared, 0);
+    Worker& w = *worker;
+    HistoryTables& h = Probe::histories(w);
+    Board board = position(std::string(Board::StandardStartFen));
+    const Move move = uci(board, "g1f3");
+    Frames f;
+    (*h.main_history)[White][move.from][move.to] = 111;
+    check(Probe::quiet_history(w, board, f.ss, move) == 111, "quiet history without continuations is the butterfly value");
+    PieceToHistory& c1 = (*h.continuation_history)[BP][35];
+    PieceToHistory& c2 = (*h.continuation_history)[WP][28];
+    c1[WN][move.to] = -40;
+    c2[WN][move.to] = 2500;
+    (f.ss - 1)->continuation = &c1;
+    check(Probe::quiet_history(w, board, f.ss, move) == 71, "butterfly + continuation(ply-1)");
+    (f.ss - 2)->continuation = &c2;
+    check(Probe::quiet_history(w, board, f.ss, move) == 2571, "butterfly + continuation(ply-1) + continuation(ply-2)");
+    check(Probe::quiet_history(w, board, nullptr, move) == 111, "null stack uses only the butterfly value");
+}
+
+void test_capture_stats() {
+    SharedSearchState shared(1);
+    auto worker = std::make_unique<Worker>(shared, 0);
+    Worker& w = *worker;
+    HistoryTables& h = Probe::histories(w);
+    Board board = position("r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1");
+    const Move best = uci(board, "e5f7");   // knight takes pawn
+    const Move other = uci(board, "d5e6");  // pawn takes pawn
+    const Move other2 = uci(board, "f3f6"); // queen takes knight
+    for (const int depth : {2, 8}) {
+        h.clear();
+        (*h.capture_history)[WN][best.to][Pawn] = -3000;
+        (*h.capture_history)[WQ][other2.to][Knight] = 9000;
+        const int bonus = reference_bonus(depth);
+        const std::array<Move, 3> tried{other, best, other2};
+        Probe::update_capture_stats(w, board, best, depth, tried.data(), static_cast<int>(tried.size()));
+        const std::string d = " depth " + std::to_string(depth);
+        check((*h.capture_history)[WN][best.to][Pawn] == reference_gravity(-3000, bonus), "capture reward" + d);
+        check((*h.capture_history)[WP][other.to][Pawn] == reference_gravity(0, -bonus), "capture penalty" + d);
+        check((*h.capture_history)[WQ][other2.to][Knight] == reference_gravity(9000, -bonus), "capture penalty from seed" + d);
+        check(Probe::capture_history_value(w, board, best) == (*h.capture_history)[WN][best.to][Pawn], "capture_history_value lookup" + d);
+    }
+    // A quiet best move only penalises the captures that were tried.
+    h.clear();
+    const Move quiet = uci(board, "a2a3");
+    const std::array<Move, 1> tried{other};
+    Probe::update_capture_stats(w, board, quiet, 6, tried.data(), 1);
+    check((*h.capture_history)[WP][other.to][Pawn] == reference_gravity(0, -reference_bonus(6)), "quiet best: tried capture penalised");
+    check((*h.capture_history)[WP][quiet.to][0] == 0, "quiet best: no capture reward");
+}
+
+} // namespace
+
+int main() {
+    test_bonus_and_gravity();
+    test_quiet_stats();
+    test_quiet_history_sum();
+    test_capture_stats();
+    std::cout << "history math: checks=" << checks << " failures=" << failures << '\n';
+    std::cout << (failures == 0 ? "PASS" : "FAIL") << " history_tests\n";
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tests/movepicker_tests.cpp b/tests/movepicker_tests.cpp
new file mode 100644
index 00000000..8a88b377
--- /dev/null
+++ b/tests/movepicker_tests.cpp
@@ -0,0 +1,392 @@
+// Stage-order contract of the staged move picker (src/search/movepicker.hpp).
+// The picker output is compared with an independent reference built from the
+// move generator, SEE and the history tables, over fixed positions with
+// seeded random history contents, TT moves, killers and counter moves:
+//   Main:       TT, good captures (SEE >= 0) by score, killer 1, killer 2,
+//               counter, quiets by score, bad captures by score.
+//   Quiescence: TT (captures/promotions only), captures by score.
+//   Evasions:   TT, then every move by evasion score.
+// Within a scored stage, equal scores may come in any order, so a stage is
+// checked as a multiset with non-increasing scores.
+#include "forge/search.hpp"
+#include "search/movepicker.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <iostream>
+#include <map>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace forge {
+// The picker reads the worker's tables through Worker friendship; the test
+// fills them through the usual test probe.
+struct SearcherTestProbe {
+    static HistoryTables& histories(Worker& worker) { return worker.histories_; }
+};
+} // namespace forge
+
+using namespace forge;
+
+namespace {
+
+int failures = 0;
+int checks = 0;
+
+void check(bool okay, const std::string& name) {
+    ++checks;
+    if (!okay) {
+        ++failures;
+        if (failures <= 50) std::cout << "FAIL " << name << '\n';
+    }
+}
+
+struct Rng {
+    std::uint64_t state;
+    std::uint64_t next() {
+        state ^= state << 13U;
+        state ^= state >> 7U;
+        state ^= state << 17U;
+        return state;
+    }
+    int range(int lo, int hi) { return lo + static_cast<int>(next() % static_cast<std::uint64_t>(hi - lo + 1)); }
+};
+
+Board position(const std::string& fen) {
+    Board board;
+    if (!board.set_fen(fen)) throw std::runtime_error("invalid fixture FEN: " + fen);
+    return board;
+}
+
+std::string name_of(Move move) { return Board::move_to_uci(move); }
+
+// Reference scores (the documented ordering keys).
+int capture_score(const Board& board, const HistoryTables& h, Move move) {
+    const int captured = piece_type(board.captured_piece(move));
+    int value = SeePieceValue[static_cast<std::size_t>(captured)];
+    if (move.is_promotion()) value += SeePieceValue[move.promotion] - SeePieceValue[Pawn];
+    int score = 10 * value + (*h.capture_history)[static_cast<std::size_t>(board.moved_piece(move))][move.to][static_cast<std::size_t>(captured)];
+    if (move.is_promotion()) score += move.promotion == Queen ? 20000 : -5000;
+    return score;
+}
+
+bool direct_check(const Board& board, Move move) {
+    const Color them = opposite(board.side_to_move());
+    const int king = board.king_square(them);
+    const Bitboard occupancy = board.occupied();
+    Bitboard targets = 0;
+    switch (piece_type(board.moved_piece(move))) {
+    case Pawn: targets = attacks::pawn(them, king); break;
+    case Knight: targets = attacks::knight(king); break;
+    case Bishop: targets = attacks::bishop(king, occupancy); break;
+    case Rook: targets = attacks::rook(king, occupancy); break;
+    case Queen: targets = attacks::bishop(king, occupancy) | attacks::rook(king, occupancy); break;
+    default: break;
+    }
+    return (targets & square_bb(move.to)) != 0;
+}
+
+int quiet_score(const Board& board, const HistoryTables& h, const SearchStack* ss, Move move) {
+    const Piece piece = board.moved_piece(move);
+    int score = (*h.main_history)[static_cast<std::size_t>(board.side_to_move())][move.from][move.to];
+    if ((ss - 1)->continuation != nullptr) score += (*(ss - 1)->continuation)[static_cast<std::size_t>(piece)][move.to];
+    if ((ss - 2)->continuation != nullptr) score += (*(ss - 2)->continuation)[static_cast<std::size_t>(piece)][move.to];
+    return score + (direct_check(board, move) ? 12000 : 0);
+}
+
+int evasion_score(const Board& board, const HistoryTables& h, const SearchStack* ss, Move move) {
+    if (move.is_capture() || move.is_promotion()) {
+        int value = SeePieceValue[static_cast<std::size_t>(piece_type(board.captured_piece(move)))];
+        if (move.is_promotion()) value += SeePieceValue[move.promotion] - SeePieceValue[Pawn];
+        return 1'000'000 + 10 * value - SeePieceValue[static_cast<std::size_t>(piece_type(board.moved_piece(move)))] / 10;
+    }
+    return quiet_score(board, h, ss, move);
+}
+
+std::vector<Move> generate(const Board& board, bool captures_only) {
+    MoveList list;
+    board.generate_pseudo_legal(list, captures_only);
+    return {list.begin(), list.end()};
+}
+
+struct Stage {
+    std::string name;
+    bool scored = false;          // multiset + non-increasing score, else exact order
+    bool see_nonnegative = false; // expected last_move_see_nonnegative() for its moves
+    std::vector<Move> moves;
+    std::map<std::uint32_t, int> scores;
+};
+
+std::uint32_t key(Move move) {
+    return static_cast<std::uint32_t>(move.from) | static_cast<std::uint32_t>(move.to) << 8U |
+           static_cast<std::uint32_t>(move.promotion) << 16U | static_cast<std::uint32_t>(move.flags) << 24U;
+}
+
+struct Pick {
+    Move move;
+    bool see_nonnegative;
+};
+
+std::vector<Pick> run_picker(const Board& board, const Worker& worker, const SearchStack* ss, Move tt,
+                             MovePicker::Mode mode, int skip_after) {
+    MovePicker picker(board, worker, ss, tt, mode);
+    std::vector<Pick> out;
+    for (int i = 0; i < 600; ++i) {
+        const Move move = picker.next(skip_after >= 0 && i >= skip_after);
+        if (move.is_none()) return out;
+        out.push_back({move, picker.last_move_see_nonnegative()});
+    }
+    throw std::runtime_error("move picker did not terminate");
+}
+
+void compare(const std::vector<Pick>& actual, const std::vector<Stage>& stages, const std::string& label) {
+    std::size_t at = 0;
+    for (const Stage& stage : stages) {
+        if (stage.moves.empty()) continue;
+        const std::string where = label + " stage " + stage.name;
+        if (at + stage.moves.size() > actual.size()) {
+            check(false, where + ": picker returned too few moves");
+            return;
+        }
+        std::vector<std::uint32_t> got;
+        std::vector<std::uint32_t> want;
+        for (std::size_t i = 0; i < stage.moves.size(); ++i) {
+            const Pick& pick = actual[at + i];
+            got.push_back(key(pick.move));
+            want.push_back(key(stage.moves[i]));
+            check(pick.see_nonnegative == stage.see_nonnegative, where + ": see flag of " + name_of(pick.move));
+        }
+        if (stage.scored) {
+            for (std::size_t i = 1; i < stage.moves.size(); ++i) {
+                const auto prev = stage.scores.find(got[i - 1]);
+                const auto curr = stage.scores.find(got[i]);
+                if (prev != stage.scores.end() && curr != stage.scores.end()) {
+                    check(prev->second >= curr->second, where + ": scores non-increasing at " + std::to_string(i));
+                }
+            }
+            std::sort(got.begin(), got.end());
+            std::sort(want.begin(), want.end());
+        }
+        check(got == want, where + ": move set/order");
+        at += stage.moves.size();
+    }
+    check(at == actual.size(), label + ": no extra moves (" + std::to_string(actual.size()) + " vs " + std::to_string(at) + ")");
+}
+
+std::vector<Stage> expected_main(const Board& board, const HistoryTables& h, const SearchStack* ss, Move tt,
+                                 bool skip_quiets) {
+    if (!tt.is_none() && !board.is_pseudo_legal(tt)) tt = Move::none();
+    Stage tt_stage{"tt", false, false, {}, {}};
+    if (!tt.is_none()) tt_stage.moves.push_back(tt);
+
+    std::vector<std::pair<int, Move>> captures;
+    for (const Move move : generate(board, true)) {
+        if (move == tt) continue;
+        captures.emplace_back(capture_score(board, h, move), move);
+    }
+    std::stable_sort(captures.begin(), captures.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+    Stage good{"good-captures", true, true, {}, {}};
+    Stage bad{"bad-captures", true, false, {}, {}};
+    for (const auto& [score, move] : captures) {
+        Stage& target = board.see_ge(move, 0) ? good : bad;
+        target.moves.push_back(move);
+        target.scores[key(move)] = score;
+    }
+
+    const std::array<Move, 2> killers = ss->killers;
+    Move counter = Move::none();
+    const SearchStack* previous = ss - 1;
+    if (!previous->current_move.is_none() && previous->moved_piece != Empty) {
+        counter = (*h.counter_moves)[static_cast<std::size_t>(previous->moved_piece)][previous->current_move.to];
+    }
+    auto valid_quiet = [&](Move move) {
+        return !move.is_none() && move != tt && !move.is_capture() && !move.is_promotion() && board.is_pseudo_legal(move);
+    };
+    Stage specials{"killers-counter", false, false, {}, {}};
+    Stage quiets{"quiets", true, false, {}, {}};
+    if (!skip_quiets) {
+        if (valid_quiet(killers[0])) specials.moves.push_back(killers[0]);
+        if (valid_quiet(killers[1]) && killers[1] != killers[0]) specials.moves.push_back(killers[1]);
+        if (valid_quiet(counter) && counter != killers[0] && counter != killers[1]) specials.moves.push_back(counter);
+        for (const Move move : generate(board, false)) {
+            if (move.is_capture() || move.is_promotion()) continue;
+            if (move == tt || move == killers[0] || move == killers[1] || move == counter) continue;
+            quiets.moves.push_back(move);
+            quiets.scores[key(move)] = quiet_score(board, h, ss, move);
+        }
+    }
+    return {tt_stage, good, specials, quiets, bad};
+}
+
+std::vector<Stage> expected_qsearch(const Board& board, const HistoryTables& h, Move tt) {
+    if (!tt.is_none() && !board.is_pseudo_legal(tt)) tt = Move::none();
+    if (!tt.is_none() && !tt.is_capture() && !tt.is_promotion()) tt = Move::none();
+    Stage tt_stage{"qs-tt", false, false, {}, {}};
+    if (!tt.is_none()) tt_stage.moves.push_back(tt);
+    Stage captures{"qs-captures", true, false, {}, {}};
+    for (const Move move : generate(board, true)) {
+        if (move == tt) continue;
+        captures.moves.push_back(move);
+        captures.scores[key(move)] = capture_score(board, h, move);
+    }
+    return {tt_stage, captures};
+}
+
+std::vector<Stage> expected_evasions(const Board& board, const HistoryTables& h, const SearchStack* ss, Move tt) {
+    if (!tt.is_none() && !board.is_pseudo_legal(tt)) tt = Move::none();
+    Stage tt_stage{"evasion-tt", false, false, {}, {}};
+    if (!tt.is_none()) tt_stage.moves.push_back(tt);
+    Stage moves{"evasions", true, false, {}, {}};
+    for (const Move move : generate(board, false)) {
+        if (move == tt) continue;
+        moves.moves.push_back(move);
+        moves.scores[key(move)] = evasion_score(board, h, ss, move);
+    }
+    return {tt_stage, moves};
+}
+
+Move random_move(Rng& rng, const std::vector<Move>& pool) {
+    const int pick = rng.range(0, 9);
+    if (pick == 0 || pool.empty()) {
+        // Garbage that is (almost always) not pseudo-legal here.
+        Move move{};
+        move.from = static_cast<std::uint8_t>(rng.range(0, 63));
+        move.to = static_cast<std::uint8_t>(rng.range(0, 63));
+        move.flags = static_cast<std::uint8_t>(rng.range(0, 1));
+        return move;
+    }
+    if (pick == 1) return Move::none();
+    return pool[static_cast<std::size_t>(rng.range(0, static_cast<int>(pool.size()) - 1))];
+}
+
+void randomize(Rng& rng, HistoryTables& h, bool zero) {
+    h.clear();
+    if (zero) return;
+    for (auto& side : *h.main_history)
+        for (auto& from : side)
+            for (auto& entry : from) entry = static_cast<std::int16_t>(rng.range(-HistoryMax, HistoryMax));
+    for (auto& piece : *h.capture_history)
+        for (auto& to : piece)
+            for (auto& entry : to) entry = static_cast<std::int16_t>(rng.range(-HistoryMax, HistoryMax));
+}
+
+void randomize_continuation(Rng& rng, PieceToHistory& table) {
+    for (auto& piece : table)
+        for (auto& entry : piece) entry = static_cast<std::int16_t>(rng.range(-HistoryMax, HistoryMax));
+}
+
+} // namespace
+
+int main() {
+    const std::vector<std::string> fens{
+        std::string(Board::StandardStartFen),
+        "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
+        "r4rk1/1pp1qppp/p1np1n2/8/2B1P1b1/2N2N2/PPP1QPPP/2KR3R w - - 0 10",
+        "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",
+        "2rr3k/pp3pp1/1nnqbN1p/3pN3/2pP4/2P3Q1/PPB4P/R4RK1 w - - 0 1",
+        "n1n5/PPPk4/8/8/8/8/4Kppp/5N1N b - - 0 1",
+        "n1n5/PPPk4/8/8/8/8/4Kppp/5N1N w - - 0 1",
+        "rnbqkbnr/ppp1p1pp/8/3pPp2/8/8/PPPP1PPP/RNBQKBNR w KQkq f6 0 3",
+        "rnbqkbnr/ppp2ppp/8/1B1pp3/4P3/8/PPPP1PPP/RNBQK1NR b KQkq - 1 3",
+        "4k3/8/8/8/8/8/4r3/4K3 w - - 0 1",
+        "r1bq1rk1/pp2bppp/2n1pn2/3p4/2PP4/2N1PN2/PP3PPP/R2QKB1R w KQ - 0 8",
+        "r2q1rk1/ppp2ppp/2n1bn2/2bpp3/3PP3/2N1BN2/PPP1BPPP/R2Q1RK1 w - - 0 9",
+    };
+    SharedSearchState shared(1);
+    auto worker = std::make_unique<Worker>(shared, 0);
+    const Worker& w = *worker;
+    HistoryTables& h = SearcherTestProbe::histories(*worker);
+    std::array<SearchStack, 8> stack{};
+    SearchStack* ss = &stack[4];
+    Rng rng{0x9E3779B97F4A7C15ULL};
+    int evasion_positions = 0;
+    int main_runs = 0;
+    int qs_runs = 0;
+    int evasion_runs = 0;
+
+    for (const std::string& fen : fens) {
+        const Board board = position(fen);
+        const std::vector<Move> all = generate(board, false);
+        const std::vector<Move> captures = generate(board, true);
+        std::vector<Move> pool = all;
+        pool.insert(pool.end(), captures.begin(), captures.end());
+        if (board.in_check()) ++evasion_positions;
+        for (int trial = 0; trial < 60; ++trial) {
+            const std::string label = fen + " trial " + std::to_string(trial);
+            randomize(rng, h, trial % 4 == 0);
+            for (SearchStack& entry : stack) entry = SearchStack{};
+            // Continuation tables of the two previous plies (sometimes absent).
+            if (trial % 3 != 0) {
+                ss[-1].continuation = &(*h.continuation_history)[WN][static_cast<std::size_t>(rng.range(0, 63))];
+                ss[-2].continuation = &(*h.continuation_history)[BQ][static_cast<std::size_t>(rng.range(0, 63))];
+                randomize_continuation(rng, *ss[-1].continuation);
+                randomize_continuation(rng, *ss[-2].continuation);
+            }
+            ss->killers = {random_move(rng, pool), random_move(rng, pool)};
+            if (trial % 5 == 1) ss->killers[1] = ss->killers[0];
+            // Previous move for the counter-move slot, and a counter move in it.
+            if (trial % 2 == 0) {
+                ss[-1].current_move = random_move(rng, pool);
+                ss[-1].moved_piece = static_cast<Piece>(rng.range(1, 12));
+                if (!ss[-1].current_move.is_none()) {
+                    (*h.counter_moves)[static_cast<std::size_t>(ss[-1].moved_piece)][ss[-1].current_move.to] = random_move(rng, pool);
+                }
+            }
+            const Move tt = trial % 7 == 3 ? Move::none() : random_move(rng, pool);
+
+            if (board.in_check()) {
+                compare(run_picker(board, w, ss, tt, MovePicker::Mode::Main, -1), expected_evasions(board, h, ss, tt),
+                        label + " evasions/main");
+                compare(run_picker(board, w, ss, tt, MovePicker::Mode::Quiescence, -1), expected_evasions(board, h, ss, tt),
+                        label + " evasions/qs");
+                evasion_runs += 2;
+                continue;
+            }
+            compare(run_picker(board, w, ss, tt, MovePicker::Mode::Main, -1), expected_main(board, h, ss, tt, false),
+                    label + " main");
+            compare(run_picker(board, w, ss, tt, MovePicker::Mode::Main, 0), expected_main(board, h, ss, tt, true),
+                    label + " main skip_quiets");
+            compare(run_picker(board, w, ss, tt, MovePicker::Mode::Quiescence, -1), expected_qsearch(board, h, tt),
+                    label + " qsearch");
+            main_runs += 2;
+            ++qs_runs;
+        }
+    }
+
+    // A quiet TT move is dropped in quiescence; a non pseudo-legal TT move is dropped everywhere.
+    {
+        Board board = position(std::string(Board::StandardStartFen));
+        for (SearchStack& entry : stack) entry = SearchStack{};
+        h.clear();
+        const Move quiet = *board.parse_uci("g1f3");
+        MovePicker qs(board, w, ss, quiet, MovePicker::Mode::Quiescence);
+        check(qs.next(false).is_none(), "quiet TT move is not searched in quiescence at the start position");
+        Move bogus{};
+        bogus.from = 0;  // a1 rook to a5 through its own pawn
+        bogus.to = 32;
+        MovePicker main(board, w, ss, bogus, MovePicker::Mode::Main);
+        bool returned = false;
+        for (Move move; !(move = main.next(false)).is_none();) returned |= move == bogus;
+        check(!returned, "non pseudo-legal TT move is never returned");
+    }
+    // Mid-stage skip: quiets generated, then skipped -> only bad captures remain.
+    {
+        const Board board = position("r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1");
+        for (SearchStack& entry : stack) entry = SearchStack{};
+        randomize(rng, h, false);
+        const std::vector<Stage> stages = expected_main(board, h, ss, Move::none(), false);
+        const std::size_t first_quiet = stages[0].moves.size() + stages[1].moves.size() + stages[2].moves.size() + 1;
+        const std::vector<Pick> picks = run_picker(board, w, ss, Move::none(), MovePicker::Mode::Main,
+                                                   static_cast<int>(first_quiet));
+        check(picks.size() == first_quiet + stages[4].moves.size(), "skip during quiet stage jumps to bad captures");
+    }
+
+    check(evasion_positions >= 2, "fixture set contains evasion positions");
+    std::cout << "movepicker contract: positions=" << fens.size() << " main_runs=" << main_runs << " qs_runs=" << qs_runs
+              << " evasion_runs=" << evasion_runs << " checks=" << checks << " failures=" << failures << '\n';
+    std::cout << (failures == 0 ? "PASS" : "FAIL") << " movepicker_tests\n";
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tests/timeman_tests.cpp b/tests/timeman_tests.cpp
new file mode 100644
index 00000000..f223c9e1
--- /dev/null
+++ b/tests/timeman_tests.cpp
@@ -0,0 +1,163 @@
+// Time management (src/search/timeman.hpp) against the AL1 s198 formulas:
+// budget allocation for movetime / sudden death / increment / movestogo and
+// the iteration-level soft-limit factor (stability -> effort -> falling eval -> floor).
+#include "forge/search.hpp"
+#include "search/timeman.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <iostream>
+#include <string>
+#include <vector>
+
+using namespace forge;
+
+namespace {
+
+int failures = 0;
+int checks = 0;
+
+void check(bool okay, const std::string& name) {
+    ++checks;
+    if (!okay) {
+        ++failures;
+        if (failures <= 50) std::cout << "FAIL " << name << '\n';
+    }
+}
+
+struct Budget {
+    std::int64_t soft_ms = 0;
+    std::int64_t hard_ms = 0;
+    bool managed = false;
+};
+
+Budget allocated(const SearchLimits& limits) {
+    Budget b;
+    b.soft_ms = b.hard_ms = -7; // must be overwritten
+    b.managed = true;
+    timeman::allocate(limits, b.soft_ms, b.hard_ms, b.managed);
+    return b;
+}
+
+Budget reference_budget(const SearchLimits& limits) {
+    Budget b;
+    const std::int64_t overhead = std::max<std::int64_t>(0, limits.move_overhead_ms);
+    if (limits.infinite) return b;
+    if (limits.movetime_ms >= 0) {
+        b.hard_ms = std::max<std::int64_t>(1, limits.movetime_ms - overhead);
+        b.soft_ms = b.hard_ms;
+        return b;
+    }
+    if (limits.time_ms < 0) return b;
+    const std::int64_t increment = std::max<std::int64_t>(0, limits.increment_ms);
+    const std::int64_t available = std::max<std::int64_t>(1, limits.time_ms - overhead);
+    std::int64_t soft, hard;
+    if (limits.moves_to_go > 0) {
+        const std::int64_t mtg = std::min<std::int64_t>(limits.moves_to_go, 50);
+        soft = available / (mtg + 1) + increment * 3 / 4;
+        hard = std::min(available * 4 / 5, soft * 4);
+    } else {
+        soft = available / 22 + increment * 75 / 100;
+        hard = std::min(available * 60 / 100, soft * 5);
+    }
+    b.soft_ms = std::max<std::int64_t>(1, std::min(soft, available));
+    b.hard_ms = std::max<std::int64_t>(1, std::min(hard, available));
+    b.managed = true;
+    return b;
+}
+
+// The driver's composition of the time-module pieces (src/search/iterative.inc).
+double driver_factor(int stable, int depth, std::uint64_t nodes, bool tracked, std::uint64_t best_nodes, int previous,
+                     int score) {
+    double factor = timeman::stability_factor(stable, depth);
+    if (nodes > 0 && depth >= 6 && tracked) {
+        factor *= timeman::effort_scale(static_cast<double>(best_nodes) / static_cast<double>(nodes));
+    }
+    if (timeman::eval_fell(previous, score)) factor *= timeman::falling_eval_scale(previous, score);
+    return timeman::factor_floor(factor);
+}
+
+double reference_factor(int stable, int depth, std::uint64_t nodes, bool tracked, std::uint64_t best_nodes, int previous,
+                        int score) {
+    double factor = 1.0;
+    if (stable >= 6) factor = 0.60;
+    else if (stable >= 3) factor = 0.80;
+    else if (stable == 0 && depth >= 6) factor = 1.40;
+    if (nodes > 0 && depth >= 6 && tracked) {
+        const double effort = static_cast<double>(best_nodes) / static_cast<double>(nodes);
+        factor *= std::clamp(1.55 - effort, 0.6, 1.4);
+    }
+    if (previous != ValueNone && !is_mate_score(score) && score < previous) {
+        factor *= 1.0 + std::min(previous - score, 150) / 100.0;
+    }
+    return std::max(factor, 0.45);
+}
+
+} // namespace
+
+int main() {
+    const std::vector<int> times{-1, 0, 1, 9, 10, 11, 50, 999, 1000, 10000, 60000, 3600000};
+    const std::vector<int> increments{0, 100, 1000, 5000};
+    const std::vector<int> mtgs{0, 1, 2, 40, 50, 80};
+    const std::vector<int> overheads{0, 10, 1000};
+    int cases = 0;
+    for (const int time : times)
+        for (const int inc : increments)
+            for (const int mtg : mtgs)
+                for (const int overhead : overheads) {
+                    SearchLimits limits;
+                    limits.time_ms = time;
+                    limits.increment_ms = inc;
+                    limits.moves_to_go = mtg;
+                    limits.move_overhead_ms = overhead;
+                    const Budget got = allocated(limits);
+                    const Budget want = reference_budget(limits);
+                    ++cases;
+                    check(got.soft_ms == want.soft_ms && got.hard_ms == want.hard_ms && got.managed == want.managed,
+                          "clock budget time=" + std::to_string(time) + " inc=" + std::to_string(inc) +
+                              " mtg=" + std::to_string(mtg) + " overhead=" + std::to_string(overhead));
+                    if (want.managed) check(got.hard_ms >= 1 && got.soft_ms >= 1, "budgets are at least 1 ms");
+                }
+    for (const int movetime : {0, 1, 5, 10, 11, 100, 1000}) {
+        for (const int overhead : {0, 10, 1000}) {
+            SearchLimits limits;
+            limits.movetime_ms = movetime;
+            limits.time_ms = 5000; // movetime takes precedence over the clock
+            limits.move_overhead_ms = overhead;
+            const Budget got = allocated(limits);
+            const Budget want = reference_budget(limits);
+            ++cases;
+            check(got.soft_ms == want.soft_ms && got.hard_ms == want.hard_ms && !got.managed,
+                  "movetime budget " + std::to_string(movetime) + " overhead " + std::to_string(overhead));
+        }
+    }
+    {
+        SearchLimits limits;
+        limits.infinite = true;
+        limits.time_ms = 1000;
+        const Budget got = allocated(limits);
+        check(got.soft_ms == 0 && got.hard_ms == 0 && !got.managed, "infinite search has no budget");
+        SearchLimits depth_only;
+        depth_only.depth = 12;
+        const Budget none = allocated(depth_only);
+        check(none.soft_ms == 0 && none.hard_ms == 0 && !none.managed, "depth search has no budget");
+    }
+
+    int factor_cases = 0;
+    for (const int stable : {0, 1, 2, 3, 5, 6, 9})
+        for (const int depth : {1, 5, 6, 12})
+            for (const std::uint64_t nodes : {std::uint64_t{0}, std::uint64_t{1000}, std::uint64_t{123457}})
+                for (const bool tracked : {false, true})
+                    for (const std::uint64_t best : {std::uint64_t{0}, std::uint64_t{500}, std::uint64_t{999}})
+                        for (const int previous : {ValueNone, -50, 0, 120, 400})
+                            for (const int score : {-31990, -200, 0, 30, 119, 400}) {
+                                const double got = driver_factor(stable, depth, nodes, tracked, best, previous, score);
+                                const double want = reference_factor(stable, depth, nodes, tracked, best, previous, score);
+                                ++factor_cases;
+                                check(got == want, "soft factor stable=" + std::to_string(stable) + " depth=" + std::to_string(depth));
+                            }
+    std::cout << "time management: budget cases=" << cases << " factor cases=" << factor_cases << " checks=" << checks
+              << " failures=" << failures << '\n';
+    std::cout << (failures == 0 ? "PASS" : "FAIL") << " timeman_tests\n";
+    return failures == 0 ? 0 : 1;
+}
