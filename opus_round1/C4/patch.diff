+    options::nnue_king_buckets = 4;
+    active = options::apply_nnue_v2(&message);
+    report(active && options::nnue_v2 && v2::active() == v2::loaded(), "NNUEKingBuckets 4: selected (" + message + ")");
+    nnue::enabled = false;
