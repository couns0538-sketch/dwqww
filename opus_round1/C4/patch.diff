+    std::uint64_t node_limit_ = 0;
+    bool node_limit_specified_ = false;
+    std::int64_t soft_limit_ms_ = 0;
+    std::int64_t hard_limit_ms_ = 0;
+    bool time_managed_ = false;
+    bool aborted_ = false;
+    int seldepth_ = 0;
+    int root_depth_ = 0;
+    std::size_t root_history_index_ = 0;
+    std::vector<Move> root_moves_;
