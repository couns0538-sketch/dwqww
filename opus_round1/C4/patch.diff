+// ---------------------------------------------------------------- 5. incremental == refresh, 100k plies
+struct WalkStats {
+    long plies = 0, nulls = 0, evals = 0, verified = 0, key_changes = 0, restarts = 0, max_chain = 0;
+};
+
+void walk(Worker& w, const v2::Net& net, std::uint64_t seed, long target_plies, WalkStats& st, int& bad) {
+    Rng rng{seed};
+    constexpr int MaxDepth = 24;
+    while (st.plies < target_plies) {
+        Board board = position(start_fens[static_cast<std::size_t>(rng.below(static_cast<int>(start_fens.size())))]);
+        ++st.restarts;
+        w.clear();
+        SearchLimits limits;
+        limits.depth = 1;
+        const std::vector<Worker*> all{&w};
+        (void)w.search(board, limits, false, all);   // sets up the stack as a real search does
+        SearchStack* root = Probe::root(w);
+        std::vector<Board> path{board};
+        struct Step { bool null; Move move; Undo undo; NullUndo null_undo; };
+        std::vector<Step> steps;
+        int depth = 0;
+        const int length = 200 + rng.below(400);
+        for (int t = 0; t < length && st.plies < target_plies; ++t) {
+            SearchStack* ss = root + depth;
+            const bool can_push = depth < MaxDepth;
+            if (can_push && (depth == 0 || rng.chance(58))) {
+                const MoveList moves = board.legal_moves();
+                if (moves.empty()) continue;
+                Step step{};
+                if (!board.in_check() && rng.chance(4)) {
+                    step.null = true;
+                    Probe::null(w, ss);
+                    board.make_null_move(step.null_undo);
+                    ++st.nulls;
+                } else {
+                    step.null = false;
+                    step.move = moves[static_cast<std::size_t>(rng.below(static_cast<int>(moves.size())))];
+                    const Piece moved = board.piece_at(step.move.from);
+                    if (piece_type(moved) == King) {
+                        const Color c = color_of(moved);
+                        if (!(v2::king_key(net, c, step.move.from) == v2::king_key(net, c, step.move.to))) ++st.key_changes;
+                    }
+                    Probe::move(w, ss, board, step.move);
+                    (void)board.make_move(step.move, step.undo);
+                }
+                steps.push_back(step);
+                path.push_back(board);
+                ++depth;
+                ++st.plies;
+                if (rng.chance(45)) {
+                    // Evaluate; then check every accumulator this evaluation computed.
+                    std::vector<bool> was_valid(static_cast<std::size_t>(depth + 1));
+                    for (int j = 0; j <= depth; ++j) was_valid[static_cast<std::size_t>(j)] = (root + j)->accumulator.valid;
+                    const int actual = Probe::eval(w, board, root + depth);
+                    ++st.evals;
+                    long chain = 0;
+                    for (int j = 0; j <= depth; ++j) {
+                        SearchStack* e = root + j;
+                        if (!e->accumulator.valid || was_valid[static_cast<std::size_t>(j)]) continue;
+                        ++chain;
+                        ++st.verified;
+                        if (!same_values(e->accumulator, reference(net, path[static_cast<std::size_t>(j)]))) ++bad;
+                    }
+                    st.max_chain = std::max(st.max_chain, chain);
+                    const nnue::Accumulator ref = reference(net, board);
+                    const int expected = std::clamp(Evaluator::evaluate_uncached(board) + v2::evaluate(net, board, ref),
+                                                    -MateInMaxPly + 1, MateInMaxPly - 1);
+                    if (actual != expected || !(root + depth)->accumulator.valid) ++bad;
+                }
+            } else if (depth > 0) {
+                const Step& step = steps.back();
+                if (step.null) board.unmake_null_move(step.null_undo);
+                else board.unmake_move(step.move, step.undo);
+                steps.pop_back();
+                path.pop_back();
+                --depth;
+                if (rng.chance(30)) {   // re-evaluate an ancestor after unmake (cached accumulator reuse)
+                    const int actual = Probe::eval(w, board, root + depth);
+                    const nnue::Accumulator ref = reference(net, board);
+                    const int expected = std::clamp(Evaluator::evaluate_uncached(board) + v2::evaluate(net, board, ref),
+                                                    -MateInMaxPly + 1, MateInMaxPly - 1);
+                    ++st.evals;
+                    if (actual != expected || !same_values((root + depth)->accumulator, ref)) ++bad;
+                }
+            }
+        }
+    }
+}
+
+void test_incremental_equals_refresh(const std::string& dir, long plies_per_net) {
+    SharedSearchState shared(1);
+    auto worker = std::make_unique<Worker>(shared, 0);
+    struct Case { const char* name; int buckets; bool mirror; std::array<std::uint8_t, 64> map; };
+    std::array<std::uint8_t, 64> every{};
+    for (int s = 0; s < 64; ++s) every[static_cast<std::size_t>(s)] = static_cast<std::uint8_t>(half_index(s));
+    const std::vector<Case> cases = {
+        {"8 mirrored buckets (standard layout)", 8, true, symmetric_map(8)},
+        {"32 mirrored buckets (one per half-board square)", 32, true, every},
+        {"4 unmirrored buckets", 4, false, symmetric_map(4)},
+    };
+    long total = 0;
+    std::uint64_t seed = 71;
+    for (const Case& c : cases) {
+        check(load_spec(dir + "walk.fnn2", random_net(c.buckets, c.mirror, c.map, seed)), std::string("load ") + c.name);
+        options::nnue_king_buckets = c.buckets;
+        check(options::apply_nnue_v2(nullptr), std::string("select ") + c.name);
+        WalkStats st;
+        int bad = 0;
+        walk(*worker, *v2::active(), seed * 7919U, plies_per_net, st, bad);
+        total += st.plies;
+        std::cout << "WALK " << c.name << ": plies " << st.plies << " (null " << st.nulls << ") evaluations " << st.evals
+                  << " computed accumulators verified " << st.verified << " king-key changes " << st.key_changes
+                  << " longest replay " << st.max_chain << " restarts " << st.restarts << " mismatches " << bad << '\n';
+        report(bad == 0 && st.key_changes * 50 > st.plies && st.max_chain >= 3,
+               std::string("incremental == full refresh, bit-exact, ") + c.name + ": " + std::to_string(st.plies) + " plies");
+        ++seed;
+    }
+    std::cout << "WALK total plies " << total << '\n';
+    options::nnue_king_buckets = 0;
+    (void)options::apply_nnue_v2(nullptr);
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    // argv[1] (optional): plies per net for the walk test (default 34000, i.e. > 100k in total).
+    const long plies = argc > 1 ? std::stol(argv[1]) : 34000;
+    const std::string dir = "nnue_v2_test_";
+    test_bucket_map_and_mirroring(dir);
+    test_loader(dir);
+    test_selection(dir);
+    test_request_rule(dir);
+    test_lock_replicas(dir);
+    test_incremental_equals_refresh(dir, plies);
+    v2::unload();
+    for (const char* f : {"map", "mirror", "plain", "loader", "bad", "select", "rule", "replica", "walk"}) std::remove((dir + f + ".fnn2").c_str());
+    std::cout << checks - failures << "/" << checks << " checks passed\n";
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tests/nnue_v2_uci_tests.cpp b/tests/nnue_v2_uci_tests.cpp
new file mode 100644
index 00000000..42248c7f
--- /dev/null
+++ b/tests/nnue_v2_uci_tests.cpp
@@ -0,0 +1,255 @@
+// UCI-level tests of the fail-loud NNUE v2 rule (C4 review fix; rule in forge/search_options.hpp).
+// Runs the real engine (argv[1]) with scripted stdin and checks its output and exit status:
+//   - defaults: nothing NNUE-v2 related is printed, readyok, bestmove, exit 0;
+//   - a requested v2 net that cannot be used (missing file, truncated file, bad checksum, wrong king
+//     bucket count, NNUEKingBuckets without NNUEFile, NNUEFile with NNUEKingBuckets 0, a failed reload after
+//     a good net): `info string ERROR NNUE v2: <reason>` at once and again at the next isready / go / bench,
+//     then exit status 2 without readyok / bestmove / bench output;
+//   - a valid net: `info string NNUE v2: active: <file> king buckets N output buckets M hidden H ...` once
+//     when it becomes active and at every isready, then readyok and bestmove, exit 0;
+//   - UseNNUE false is not an error, NNUEFile <empty> clears the request, option order does not matter.
+// Writes its net files and engine transcripts into the working directory (removed at the end).
+// usage: forge_nnue_v2_uci_tests <forge executable>
+#include "forge/nnue.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#if !defined(_WIN32)
+#include <sys/wait.h>
+#endif
+
+namespace {
+
+int checks = 0;
+int failures = 0;
+void report(bool okay, const std::string& label) {
+    ++checks;
+    if (!okay) ++failures;
+    std::cout << (okay ? "PASS " : "FAIL ") << label << '\n';
+}
+
+const std::string Prefix = "nnue_v2_uci_";
+std::vector<std::string> temporary_files;
+
+void write_file(const std::string& path, const std::string& bytes) {
+    std::ofstream out(path, std::ios::binary);
+    out.write(bytes.data(), static_cast<std::streamsize>(bytes.size()));
+    temporary_files.push_back(path);
+}
+
+std::string read_file(const std::string& path) {
+    std::ifstream in(path, std::ios::binary);
+    std::ostringstream text;
+    text << in.rdbuf();
+    return text.str();
+}
+
+// ---- a v2 net file (format in forge/nnue_v2.hpp), small random weights
+void put32(std::string& s, std::uint32_t v) {
+    for (int i = 0; i < 4; ++i) s.push_back(static_cast<char>((v >> (8 * i)) & 0xFFU));
+}
+void putf(std::string& s, float f) {
+    std::uint32_t v = 0;
+    std::memcpy(&v, &f, 4);
+    put32(s, v);
+}
+void put16(std::string& s, std::int16_t v) {
+    const auto u = static_cast<std::uint16_t>(v);
+    s.push_back(static_cast<char>(u & 0xFFU));
+    s.push_back(static_cast<char>(u >> 8U));
+}
+std::uint64_t fnv(const std::string& data) {
+    std::uint64_t h = 0xcbf29ce484222325ULL;
+    for (const unsigned char c : data) {
+        h ^= c;
+        h *= 0x100000001b3ULL;
+    }
+    return h;
+}
+std::string net_file(int king_buckets, std::uint64_t seed) {
+    const int hidden = forge::nnue::HiddenSize;
+    std::string s = "FORGENN2";
+    put32(s, 2); put32(s, 160); put32(s, 0); put32(s, 768); put32(s, static_cast<std::uint32_t>(hidden));
+    put32(s, static_cast<std::uint32_t>(king_buckets)); put32(s, 1); put32(s, 1);   // 1 output bucket, residual
+    putf(s, 4096.0F); putf(s, 4096.0F); putf(s, 2.25F);
+    for (int square = 0; square < 64; ++square) s.push_back(static_cast<char>((square & 7) * king_buckets / 8));
+    s.append(160 - s.size(), '\0');
+    std::uint64_t x = seed;
+    auto value = [&x](int range) {
+        x ^= x >> 12U; x ^= x << 25U; x ^= x >> 27U;
+        return static_cast<std::int16_t>(static_cast<int>((x * 2685821657736338717ULL) % static_cast<std::uint64_t>(2 * range + 1)) - range);
+    };
+    for (long i = 0; i < static_cast<long>(king_buckets) * 768 * hidden; ++i) put16(s, value(60));
+    for (int i = 0; i < hidden; ++i) put16(s, value(400));
+    for (int i = 0; i < 2 * hidden; ++i) put16(s, value(300));
+    put16(s, value(100));
+    const std::uint64_t h = fnv(s);
+    for (int i = 0; i < 8; ++i) s.push_back(static_cast<char>((h >> (8 * i)) & 0xFFU));
+    return s;
+}
+
+// ---- running the engine
+struct Run {
+    std::string out;
+    int status = -1;
+};
+
+std::string quote(const std::string& text) { return "\"" + text + "\""; }
+
+Run run_engine(const std::string& engine, const std::string& name, const std::string& script) {
+    const std::string in = Prefix + name + ".in";
+    const std::string out = Prefix + name + ".out";
+    const std::string err = Prefix + name + ".err";
+    write_file(in, script);
+    temporary_files.push_back(out);
+    temporary_files.push_back(err);
+    std::string command = quote(engine) + " < " + quote(in) + " > " + quote(out) + " 2> " + quote(err);
+#if defined(_WIN32)
+    command = "\"" + command + "\"";   // cmd.exe /c strips one pair of outer quotes
+#endif
+    std::fflush(nullptr);
+    const int raw = std::system(command.c_str());
+    Run run;
+#if defined(_WIN32)
+    run.status = raw;
+#else
+    run.status = WIFEXITED(raw) ? WEXITSTATUS(raw) : 128 + (WIFSIGNALED(raw) ? WTERMSIG(raw) : 0);
+#endif
+    run.out = read_file(out);
+    const std::string errors = read_file(err);
+    if (!errors.empty()) std::cout << "  [" << name << " stderr] " << errors.substr(0, 400) << '\n';
+    return run;
+}
+
+int count(const std::string& text, const std::string& what) {
+    int n = 0;
+    for (std::size_t at = text.find(what); at != std::string::npos; at = text.find(what, at + what.size())) ++n;
+    return n;
+}
+bool has(const std::string& text, const std::string& what) { return text.find(what) != std::string::npos; }
+bool has_line(const std::string& text, const std::string& prefix) {
+    std::istringstream lines(text);
+    for (std::string line; std::getline(lines, line);) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        if (line.rfind(prefix, 0) == 0) return true;
+    }
+    return false;
+}
+// The last ERROR line of a transcript (the one printed at the trigger command), for the checks and the log.
+std::string errors_of(const std::string& text) {
+    std::istringstream lines(text);
+    std::string last = "(no ERROR line)";
+    for (std::string line; std::getline(lines, line);) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        if (line.rfind("info string ERROR NNUE v2:", 0) == 0) last = line;
+    }
+    return last;
+}
+
+const std::string Head = "uci\nsetoption name Threads value 1\nsetoption name Hash value 16\n";
+std::string set(const std::string& name, const std::string& value) { return "setoption name " + name + " value " + value + "\n"; }
+
+// A request that cannot be honoured: an ERROR at once and again at `trigger`, then exit status 2 without
+// the trigger's normal answer.
+void expect_failure(const std::string& engine, const std::string& name, const std::string& options,
+                    const std::string& trigger, const std::string& reason_phrase) {
+    const Run r = run_engine(engine, name, Head + options + trigger + "\nquit\n");
+    const int errors = count(r.out, "info string ERROR NNUE v2: ");
+    const bool no_answer = !has_line(r.out, "readyok") && !has_line(r.out, "bestmove") && !has(r.out, "bench depth");
+    report(r.status == 2 && errors >= 2 && no_answer && has(errors_of(r.out), reason_phrase),
+           name + ": exit status " + std::to_string(r.status) + " at " + trigger + ", " + std::to_string(errors) +
+               " ERROR lines, " + (no_answer ? "no answer" : "ANSWERED (readyok / bestmove / bench)") + ": " + errors_of(r.out));
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 2) {
+        std::cerr << "usage: forge_nnue_v2_uci_tests <forge executable>\n";
+        return 2;
+    }
+    std::string engine = argv[1];
+#if defined(_WIN32)
+    for (char& c : engine) if (c == '/') c = '\\';
+#endif
+    const std::string valid = Prefix + "valid.fnn2";       // 2 king buckets (files a-d / e-h), 1 output bucket
+    const std::string truncated = Prefix + "truncated.fnn2";
+    const std::string damaged = Prefix + "damaged.fnn2";
+    const std::string missing = Prefix + "missing.fnn2";   // never written
+    const std::string bytes = net_file(2, 20261027);
+    write_file(valid, bytes);
+    write_file(truncated, bytes.substr(0, bytes.size() - 2));
+    std::string flipped = bytes;
+    flipped[5000] = static_cast<char>(flipped[5000] ^ 0x10);
+    write_file(damaged, flipped);
+    const std::string active_line = "info string NNUE v2: active: " + valid + " king buckets 2 output buckets 1 hidden " +
+                                    std::to_string(forge::nnue::HiddenSize);
+
+    // Defaults: nothing new.
+    {
+        const Run r = run_engine(engine, "defaults", Head + "isready\ngo depth 1\nisready\nquit\n");
+        report(r.status == 0 && count(r.out, "readyok") == 2 && has_line(r.out, "bestmove") && !has(r.out, "NNUE v2") &&
+                   has(r.out, "option name NNUEFile type string default <empty>"),
+               "defaults: exit 0, readyok, bestmove, no NNUE v2 line");
+    }
+    // Requests that cannot be honoured.
+    expect_failure(engine, "missing_file_isready", set("NNUEFile", missing) + set("NNUEKingBuckets", "2"), "isready", "cannot open");
+    expect_failure(engine, "missing_file_go", set("NNUEFile", missing) + set("NNUEKingBuckets", "2"), "go depth 1", "cannot open");
+    expect_failure(engine, "missing_file_bench", set("NNUEFile", missing) + set("NNUEKingBuckets", "2"), "bench 2", "cannot open");
+    expect_failure(engine, "truncated_file", set("NNUEFile", truncated) + set("NNUEKingBuckets", "2"), "isready",
+                   "the weights were not read");
+    expect_failure(engine, "damaged_file", set("NNUEFile", damaged) + set("NNUEKingBuckets", "2"), "isready", "checksum mismatch");
+    expect_failure(engine, "wrong_bucket_count", set("NNUEFile", valid) + set("NNUEKingBuckets", "4"), "isready", "does not match");
+    expect_failure(engine, "buckets_without_file", set("NNUEKingBuckets", "2"), "go depth 1", "no v2 net is loaded");
+    expect_failure(engine, "file_with_buckets_0", set("NNUEFile", valid), "isready", "NNUEKingBuckets is 0");
+    expect_failure(engine, "failed_reload_after_good_net",
+                   set("NNUEFile", valid) + set("NNUEKingBuckets", "2") + set("NNUEFile", missing), "isready", "cannot open");
+    expect_failure(engine, "usennue_true_again", set("UseNNUE", "false") + set("NNUEFile", missing) + set("NNUEKingBuckets", "2") +
+                   set("UseNNUE", "true"), "isready", "cannot open");
+    // A valid net: active line once when it becomes active and at every isready.
+    {
+        const Run r = run_engine(engine, "valid_net", Head + set("NNUEFile", valid) + set("NNUEKingBuckets", "2") +
+                                                          "isready\ngo depth 1\nisready\nquit\n");
+        report(r.status == 0 && count(r.out, active_line) == 3 && count(r.out, "readyok") == 2 && has_line(r.out, "bestmove") &&
+                   has(r.out, "info string NNUE v2: loaded " + valid),
+               "valid net: exit 0, \"" + active_line + " ...\" printed 3 times (activation + 2 isready), readyok, bestmove");
+        report(count(r.out, "ERROR NNUE v2") == 1, "valid net: NNUEFile before NNUEKingBuckets reports the half-set request once (" +
+                                                        errors_of(r.out) + "), resolved by NNUEKingBuckets 2");
+    }
+    {
+        const Run r = run_engine(engine, "order_buckets_first", Head + set("NNUEKingBuckets", "2") + set("NNUEFile", valid) +
+                                                                   "isready\nquit\n");
+        report(r.status == 0 && count(r.out, active_line) == 2 && has_line(r.out, "readyok"),
+               "NNUEKingBuckets before NNUEFile: active, readyok, exit 0");
+    }
+    {
+        const Run r = run_engine(engine, "bench_active", Head + set("NNUEFile", valid) + set("NNUEKingBuckets", "2") + "bench 3\nquit\n");
+        report(r.status == 0 && has(r.out, "bench depth 3 nodes"), "valid net: bench runs, exit 0");
+    }
+    // Not errors.
+    {
+        const Run r = run_engine(engine, "usennue_false", Head + set("UseNNUE", "false") + set("NNUEKingBuckets", "2") +
+                                                             set("NNUEFile", missing) + "isready\ngo depth 1\nquit\n");
+        report(r.status == 0 && has_line(r.out, "readyok") && has_line(r.out, "bestmove") && !has(r.out, "ERROR") &&
+                   has(r.out, "UseNNUE is false"),
+               "UseNNUE false with a v2 request: not an error (exit 0, readyok, bestmove)");
+    }
+    {
+        const Run r = run_engine(engine, "cleared", Head + set("NNUEFile", valid) + set("NNUEKingBuckets", "2") +
+                                                       set("NNUEKingBuckets", "0") + set("NNUEFile", "<empty>") + "isready\ngo depth 1\nquit\n");
+        report(r.status == 0 && has_line(r.out, "readyok") && has_line(r.out, "bestmove") && has(r.out, "info string NNUE v2: off") &&
+                   count(r.out, active_line) == 1,
+               "NNUEKingBuckets 0 + NNUEFile <empty>: request cleared, compiled-in net, exit 0");
+    }
+    for (const std::string& file : temporary_files) std::remove(file.c_str());
+    std::cout << checks - failures << "/" << checks << " checks passed\n";
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tests/timeman_tests.cpp b/tests/timeman_tests.cpp
new file mode 100644
index 00000000..f223c9e1
--- /dev/null
+++ b/tests/timeman_tests.cpp
@@ -0,0 +1,163 @@
+// Time management (src/search/timeman.hpp) against the AL1 s198 formulas:
+// budget allocation for movetime / sudden death / increment / movestogo and
+// the iteration-level soft-limit factor (stability -> effort -> falling eval -> floor).
+#include "forge/search.hpp"
+#include "search/timeman.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <iostream>
+#include <string>
+#include <vector>
+
+using namespace forge;
+
+namespace {
+
+int failures = 0;
+int checks = 0;
+
+void check(bool okay, const std::string& name) {
+    ++checks;
+    if (!okay) {
+        ++failures;
+        if (failures <= 50) std::cout << "FAIL " << name << '\n';
+    }
+}
+
+struct Budget {
+    std::int64_t soft_ms = 0;
+    std::int64_t hard_ms = 0;
+    bool managed = false;
+};
+
+Budget allocated(const SearchLimits& limits) {
+    Budget b;
+    b.soft_ms = b.hard_ms = -7; // must be overwritten
+    b.managed = true;
+    timeman::allocate(limits, b.soft_ms, b.hard_ms, b.managed);
+    return b;
+}
+
+Budget reference_budget(const SearchLimits& limits) {
+    Budget b;
+    const std::int64_t overhead = std::max<std::int64_t>(0, limits.move_overhead_ms);
+    if (limits.infinite) return b;
+    if (limits.movetime_ms >= 0) {
+        b.hard_ms = std::max<std::int64_t>(1, limits.movetime_ms - overhead);
+        b.soft_ms = b.hard_ms;
+        return b;
+    }
+    if (limits.time_ms < 0) return b;
+    const std::int64_t increment = std::max<std::int64_t>(0, limits.increment_ms);
+    const std::int64_t available = std::max<std::int64_t>(1, limits.time_ms - overhead);
+    std::int64_t soft, hard;
+    if (limits.moves_to_go > 0) {
+        const std::int64_t mtg = std::min<std::int64_t>(limits.moves_to_go, 50);
+        soft = available / (mtg + 1) + increment * 3 / 4;
+        hard = std::min(available * 4 / 5, soft * 4);
+    } else {
+        soft = available / 22 + increment * 75 / 100;
+        hard = std::min(available * 60 / 100, soft * 5);
+    }
+    b.soft_ms = std::max<std::int64_t>(1, std::min(soft, available));
+    b.hard_ms = std::max<std::int64_t>(1, std::min(hard, available));
+    b.managed = true;
+    return b;
+}
+
+// The driver's composition of the time-module pieces (src/search/iterative.inc).
+double driver_factor(int stable, int depth, std::uint64_t nodes, bool tracked, std::uint64_t best_nodes, int previous,
+                     int score) {
+    double factor = timeman::stability_factor(stable, depth);
+    if (nodes > 0 && depth >= 6 && tracked) {
+        factor *= timeman::effort_scale(static_cast<double>(best_nodes) / static_cast<double>(nodes));
+    }
+    if (timeman::eval_fell(previous, score)) factor *= timeman::falling_eval_scale(previous, score);
+    return timeman::factor_floor(factor);
+}
+
+double reference_factor(int stable, int depth, std::uint64_t nodes, bool tracked, std::uint64_t best_nodes, int previous,
+                        int score) {
+    double factor = 1.0;
+    if (stable >= 6) factor = 0.60;
+    else if (stable >= 3) factor = 0.80;
+    else if (stable == 0 && depth >= 6) factor = 1.40;
+    if (nodes > 0 && depth >= 6 && tracked) {
+        const double effort = static_cast<double>(best_nodes) / static_cast<double>(nodes);
+        factor *= std::clamp(1.55 - effort, 0.6, 1.4);
+    }
+    if (previous != ValueNone && !is_mate_score(score) && score < previous) {
+        factor *= 1.0 + std::min(previous - score, 150) / 100.0;
+    }
+    return std::max(factor, 0.45);
+}
+
+} // namespace
+
+int main() {
+    const std::vector<int> times{-1, 0, 1, 9, 10, 11, 50, 999, 1000, 10000, 60000, 3600000};
+    const std::vector<int> increments{0, 100, 1000, 5000};
+    const std::vector<int> mtgs{0, 1, 2, 40, 50, 80};
+    const std::vector<int> overheads{0, 10, 1000};
+    int cases = 0;
+    for (const int time : times)
+        for (const int inc : increments)
+            for (const int mtg : mtgs)
+                for (const int overhead : overheads) {
+                    SearchLimits limits;
+                    limits.time_ms = time;
+                    limits.increment_ms = inc;
+                    limits.moves_to_go = mtg;
+                    limits.move_overhead_ms = overhead;
+                    const Budget got = allocated(limits);
+                    const Budget want = reference_budget(limits);
+                    ++cases;
+                    check(got.soft_ms == want.soft_ms && got.hard_ms == want.hard_ms && got.managed == want.managed,
+                          "clock budget time=" + std::to_string(time) + " inc=" + std::to_string(inc) +
+                              " mtg=" + std::to_string(mtg) + " overhead=" + std::to_string(overhead));
+                    if (want.managed) check(got.hard_ms >= 1 && got.soft_ms >= 1, "budgets are at least 1 ms");
+                }
+    for (const int movetime : {0, 1, 5, 10, 11, 100, 1000}) {
+        for (const int overhead : {0, 10, 1000}) {
+            SearchLimits limits;
+            limits.movetime_ms = movetime;
+            limits.time_ms = 5000; // movetime takes precedence over the clock
+            limits.move_overhead_ms = overhead;
+            const Budget got = allocated(limits);
+            const Budget want = reference_budget(limits);
+            ++cases;
+            check(got.soft_ms == want.soft_ms && got.hard_ms == want.hard_ms && !got.managed,
+                  "movetime budget " + std::to_string(movetime) + " overhead " + std::to_string(overhead));
+        }
+    }
+    {
+        SearchLimits limits;
+        limits.infinite = true;
+        limits.time_ms = 1000;
+        const Budget got = allocated(limits);
+        check(got.soft_ms == 0 && got.hard_ms == 0 && !got.managed, "infinite search has no budget");
+        SearchLimits depth_only;
+        depth_only.depth = 12;
+        const Budget none = allocated(depth_only);
+        check(none.soft_ms == 0 && none.hard_ms == 0 && !none.managed, "depth search has no budget");
+    }
+
+    int factor_cases = 0;
+    for (const int stable : {0, 1, 2, 3, 5, 6, 9})
+        for (const int depth : {1, 5, 6, 12})
+            for (const std::uint64_t nodes : {std::uint64_t{0}, std::uint64_t{1000}, std::uint64_t{123457}})
+                for (const bool tracked : {false, true})
+                    for (const std::uint64_t best : {std::uint64_t{0}, std::uint64_t{500}, std::uint64_t{999}})
+                        for (const int previous : {ValueNone, -50, 0, 120, 400})
+                            for (const int score : {-31990, -200, 0, 30, 119, 400}) {
+                                const double got = driver_factor(stable, depth, nodes, tracked, best, previous, score);
+                                const double want = reference_factor(stable, depth, nodes, tracked, best, previous, score);
+                                ++factor_cases;
+                                check(got == want, "soft factor stable=" + std::to_string(stable) + " depth=" + std::to_string(depth));
+                            }
+    std::cout << "time management: budget cases=" << cases << " factor cases=" << factor_cases << " checks=" << checks
+              << " failures=" << failures << '\n';
+    std::cout << (failures == 0 ? "PASS" : "FAIL") << " timeman_tests\n";
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tools/nnue/bench_options.py b/tools/nnue/bench_options.py
new file mode 100644
index 00000000..ccbad65f
--- /dev/null
+++ b/tools/nnue/bench_options.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Run the engine's `bench <depth>` (Threads 1, Hash 16, OwnBook false) after extra setoption commands and
+print nodes / time / nps per depth, plus every `info string` line the options produced.
+usage: bench_options.py <exe> <depth>[,<depth>...] [--set "Name=Value"]... [--expect d11=312866,...]
+Exit status 1 if an --expect node count differs, the engine exits with a non-zero status (e.g. a requested v2
+net that cannot be used) or fewer bench results than depths come back."""
+import argparse
+import re
+import subprocess
+import sys
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("exe")
+    ap.add_argument("depths")
+    ap.add_argument("--set", action="append", default=[], help="Name=Value (repeatable, sent in order)")
+    ap.add_argument("--expect", default="", help="comma list dNN=nodes")
+    a = ap.parse_args()
+    script = "uci\nsetoption name Threads value 1\nsetoption name Hash value 16\nsetoption name OwnBook value false\n"
+    for item in a.set:
+        name, value = item.split("=", 1)
+        script += f"setoption name {name} value {value}\n"
+    depths = [int(d) for d in a.depths.split(",")]
+    script += "isready\n" + "".join(f"bench {d}\n" for d in depths) + "quit\n"
+    run = subprocess.run([a.exe], input=script, capture_output=True, text=True, timeout=7200)
+    out = run.stdout
+    for line in out.splitlines():
+        if line.startswith("info string") and "bench depth" not in line:
+            print(line)
+    expect = dict(x.split("=") for x in a.expect.split(",") if x)
+    status = 0
+    results = list(re.finditer(r"bench depth (\d+) nodes (\d+) time (\d+) nps (\d+)", out))
+    if run.returncode != 0 or len(results) != len(depths):
+        # e.g. a requested v2 net that cannot be used: the engine exits with status 2 at isready.
+        print(f"ENGINE FAILED: exit status {run.returncode}, {len(results)} of {len(depths)} bench results")
+        status = 1
+    for m in results:
+        d, nodes = m.group(1), int(m.group(2))
+        verdict = ""
+        if f"d{d}" in expect:
+            ok = int(expect[f"d{d}"]) == nodes
+            verdict = " OK" if ok else f" MISMATCH (expected {expect['d' + d]})"
+            status |= 0 if ok else 1
+        print(f"bench d{d} nodes {nodes} time_ms {m.group(3)} nps {m.group(4)}{verdict}")
+    return status
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/nnue/forge_nnue_v2.py b/tools/nnue/forge_nnue_v2.py
new file mode 100644
index 00000000..65007e66
--- /dev/null
+++ b/tools/nnue/forge_nnue_v2.py
@@ -0,0 +1,262 @@
+#!/usr/bin/env python3
+"""Forge NNUE file format v2 ("FORGENN2"): reader, writer, king-bucket layouts and a converter.
+
+Format (little-endian; the engine's loader is forge::nnue::v2::load in src/nnue.cpp):
+  0   char[8] "FORGENN2"        8   u32 version = 2           12  u32 header_bytes = 160
+  16  u32 feature_set = 0       20  u32 inputs = 768          24  u32 hidden H
+  28  u32 king_buckets KB 1-32  32  u32 output_buckets OB     36  u32 flags: bit0 residual, bit1 king mirror
+  40  f32 weight_scale 4096     44  f32 output_scale 4096     48  f32 sigmoid_k 2.25
+  52  u8  king_bucket_map[64]   own-king square in the perspective's frame (rank-flipped for Black,
+                                a1 = 0), BEFORE mirroring -> bucket
+  116 u8  output_bucket_map[33] total piece count 0..32 -> output bucket (all 0 when OB = 1)
+  149 u8  reserved[11] = 0
+  160 i16 w1[KB][768][H]  i16 b1[H]  i16 w2[OB][2H]  i16 b2[OB]   (round(w * 4096))
+  end u64 FNV-1a 64 of every preceding byte
+
+Feature of piece pc on square s for perspective p with own king on k (engine and trainer):
+  r = s if p is White else s ^ 56;  kr = k if p is White else k ^ 56
+  flip = 7 if (mirror and kr % 8 >= 4) else 0
+  index = king_bucket_map[kr] * 768 + ((0 if colour(pc) == p else 1) * 6 + type(pc) - 1) * 64 + (r ^ flip)
+
+Pure Python (struct/array); numpy arrays are accepted as weight inputs.
+
+CLI:
+  forge_nnue_v2.py info <net.fnn2>
+  forge_nnue_v2.py from-inc <nnue_weights.inc> <out.fnn2> [--replica r1|r4|rm2|rm8|rm16]
+      Converts a compiled-in (v1) network. Every replica evaluates exactly like the v1 network, so a
+      search with it must reproduce the v1 bench node counts: r1 = 1 bucket; r4 = 4 identical buckets
+      (king-bucket changes, no mirroring); rm2 / rm8 / rm16 = mirrored nets whose e-h half buckets hold
+      the file-flipped v1 weights (rm8 / rm16 refresh exactly where a mirrored 4- / 8-bucket net does).
+"""
+from __future__ import annotations
+
+import argparse
+import re
+import struct
+import sys
+from array import array
+
+MAGIC = b"FORGENN2"
+VERSION = 2
+HEADER_BYTES = 160
+INPUTS = 768
+FLAG_RESIDUAL = 1
+FLAG_MIRROR = 2
+WEIGHT_SCALE = 4096.0
+OUTPUT_SCALE = 4096.0
+SIGMOID_K = 2.25
+
+
+def fnv1a64(data: bytes) -> int:
+    h = 0xcbf29ce484222325
+    for b in data:
+        h ^= b
+        h = (h * 0x100000001b3) & 0xFFFFFFFFFFFFFFFF
+    return h
+
+
+# ----------------------------------------------------------------------------- king bucket layouts
+# Half-board layouts: 32 entries, index rank * 4 + file for files a-d (file 0 = a) of the perspective's
+# own side after mirroring (a king on g1 counts as b1), ranks 1-8 from the perspective's back rank.
+_LAYOUT_ROWS = {
+    1: ["0000"] * 8,
+    2: ["0000", "0000"] + ["1111"] * 6,
+    4: ["0011", "0011", "2222", "2222"] + ["3333"] * 4,
+    6: ["0011", "2233", "4444", "4444"] + ["5555"] * 4,
+    8: ["0123", "4455", "6666"] + ["7777"] * 5,
+    16: ["0123", "4567", "8899", "aabb", "cccc", "dddd", "eeee", "ffff"],
+}
+
+
+def half_layout(buckets: int) -> list[int]:
+    """Standard half-board layout (32 entries) for 1, 2, 4, 6, 8, 16 or 32 buckets."""
+    if buckets == 32:
+        return list(range(32))
+    if buckets not in _LAYOUT_ROWS:
+        raise ValueError(f"no standard layout for {buckets} king buckets (have 1, 2, 4, 6, 8, 16, 32)")
+    return [int(ch, 16) for row in _LAYOUT_ROWS[buckets] for ch in row]
+
+
+def half_index(square: int) -> int:
+    """Half-board index of a perspective-relative square (files e-h fold onto d-a)."""
+    f, r = square & 7, square >> 3
+    return r * 4 + (f if f < 4 else 7 - f)
+
+
+def symmetric_map(half: list[int]) -> list[int]:
+    """64-entry map with map[s] == map[s ^ 7] from a 32-entry half-board layout."""
+    if len(half) != 32:
+        raise ValueError("half-board layout needs 32 entries")
+    return [half[half_index(s)] for s in range(64)]
+
+
+def split_halves_map(half: list[int]) -> tuple[list[int], int]:
+    """64-entry map where files e-h use their own buckets (offset by the layout's bucket count)."""
+    n = max(half) + 1
+    return [half[half_index(s)] + (n if (s & 7) >= 4 else 0) for s in range(64)], 2 * n
+
+
+def parse_map(text: str) -> list[int]:
+    """'0,0,1,...' with 32 (half-board, mirrored symmetric) or 64 entries -> 64-entry map."""
+    vals = [int(x) for x in re.split(r"[,\s]+", text.strip()) if x]
+    if len(vals) == 32:
+        return symmetric_map(vals)
+    if len(vals) == 64:
+        return vals
+    raise ValueError(f"king map needs 32 or 64 entries, got {len(vals)}")
+
+
+# ----------------------------------------------------------------------------- read / write
+def _i16_bytes(values, count: int, name: str) -> bytes:
+    try:  # numpy fast path
+        import numpy as np  # noqa: WPS433
+        if isinstance(values, np.ndarray):
+            a = values.astype("<i2", copy=False).ravel()
+            if a.size != count:
+                raise ValueError(f"{name}: {a.size} values, expected {count}")
+            if values.dtype.kind == "f" or (values.min(initial=0) < -32768 or values.max(initial=0) > 32767):
+                raise ValueError(f"{name}: needs int16 values")
+            return a.tobytes()
+    except ImportError:
+        pass
+    a = array("h", values)
+    if len(a) != count:
+        raise ValueError(f"{name}: {len(a)} values, expected {count}")
+    if sys.byteorder != "little":
+        a.byteswap()
+    return a.tobytes()
+
+
+def write_v2(path, *, hidden: int, king_buckets: int, residual: bool, mirror: bool, king_map, w1, b1, w2, b2,
+             output_buckets: int = 1, output_map=None) -> int:
+    """Writes a v2 file; returns its FNV-1a 64 checksum. w1 order [bucket][feature][hidden]."""
+    king_map = list(king_map)
+    output_map = [0] * 33 if output_map is None else list(output_map)
+    if len(king_map) != 64 or any(not 0 <= b < king_buckets for b in king_map):
+        raise ValueError("king map needs 64 entries in [0, king_buckets)")
+    if len(output_map) != 33 or any(not 0 <= b < output_buckets for b in output_map):
+        raise ValueError("output map needs 33 entries in [0, output_buckets)")
+    if not 1 <= king_buckets <= 32:
+        raise ValueError("king buckets must be 1-32")
+    flags = (FLAG_RESIDUAL if residual else 0) | (FLAG_MIRROR if mirror else 0)
+    head = MAGIC + struct.pack("<IIIIIIII", VERSION, HEADER_BYTES, 0, INPUTS, hidden, king_buckets, output_buckets, flags)
+    head += struct.pack("<fff", WEIGHT_SCALE, OUTPUT_SCALE, SIGMOID_K)
+    head += bytes(king_map) + bytes(output_map)
+    head += bytes(HEADER_BYTES - len(head))
+    assert len(head) == HEADER_BYTES
+    body = (_i16_bytes(w1, king_buckets * INPUTS * hidden, "w1") + _i16_bytes(b1, hidden, "b1") +
+            _i16_bytes(w2, output_buckets * 2 * hidden, "w2") + _i16_bytes(b2, output_buckets, "b2"))
+    data = head + body
+    checksum = fnv1a64(data)
+    with open(path, "wb") as f:
+        f.write(data + struct.pack("<Q", checksum))
+    return checksum
+
+
+def read_v2(path) -> dict:
+    data = open(path, "rb").read()
+    if len(data) < HEADER_BYTES + 8 or data[:8] != MAGIC:
+        raise ValueError("not a FORGENN2 file")
+    (version, header_bytes, feature_set, inputs, hidden, kb, ob, flags) = struct.unpack_from("<IIIIIIII", data, 8)
+    ws, os_, k = struct.unpack_from("<fff", data, 40)
+    if version != VERSION or header_bytes != HEADER_BYTES or feature_set != 0 or inputs != INPUTS:
+        raise ValueError("unsupported v2 header")
+    stored = struct.unpack_from("<Q", data, len(data) - 8)[0]
+    if fnv1a64(data[:-8]) != stored:
+        raise ValueError("checksum mismatch")
+    counts = [kb * INPUTS * hidden, hidden, ob * 2 * hidden, ob]
+    if len(data) != HEADER_BYTES + 2 * sum(counts) + 8:
+        raise ValueError("size mismatch")
+    out = dict(version=version, hidden=hidden, king_buckets=kb, output_buckets=ob,
+               residual=bool(flags & FLAG_RESIDUAL), mirror=bool(flags & FLAG_MIRROR),
+               weight_scale=ws, output_scale=os_, sigmoid_k=k, checksum=stored,
+               king_map=list(data[52:116]), output_map=list(data[116:149]))
+    off = HEADER_BYTES
+    for name, n in zip(("w1", "b1", "w2", "b2"), counts):
+        a = array("h")
+        a.frombytes(data[off:off + 2 * n])
+        if sys.byteorder != "little":
+            a.byteswap()
+        out[name] = a
+        off += 2 * n
+    return out
+
+
+def read_inc(path) -> dict:
+    """Arrays of a compiled-in network include file (train_resid*.py export)."""
+    text = open(path, encoding="ascii").read()
+    m = re.search(r"#define FORGE_NNUE_RESIDUAL\s+(\d)", text)
+    residual = bool(int(m.group(1))) if m else False
+
+    def arr(name):
+        mm = re.search(name + r"\[(\d+)\]\s*=\s*\{([^}]*)\}", text, re.S)
+        vals = array("h", (int(x) for x in mm.group(2).replace("\n", " ").split(",") if x.strip()))
+        if len(vals) != int(mm.group(1)):
+            raise ValueError(f"{name}: size mismatch")
+        return vals
+    b2 = int(re.search(r"NnueB2\s*=\s*(-?\d+)", text).group(1))
+    w1, b1, w2 = arr("NnueW1"), arr("NnueB1"), arr("NnueW2")
+    hidden = len(b1)
+    if len(w1) != INPUTS * hidden or len(w2) != 2 * hidden:
+        raise ValueError("unexpected include shapes")
+    return dict(w1=w1, b1=b1, w2=w2, b2=array("h", [b2]), residual=residual, hidden=hidden)
+
+
+def flipped_files(w1_bucket, hidden: int):
+    """Weights of one bucket with every square mirrored horizontally (feature (pt, s) <- (pt, s ^ 7))."""
+    out = array("h", bytes(2 * INPUTS * hidden))
+    for f in range(INPUTS):
+        src = (f & ~63) | ((f & 63) ^ 7)
+        out[f * hidden:(f + 1) * hidden] = w1_bucket[src * hidden:(src + 1) * hidden]
+    return out
+
+
+def replica(inc: dict, kind: str) -> dict:
+    """v2 network that evaluates exactly like the v1 include (see module docstring)."""
+    hidden, w1 = inc["hidden"], inc["w1"]
+    if kind == "r1":
+        kb, mirror, kmap, flips = 1, False, [0] * 64, [False]
+    elif kind == "r4":
+        kb, mirror, kmap, flips = 4, False, symmetric_map(half_layout(4)), [False] * 4
+    elif kind in ("rm2", "rm8", "rm16"):
+        base = {"rm2": 1, "rm8": 4, "rm16": 8}[kind]
+        kmap, kb = split_halves_map(half_layout(base))
+        mirror, flips = True, [b >= base for b in range(kb)]
+    else:
+        raise ValueError(f"unknown replica {kind}")
+    flipped = flipped_files(w1, hidden) if any(flips) else None
+    big = array("h")
+    for b in range(kb):
+        big.extend(flipped if flips[b] else w1)
+    return dict(hidden=hidden, king_buckets=kb, residual=inc["residual"], mirror=mirror, king_map=kmap,
+                w1=big, b1=inc["b1"], w2=inc["w2"], b2=inc["b2"])
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    p = sub.add_parser("info")
+    p.add_argument("net")
+    p = sub.add_parser("from-inc")
+    p.add_argument("inc")
+    p.add_argument("out")
+    p.add_argument("--replica", default="r1", choices=["r1", "r4", "rm2", "rm8", "rm16"])
+    a = ap.parse_args(argv)
+    if a.cmd == "info":
+        n = read_v2(a.net)
+        print(f"{a.net}: hidden {n['hidden']} king_buckets {n['king_buckets']} mirror {n['mirror']} "
+              f"output_buckets {n['output_buckets']} residual {n['residual']} fnv1a {n['checksum']:016x}")
+        print("king map (rank 8 first, files a-h, perspective frame):")
+        for r in range(7, -1, -1):
+            print("  " + " ".join(f"{n['king_map'][r * 8 + f]:2d}" for f in range(8)))
+        print("output map (pieces 0..32):", " ".join(map(str, n["output_map"])))
+        return 0
+    net = replica(read_inc(a.inc), a.replica)
+    checksum = write_v2(a.out, **net)
+    print(f"wrote {a.out}: replica {a.replica}, king_buckets {net['king_buckets']}, mirror {net['mirror']}, "
+          f"fnv1a {checksum:016x}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/nnue/mkdata_data32_synthetic.py b/tools/nnue/mkdata_data32_synthetic.py
new file mode 100644
index 00000000..f55df815
--- /dev/null
+++ b/tools/nnue/mkdata_data32_synthetic.py
@@ -0,0 +1,17 @@
+import numpy as np, sys
+rng = np.random.default_rng(7)
+def write(name, n):
+    # boards: 64 nibble codes (0 empty, 1..12), ~25% occupied
+    codes = np.where(rng.random((n, 64)) < 0.25, rng.integers(1, 13, (n, 64)), 0).astype(np.uint8)
+    boards = (codes[:, 0::2] | (codes[:, 1::2] << 4)).astype(np.uint8)
+    score = rng.normal(0, 300, n).clip(-3000, 3000).astype(np.int16)
+    meta = (rng.integers(0, 2, n) | (rng.integers(0, 3, n) << 1)).astype(np.uint8)
+    hce = (score * 0.7 + rng.normal(0, 120, n)).clip(-3000, 3000).astype(np.int16)
+    with open(f"{name}.pos", "wb") as f:
+        f.write(b"FPOS" + (1).to_bytes(4, "little") + n.to_bytes(8, "little"))
+        f.write(boards.tobytes()); f.write(score.tobytes()); f.write(meta.tobytes())
+    with open(f"{name}.hce", "wb") as f:
+        f.write(b"FHCE" + (1).to_bytes(4, "little") + n.to_bytes(8, "little")); f.write(hce.tobytes())
+sizes = [int(x) for x in sys.argv[2:]]
+for i, n in enumerate(sizes):
+    write(f"{sys.argv[1]}{i:03d}", n)
diff --git a/tools/nnue/nnue_v2_tool.cpp b/tools/nnue/nnue_v2_tool.cpp
new file mode 100644
index 00000000..013f073f
--- /dev/null
+++ b/tools/nnue/nnue_v2_tool.cpp
@@ -0,0 +1,141 @@
+// nnue_v2_tool: helper for the v2 export parity check (tools/nnue/v2_parity.py).
+//   nnue_v2_tool positions <out.fen> <count> <seed>
+//       Diverse legal positions from random games (capture-biased so that every piece count from 32
+//       down to 2 occurs; kings wander, so king buckets and mirroring are covered). Deterministic.
+//   nnue_v2_tool eval <net.fnn2> <in.fen> <out_prefix>
+//       Loads the v2 net with the engine's loader and, per position, computes the accumulators from
+//       scratch with the engine's kernels (forge/nnue_v2.hpp) and the evaluation. Writes
+//       <out_prefix>.tsv (index, side to move, king bucket/flip per perspective, piece count, raw output
+//       float bits, centipawns) and <out_prefix>.acc (float32 [N][2][HiddenSize], White then Black
+//       perspective). Also checks the refresh cache against the from-scratch refresh on every position.
+#include "forge/nnue_v2.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <set>
+#include <string>
+#include <vector>
+
+using namespace forge;
+namespace v2 = forge::nnue::v2;
+
+namespace {
+
+struct Rng {
+    std::uint64_t s;
+    std::uint64_t next() {
+        s ^= s >> 12U; s ^= s << 25U; s ^= s >> 27U;
+        return s * 2685821657736338717ULL;
+    }
+    int below(int n) { return static_cast<int>(next() % static_cast<std::uint64_t>(n)); }
+};
+
+int positions(const std::string& out_path, int count, std::uint64_t seed) {
+    const std::vector<std::string> starts = {
+        std::string(Board::StandardStartFen),
+        "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
+        "r1bq1rk1/pp2bppp/2n1pn2/3p4/2PP4/2N1PN2/PP3PPP/R2QKB1R w KQ - 0 8",
+        "r2q1rk1/ppp2ppp/2n1bn2/2bpp3/3PP3/2N1BN2/PPP1BPPP/R2Q1RK1 w - - 0 9",
+    };
+    Rng rng{seed};
+    std::set<std::string> seen;
+    std::vector<std::string> fens;
+    // Even coverage of the piece counts 2..32: at most `quota` positions per count (relaxed if the
+    // random games cannot fill a count).
+    const int quota = (count + 30) / 31;
+    std::vector<int> per_count(33, 0);
+    for (long game = 0; static_cast<int>(fens.size()) < count; ++game) {
+        const bool relaxed = game > 200000;
+        Board board;
+        (void)board.set_fen(starts[static_cast<std::size_t>(rng.below(static_cast<int>(starts.size())))]);
+        const int capture_bias = 20 + rng.below(50);   // percent
+        const int keep = 4 + rng.below(10);            // percent of plies recorded
+        // Games continue in bare-king endings, so kings also visit every square.
+        for (int ply = 0; ply < 600 && static_cast<int>(fens.size()) < count; ++ply) {
+            const MoveList moves = board.legal_moves();
+            if (moves.empty()) break;
+            std::vector<Move> captures;
+            for (const Move& m : moves) if (m.is_capture()) captures.push_back(m);
+            const Move move = !captures.empty() && rng.below(100) < capture_bias
+                ? captures[static_cast<std::size_t>(rng.below(static_cast<int>(captures.size())))]
+                : moves[static_cast<std::size_t>(rng.below(static_cast<int>(moves.size())))];
+            Undo undo;
+            (void)board.make_move(move, undo);
+            const int pieces = popcount(board.occupied());
+            if (rng.below(100) < keep && (relaxed || per_count[static_cast<std::size_t>(pieces)] < quota)) {
+                const std::string fen = board.fen();
+                if (seen.insert(fen).second) {
+                    fens.push_back(fen);
+                    ++per_count[static_cast<std::size_t>(pieces)];
+                }
+            }
+        }
+    }
+    std::ofstream out(out_path, std::ios::binary);   // LF line ends on every platform
+    for (const std::string& fen : fens) out << fen << '\n';
+    std::cout << "wrote " << fens.size() << " positions to " << out_path << '\n';
+    return 0;
+}
+
+int eval(const std::string& net_path, const std::string& fen_path, const std::string& prefix) {
+    std::string error;
+    if (!v2::load(net_path, &error)) {
+        std::cerr << "cannot load " << net_path << ": " << error << '\n';
+        return 2;
+    }
+    const v2::Net& net = *v2::loaded();
+    v2::RefreshCache& cache = v2::cache(net, 0);
+    std::ifstream in(fen_path);
+    std::ofstream tsv(prefix + ".tsv", std::ios::binary);
+    std::ofstream acc(prefix + ".acc", std::ios::binary);
+    tsv << "index\tstm\twhite_bucket\twhite_flip\tblack_bucket\tblack_flip\tpieces\tout_bits\tcp\n";
+    std::string line;
+    int index = 0;
+    int cache_mismatch = 0;
+    while (std::getline(in, line)) {
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();   // CRLF input
+        if (line.empty()) continue;
+        Board board;
+        if (!board.set_fen(line, &error)) {
+            std::cerr << "bad FEN line " << index << ": " << error << '\n';
+            return 2;
+        }
+        nnue::Accumulator a;
+        v2::refresh(net, board, White, a.values[White].data());
+        v2::refresh(net, board, Black, a.values[Black].data());
+        nnue::Accumulator c;
+        const v2::Pieces pieces = v2::pieces_of(board);
+        v2::refresh_cached(net, cache, pieces, board.king_square(White), White, c.values[White].data());
+        v2::refresh_cached(net, cache, pieces, board.king_square(Black), Black, c.values[Black].data());
+        if (std::memcmp(a.values.data(), c.values.data(), sizeof(a.values)) != 0) ++cache_mismatch;
+        const float out = v2::output(net, board, a);
+        std::uint32_t bits = 0;
+        std::memcpy(&bits, &out, sizeof(bits));
+        const v2::KingKey wk = v2::king_key(net, White, board.king_square(White));
+        const v2::KingKey bk = v2::king_key(net, Black, board.king_square(Black));
+        char hex[16];
+        std::snprintf(hex, sizeof(hex), "%08x", static_cast<unsigned>(bits));
+        tsv << index << '\t' << (board.side_to_move() == White ? 0 : 1) << '\t' << wk.bucket << '\t' << wk.flip << '\t'
+            << bk.bucket << '\t' << bk.flip << '\t' << popcount(board.occupied()) << '\t' << hex << '\t'
+            << v2::evaluate(net, board, a) << '\n';
+        acc.write(reinterpret_cast<const char*>(a.values.data()), static_cast<std::streamsize>(sizeof(a.values)));
+        ++index;
+    }
+    std::cout << "evaluated " << index << " positions with " << net_path << " (king buckets " << net.king_buckets
+              << (net.mirror ? ", mirrored" : "") << "); refresh cache vs from-scratch mismatches: " << cache_mismatch << '\n';
+    return cache_mismatch == 0 ? 0 : 1;
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    const std::string mode = argc > 1 ? argv[1] : "";
+    if (mode == "positions" && argc == 5) return positions(argv[2], std::stoi(argv[3]), std::stoull(argv[4]));
+    if (mode == "eval" && argc == 5) return eval(argv[2], argv[3], argv[4]);
+    std::cerr << "usage: nnue_v2_tool positions <out.fen> <count> <seed>\n"
+                 "       nnue_v2_tool eval <net.fnn2> <in.fen> <out_prefix>\n";
+    return 2;
+}
diff --git a/tools/nnue/qa_adam_dml.py b/tools/nnue/qa_adam_dml.py
new file mode 100644
index 00000000..13d31527
--- /dev/null
+++ b/tools/nnue/qa_adam_dml.py
@@ -0,0 +1,39 @@
+"""qa_adam_dml.py (Engine QA 2026-10-24). torch.optim.Adam with the exp_avg update written as mul_/add_ instead of lerp_.
+torch-directml 2.4.1 has no aten::lerp.Scalar_out, so stock Adam copies exp_avg to the CPU and back every step (UserWarning
+in every b8/v2 run's .log.err). Same math, same state keys ('step','exp_avg','exp_avg_sq'), same state_dict/checkpoint format
+as torch.optim.Adam (amsgrad/weight_decay/maximize not supported -> asserts). Differences vs stock: float rounding only."""
+import math, torch
+
+class AdamDML(torch.optim.Adam):
+    def __init__(self, params, lr=1e-3, betas=(0.9, 0.999), eps=1e-8, **kw):
+        kw.setdefault("foreach", False)
+        super().__init__(params, lr=lr, betas=betas, eps=eps, **kw)
+        for g in self.param_groups:
+            assert not g.get("amsgrad") and not g.get("weight_decay") and not g.get("maximize"), "AdamDML: plain Adam only"
+
+    @torch.no_grad()
+    def step(self, closure=None):
+        loss = None
+        if closure is not None:
+            with torch.enable_grad():
+                loss = closure()
+        for g in self.param_groups:
+            b1, b2 = g["betas"]; lr = g["lr"]; eps = g["eps"]
+            for p in g["params"]:
+                if p.grad is None:
+                    continue
+                st = self.state[p]
+                if len(st) == 0:
+                    st["step"] = torch.tensor(0.0)
+                    st["exp_avg"] = torch.zeros_like(p, memory_format=torch.preserve_format)
+                    st["exp_avg_sq"] = torch.zeros_like(p, memory_format=torch.preserve_format)
+                st["step"] += 1
+                t = float(st["step"])
+                m, v, gr = st["exp_avg"], st["exp_avg_sq"], p.grad
+                m.mul_(b1).add_(gr, alpha=1 - b1)
+                v.mul_(b2).addcmul_(gr, gr, value=1 - b2)
+                bc1 = 1 - b1 ** t; bc2s = math.sqrt(1 - b2 ** t)
+                denom = (v.sqrt() / bc2s).add_(eps)
+                p.addcdiv_(m, denom, value=-lr / bc1)
+        return loss
+
diff --git a/tools/nnue/train_resid_v3b.py b/tools/nnue/train_resid_v3b.py
new file mode 100644
index 00000000..271d3113
--- /dev/null
+++ b/tools/nnue/train_resid_v3b.py
@@ -0,0 +1,825 @@
+#!/usr/bin/env python3
+# train_resid_v3.py: speed-only derivative of train_resid_v2.py (Forge trainer, AI-made for Couns). Changes: epoch-boundary prefetch overlap, packed H2D copy, loss-sync default 128. Same math.
+# train_resid_v3b.py: RAM derivative of train_resid_v3a.py. --dev-scalars (per-step lr/blend/Adam factors as preallocated device tensors,
+# filled by copy_, not new Python floats each step: suspected DirectML per-step host leak ~24 KB/step), int32 shuffle order in reused
+# buffer(s), optional --mmap-data, private-memory logging + --max-ram-gb warning. Same order, same math (bit-identical on CPU).
+"""Forge-768 residual NNUE trainer (GPU, DirectML/CPU). Own code, derived in structure from the
+supplied train_nnue.py (md5 5A161C70...), but fed from pre-converted binaries:
+
+  *.pos  (tools/fen2bin.cpp)  nibble boards + int16 teacher score (STM cp) + meta (stm, WHITE result)
+  *.hce  (tools/hce_dump.cpp) int16 Forge-1ab50b2d evaluate_uncached (STM cp), line-aligned with .pos
+
+Model/export are the same Forge net (768 -> H per perspective, SCReLU, 2H -> 1, int16 QAT, scale 4096).
+--residual: logit = net(x) + K*hce/400, output layer starts at zero => first forward == HCE alone,
+export writes FORGE_NNUE_RESIDUAL 1.  Loss = MSE(sigmoid(logit), blend*sigmoid(K*score/400) + (1-blend)*stm_result).
+Holdout = whole files (never trained on).  Blend ramps linearly over training progress.
+"""
+from __future__ import annotations
+import argparse, ctypes, glob, json, math, os, queue, sys, threading, time, uuid
+from pathlib import Path
+import numpy as np
+import torch
+from torch import nn
+import torch.nn.functional as F
+
+FEATURES = 768
+SCALE = 4096.0
+K_DEFAULT = 2.25
+
+
+# ----------------------------------------------------------------------------- data
+def read_pos_header(path):
+    with open(path, "rb") as f:
+        h = f.read(16)
+    if h[:4] != b"FPOS" or int.from_bytes(h[4:8], "little") != 1:
+        raise ValueError(f"bad pos header {path}")
+    return int.from_bytes(h[8:16], "little")
+
+
+def load_set(pos_files, hce_dir, limit=None, need_hce=True):
+    """Load pos(+hce) files into RAM, in the given order. limit = max positions (takes file prefixes)."""
+    ns, picks = [], []
+    total = 0
+    for p in pos_files:
+        n = read_pos_header(p)
+        if limit is not None and total + n > limit:
+            n_use = limit - total
+        else:
+            n_use = n
+        if n_use <= 0:
+            break
+        picks.append((p, n, n_use))
+        total += n_use
+    boards = np.empty((total, 32), np.uint8)
+    score = np.empty(total, np.int16)
+    meta = np.empty(total, np.uint8)
+    hce = np.empty(total, np.int16)
+    o = 0
+    for p, n, n_use in picks:
+        b = np.memmap(p, np.uint8, "r", 16, (n, 32))
+        s = np.memmap(p, np.int16, "r", 16 + n * 32, (n,))
+        m = np.memmap(p, np.uint8, "r", 16 + n * 34, (n,))
+        boards[o:o + n_use] = b[:n_use]; score[o:o + n_use] = s[:n_use]; meta[o:o + n_use] = m[:n_use]
+        if (m[:n_use] == 255).any():
+            raise ValueError(f"bad records in {p}")
+        if need_hce:
+            hp = Path(hce_dir) / (Path(p).stem + ".hce")
+            with open(hp, "rb") as f:
+                h = f.read(16)
+            if h[:4] != b"FHCE" or int.from_bytes(h[8:16], "little") != n:
+                raise ValueError(f"hce header/count mismatch {hp} vs {p}")
+            hh = np.memmap(hp, np.int16, "r", 16, (n,))
+            if (hh[:n_use] == -32768).any():
+                raise ValueError(f"bad hce in {hp}")
+            hce[o:o + n_use] = hh[:n_use]
+            del hh
+        del b, s, m
+        o += n_use
+    return dict(boards=boards, score=score, meta=meta, hce=hce, n=total, files=[(p, n_use) for p, n, n_use in picks])
+
+
+class CatMap:
+    """v3b --mmap-data: read-only view over per-file np.memmap arrays (concatenated in file order, file prefixes).
+    __getitem__(idx) gathers rows for an int index array without loading the files into private memory."""
+    def __init__(self, parts, offs, dtype, row_shape=()):
+        self.parts, self.offs, self.dtype, self.row_shape = parts, np.asarray(offs, np.int64), dtype, row_shape
+
+    def __getitem__(self, idx):
+        idx = np.asarray(idx)
+        out = np.empty((len(idx),) + self.row_shape, self.dtype)
+        fid = np.searchsorted(self.offs, idx, side="right") - 1
+        for f in np.unique(fid):
+            sel = fid == f
+            out[sel] = self.parts[f][idx[sel] - self.offs[f]]
+        return out
+
+
+def load_set_mmap(pos_files, hce_dir, limit=None):
+    """v3b: same selection/validation as load_set, but arrays stay memory-mapped (file-backed pages, no private copy)."""
+    picks, total = [], 0
+    for p in pos_files:
+        n = read_pos_header(p)
+        n_use = limit - total if limit is not None and total + n > limit else n
+        if n_use <= 0:
+            break
+        picks.append((p, n, n_use)); total += n_use
+    B, S, M, H, offs, o = [], [], [], [], [], 0
+    for p, n, n_use in picks:
+        b = np.memmap(p, np.uint8, "r", 16, (n, 32))[:n_use]
+        s = np.memmap(p, np.int16, "r", 16 + n * 32, (n,))[:n_use]
+        m = np.memmap(p, np.uint8, "r", 16 + n * 34, (n,))[:n_use]
+        if (m == 255).any():
+            raise ValueError(f"bad records in {p}")
+        hp = Path(hce_dir) / (Path(p).stem + ".hce")
+        with open(hp, "rb") as f:
+            h = f.read(16)
+        if h[:4] != b"FHCE" or int.from_bytes(h[8:16], "little") != n:
+            raise ValueError(f"hce header/count mismatch {hp} vs {p}")
+        hh = np.memmap(hp, np.int16, "r", 16, (n,))[:n_use]
+        if (hh == -32768).any():
+            raise ValueError(f"bad hce in {hp}")
+        B.append(b); S.append(s); M.append(m); H.append(hh); offs.append(o); o += n_use
+    return dict(boards=CatMap(B, offs, np.uint8, (32,)), score=CatMap(S, offs, np.int16), meta=CatMap(M, offs, np.uint8),
+                hce=CatMap(H, offs, np.int16), n=total, files=[(p, n_use) for p, n, n_use in picks])
+
+
+# ----------------------------------------------------------------------------- memory (v3b)
+def proc_mem_gb():
+    """(process private GB, system available GB). Windows: PrivateUsage / ullAvailPhys; Linux: RssAnon / MemAvailable."""
+    try:
+        if os.name == "nt":
+            class PMC(ctypes.Structure):
+                _fields_ = [("cb", ctypes.c_ulong), ("PageFaultCount", ctypes.c_ulong)] + [(f, ctypes.c_size_t) for f in (
+                    "PeakWorkingSetSize", "WorkingSetSize", "QuotaPeakPagedPoolUsage", "QuotaPagedPoolUsage",
+                    "QuotaPeakNonPagedPoolUsage", "QuotaNonPagedPoolUsage", "PagefileUsage", "PeakPagefileUsage", "PrivateUsage")]
+            class MSX(ctypes.Structure):
+                _fields_ = [("dwLength", ctypes.c_ulong), ("dwMemoryLoad", ctypes.c_ulong)] + [(f, ctypes.c_ulonglong) for f in (
+                    "ullTotalPhys", "ullAvailPhys", "ullTotalPageFile", "ullAvailPageFile", "ullTotalVirtual", "ullAvailVirtual",
+                    "ullAvailExtendedVirtual")]
+            pmc = PMC(); pmc.cb = ctypes.sizeof(PMC)
+            k32, psapi = ctypes.WinDLL("kernel32"), ctypes.WinDLL("psapi")
+            psapi.GetProcessMemoryInfo.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_ulong]
+            k32.GetCurrentProcess.restype = ctypes.c_void_p
+            psapi.GetProcessMemoryInfo(k32.GetCurrentProcess(), ctypes.byref(pmc), pmc.cb)
+            ms = MSX(); ms.dwLength = ctypes.sizeof(MSX); k32.GlobalMemoryStatusEx(ctypes.byref(ms))
+            return pmc.PrivateUsage / 2**30, ms.ullAvailPhys / 2**30
+        priv = avail = float("nan")
+        for line in open("/proc/self/status"):
+            if line.startswith("RssAnon:"):
+                priv = int(line.split()[1]) / 2**20
+        for line in open("/proc/meminfo"):
+            if line.startswith("MemAvailable:"):
+                avail = int(line.split()[1]) / 2**20
+        return priv, avail
+    except Exception:  # noqa  (logging only; never stops training)
+        return float("nan"), float("nan")
+
+
+def mem_report(tag, max_gb):
+    priv, avail = proc_mem_gb()
+    print(f"MEM {tag} trainer_private={priv:.2f}GB sys_avail={avail:.2f}GB", flush=True)
+    if max_gb and priv == priv and priv > max_gb:
+        print(f"WARNING: trainer private memory {priv:.2f}GB > --max-ram-gb {max_gb:g} (warning only; training continues)", flush=True)
+
+
+def make_batch(d, idx):
+    b = d["boards"][idx]
+    codes = np.empty((len(idx), 64), np.uint8)
+    codes[:, 0::2] = b & 15
+    codes[:, 1::2] = b >> 4
+    m = d["meta"][idx]
+    return (codes, (m & 1), (m >> 1), d["score"][idx], d["hce"][idx])
+
+
+PACK_W = 68  # v3: floats per position in the packed batch: 64 codes, stm, wres, score, hce_logit
+
+
+def pack_batch(bt, k):
+    """v3: one contiguous float32 buffer per batch (all values exact in float32; hce_logit computed exactly as v2's to_dev)."""
+    codes, stm, wres, score, hce = bt
+    B = len(codes)
+    buf = np.empty(B * PACK_W, np.float32)
+    buf[: B * 64] = codes.reshape(-1)
+    buf[B * 64:B * 65] = stm
+    buf[B * 65:B * 66] = wres
+    buf[B * 66:B * 67] = score
+    buf[B * 67:] = hce.astype(np.float32) * (k / 400.0)
+    return buf
+
+
+class Prefetcher:
+    def __init__(self, d, order, batch, k, depth=6):
+        self.q = queue.Queue(depth)
+        self.d, self.order, self.batch, self.k = d, order, batch, k
+        self.stop = threading.Event()
+        self.t = threading.Thread(target=self.run, daemon=True)
+        self.t.start()
+
+    def _put(self, x):
+        while not self.stop.is_set():
+            try:
+                self.q.put(x, timeout=0.1)
+                return
+            except queue.Full:
+                pass
+
+    def run(self):
+        try:
+            n = len(self.order)
+            for i in range(0, n - self.batch + 1, self.batch):
+                if self.stop.is_set():
+                    return
+                idx = np.sort(self.order[i:i + self.batch])
+                self._put(pack_batch(make_batch(self.d, idx), self.k))
+            self._put(None)
+        except BaseException as e:  # noqa
+            self._put(e)
+
+    def close(self):
+        """v3: stop the producer thread and join it (used on early exit / exceptions)."""
+        self.stop.set()
+        while self.t.is_alive():
+            try:
+                while True:
+                    self.q.get_nowait()
+            except queue.Empty:
+                pass
+            self.t.join(0.05)
+
+    def __iter__(self):
+        while True:
+            x = self.q.get()
+            if x is None:
+                return
+            if isinstance(x, BaseException):
+                raise x
+            yield x
+
+
+def eval_order(n, batch):
+    """Sequential order for evaluation incl. the tail (as full batches only; tail dropped is reported)."""
+    return np.arange(n, dtype=np.int64)
+
+
+# ----------------------------------------------------------------------------- model
+def features(codes, black):
+    """codes [B,64] int64 (0 empty, 1..6 white PNBRQK, 7..12 black); black [B] int64 perspective colour.
+    Returns [B,64] feature index (768 = empty) == forge::nnue::feature_index."""
+    sq = torch.arange(64, device=codes.device).unsqueeze(0)
+    c = codes - 1
+    color = torch.div(c, 6, rounding_mode="floor")
+    typ = c - color * 6
+    bl = black.unsqueeze(1)
+    rel = (color != bl).long()
+    rsq = torch.where(bl == 1, sq ^ 56, sq.expand_as(codes))
+    f = (rel * 6 + typ) * 64 + rsq
+    return torch.where(codes > 0, f, torch.full_like(f, FEATURES))
+
+
+def dense(codes, black):
+    f = features(codes, black)
+    x = torch.zeros(codes.shape[0], FEATURES + 1, device=codes.device).scatter_(1, f, 1.0)
+    return x[:, :FEATURES]
+
+
+class NNUE(nn.Module):
+    def __init__(self, hidden, qat=True, residual=True):
+        super().__init__()
+        self.hidden, self.qat, self.residual = hidden, qat, residual
+        self.ft = nn.Linear(FEATURES, hidden)
+        self.out = nn.Linear(2 * hidden, 1)
+        nn.init.normal_(self.ft.weight, std=0.02)
+        nn.init.zeros_(self.ft.bias)
+        nn.init.zeros_(self.out.bias)
+        if residual:
+            nn.init.zeros_(self.out.weight)  # first forward == HCE alone
+
+    def q(self, p):
+        if not self.qat:
+            return p
+        scaled = p * SCALE
+        rounded = torch.sign(scaled) * torch.floor(torch.abs(scaled) + 0.5)
+        qv = torch.clamp(rounded, -32767, 32767) / SCALE
+        return p + (qv - p).detach()
+
+    def forward(self, codes, stm, hce_logit):
+        xs = dense(codes, stm)
+        xo = dense(codes, 1 - stm)
+        w, b = self.q(self.ft.weight), self.q(self.ft.bias)
+        hs = torch.clamp(F.linear(xs, w, b), 0.0, 1.0).square()
+        ho = torch.clamp(F.linear(xo, w, b), 0.0, 1.0).square()
+        out = F.linear(torch.cat([hs, ho], 1), self.q(self.out.weight), self.q(self.out.bias)).squeeze(1)
+        return out + hce_logit if self.residual else out
+
+    @torch.no_grad()
+    def project_weights(self):
+        for p in self.parameters():
+            p.clamp_(-32767 / SCALE, 32767 / SCALE)
+
+
+# ----------------------------------------------------------------------------- king buckets (Opus C4)
+# Optional architecture, used only with --king-buckets N (N >= 1); without it everything above and below is
+# the unchanged v3b trainer. Feature definition (identical in the engine, forge/nnue_v2.hpp):
+#   perspective p (black = 1), own king on square k (first own king if a malformed record has several, square 0
+#   if it has none), kr = k ^ 56 for black else k; flip = 7 if mirroring and kr % 8 >= 4 else 0;
+#   index = king_map[kr] * 768 + (rel * 6 + type) * 64 + (rsq ^ flip)   (rel, type, rsq as in features()).
+# Factoriser (--king-factor 1, default): every bucket's weights are bucket[b] + factor, where `factor` is one
+# 768 x H block shared by all buckets during training; the export folds it in (inference cost unchanged).
+# QAT and export use q(bucket[b] + factor), so the exported ints are exactly the trained forward's weights.
+def king_features(codes, black, king_map, mirror, kb):
+    """codes [B,64], black [B] -> feature indices [B,64] in [0, kb*768) (kb*768 = empty square) == the engine's."""
+    sq = torch.arange(64, device=codes.device).unsqueeze(0)
+    c = codes - 1
+    color = torch.div(c, 6, rounding_mode="floor")
+    typ = c - color * 6
+    bl = black.unsqueeze(1)
+    rel = (color != bl).long()
+    rsq = torch.where(bl == 1, sq ^ 56, sq.expand_as(codes))
+    own_king = torch.where(black == 1, 12, 6).unsqueeze(1)
+    ksq = torch.argmax((codes == own_king).long(), dim=1)          # first own king, 0 if none
+    kr = torch.where(black == 1, ksq ^ 56, ksq)
+    flip = torch.where((kr & 7) >= 4, 7, 0) if mirror else torch.zeros_like(kr)
+    bucket = king_map[kr]
+    f = bucket.unsqueeze(1) * FEATURES + (rel * 6 + typ) * 64 + (rsq ^ flip.unsqueeze(1))
+    return torch.where(codes > 0, f, torch.full_like(f, kb * FEATURES))
+
+
+def king_dense(codes, black, king_map, mirror, kb):
+    f = king_features(codes, black, king_map, mirror, kb)
+    x = torch.zeros(codes.shape[0], kb * FEATURES + 1, device=codes.device).scatter_(1, f, 1.0)
+    return x[:, :kb * FEATURES]
+
+
+def king_map_from_args(buckets, map_text):
+    sys.path.insert(0, str(Path(__file__).resolve().parent))
+    import forge_nnue_v2 as V2
+    kmap = V2.parse_map(map_text) if map_text else V2.symmetric_map(V2.half_layout(buckets))
+    if max(kmap) + 1 != buckets or min(kmap) < 0:
+        raise ValueError(f"king map uses buckets 0..{max(kmap)}, expected 0..{buckets - 1}")
+    return kmap
+
+
+def quant_int(p):
+    """The integers q() uses for p (float32, round half away from zero, clamp to int16), as int16 numpy."""
+    s = p.detach().float().cpu() * SCALE
+    r = torch.clamp(torch.sign(s) * torch.floor(torch.abs(s) + 0.5), -32767, 32767)
+    return r.to(torch.int16).numpy()
+
+
+class NNUEKB(nn.Module):
+    def __init__(self, hidden, king_map, mirror=True, factor=True, qat=True, residual=True):
+        super().__init__()
+        self.hidden, self.qat, self.residual, self.mirror = hidden, qat, residual, bool(mirror)
+        self.register_buffer("king_map", torch.tensor(king_map, dtype=torch.long))
+        self.kb = max(king_map) + 1
+        self.ft_w = nn.Parameter(torch.zeros(self.kb, hidden, FEATURES))
+        self.ft_f = nn.Parameter(torch.zeros(hidden, FEATURES)) if factor else None
+        self.ft_b = nn.Parameter(torch.zeros(hidden))
+        self.out = nn.Linear(2 * hidden, 1)
+        nn.init.normal_(self.ft_f if factor else self.ft_w, std=0.02)
+        nn.init.zeros_(self.out.bias)
+        if residual:
+            nn.init.zeros_(self.out.weight)  # first forward == HCE alone
+
+    q = NNUE.q
+    project_weights = NNUE.project_weights
+
+    def ft_sum(self):
+        """Folded bucket weights [KB, H, 768] (before quantisation)."""
+        return self.ft_w if self.ft_f is None else self.ft_w + self.ft_f.unsqueeze(0)
+
+    def forward(self, codes, stm, hce_logit):
+        w = self.q(self.ft_sum()).permute(1, 0, 2).reshape(self.hidden, self.kb * FEATURES)
+        b = self.q(self.ft_b)
+        hs = torch.clamp(F.linear(king_dense(codes, stm, self.king_map, self.mirror, self.kb), w, b), 0.0, 1.0).square()
+        ho = torch.clamp(F.linear(king_dense(codes, 1 - stm, self.king_map, self.mirror, self.kb), w, b), 0.0, 1.0).square()
+        out = F.linear(torch.cat([hs, ho], 1), self.q(self.out.weight), self.q(self.out.bias)).squeeze(1)
+        return out + hce_logit if self.residual else out
+
+
+def export_forge_v2(model, stem, residual):
+    """Writes <stem>.fnn2 (format v2, see forge_nnue_v2.py) from the trained forward's quantised weights."""
+    sys.path.insert(0, str(Path(__file__).resolve().parent))
+    import forge_nnue_v2 as V2
+    with torch.no_grad():
+        if isinstance(model, NNUEKB):
+            w1 = quant_int(model.ft_sum()).transpose(0, 2, 1)       # [KB, 768, H]
+            b1 = quant_int(model.ft_b)
+            kmap, kb, mirror = model.king_map.cpu().tolist(), model.kb, model.mirror
+        else:
+            w1 = quant_int(model.ft.weight).T[None]                 # [1, 768, H]
+            b1 = quant_int(model.ft.bias)
+            kmap, kb, mirror = [0] * 64, 1, False
+        w2, b2 = quant_int(model.out.weight).ravel(), quant_int(model.out.bias).ravel()
+    path = stem.with_suffix(".fnn2")
+    temp = path.with_name(path.name + ".tmp-" + uuid.uuid4().hex)
+    try:
+        V2.write_v2(temp, hidden=model.hidden, king_buckets=kb, residual=residual, mirror=mirror, king_map=kmap,
+                    w1=np.ascontiguousarray(w1).ravel(), b1=b1, w2=w2, b2=b2)
+        if path.exists():
+            raise FileExistsError(str(path))
+        os.rename(temp, path)
+    finally:
+        if temp.exists():
+            temp.unlink()
+
+
+def targets(score_t, stm_t, wres_t, k, blend):
+    """score int16 STM cp, wres = white result*2 (0,1,2). Returns teacher, stm_result, blended target."""
+    teacher = torch.sigmoid(torch.clamp(score_t * (k / 400.0), -40, 40))
+    white = wres_t * 0.5
+    stm_res = torch.where(stm_t == 0, white, 1.0 - white)
+    return teacher, stm_res, blend * teacher + (1.0 - blend) * stm_res
+
+
+def targets_t(score_t, stm_t, wres_t, k, blend_t, omb_t):
+    """v3b: targets() with blend and (1-blend) as 0-dim float32 device tensors (same float32 values as the Python scalars)."""
+    teacher = torch.sigmoid(torch.clamp(score_t * (k / 400.0), -40, 40))
+    white = wres_t * 0.5
+    stm_res = torch.where(stm_t == 0, white, 1.0 - white)
+    return teacher, stm_res, blend_t * teacher + omb_t * stm_res
+
+
+def to_dev(buf, dev, k):
+    """v3: buf = pack_batch(...); ONE host->device copy, then device-side slices (same dtypes/values as v2)."""
+    B = buf.size // PACK_W
+    t = torch.from_numpy(buf).to(dev)
+    codes = t[: B * 64].view(B, 64).long()
+    stm = t[B * 64:B * 65].long()
+    wres = t[B * 65:B * 66]
+    score = t[B * 66:B * 67]
+    hce_l = t[B * 67:]
+    return codes, stm, wres, score, hce_l
+
+
+class EpochPrep:
+    """v3: builds one epoch's training order + Prefetcher in a background thread (overlaps the epoch boundary)."""
+    def __init__(self, fn, ep, wait=None):
+        self.res, self.err = None, None
+        self.t = threading.Thread(target=self._run, args=(fn, ep, wait), daemon=True)
+        self.t.start()
+
+    def _run(self, fn, ep, wait):
+        try:
+            if wait is not None:  # v3b: reused order buffer -> wait until the previous producer has read all of it
+                wait.t.join()
+            self.res = fn(ep)
+        except BaseException as e:  # noqa
+            self.err = e
+
+    def get(self):
+        self.t.join()
+        if self.err is not None:
+            raise self.err
+        res, self.res = self.res, None
+        return res
+
+    def close(self):
+        self.t.join()
+        if self.res is not None:
+            self.res.close()
+            self.res = None
+
+
+@torch.no_grad()
+def evaluate(model, d, idx_all, dev, k, batch, blends=(1.0, 0.6), baseline=False, limit_batches=None):
+    """MSE on positions idx_all. Returns dict blend -> mse. baseline=True ignores the net (HCE alone)."""
+    sums = {b: 0.0 for b in blends}
+    cnt = 0
+    model.eval()
+    nb = len(idx_all) // batch
+    if limit_batches:
+        nb = min(nb, limit_batches)
+    pf = Prefetcher(d, idx_all[: nb * batch], batch, k)
+    for bt in pf:
+        codes, stm, wres, score, hce_l = to_dev(bt, dev, k)
+        logit = hce_l if baseline else model(codes, stm, hce_l)
+        pred = torch.sigmoid(logit)
+        for b in blends:
+            _, _, tg = targets(score, stm, wres, k, b)
+            sums[b] += float(F.mse_loss(pred, tg, reduction="sum").cpu())
+        cnt += len(codes)
+    model.train()
+    return {b: sums[b] / max(cnt, 1) for b in blends}, cnt
+
+
+# ----------------------------------------------------------------------------- export
+def atomic_write(path, write):
+    temp = path.with_name(path.name + ".tmp-" + uuid.uuid4().hex)
+    try:
+        with open(temp, "xb") as dst:
+            write(dst)
+            dst.flush()
+            os.fsync(dst.fileno())
+        if path.exists():
+            raise FileExistsError(str(path))
+        os.rename(temp, path)
+    finally:
+        if temp.exists():
+            temp.unlink()
+
+
+def export_forge(model, stem, k, residual):
+    hidden = model.hidden
+    arrays = [model.ft.weight.detach().cpu().t().contiguous().numpy().ravel(),
+              model.ft.bias.detach().cpu().numpy(),
+              model.out.weight.detach().cpu().numpy().ravel(),
+              model.out.bias.detach().cpu().numpy()]
+    if not all(np.isfinite(v).all() for v in arrays):
+        raise RuntimeError("Non-finite parameters; refusing to export")
+    quant = []
+    for v in arrays:
+        sc = v.astype(np.float64) * SCALE
+        r = np.sign(sc) * np.floor(np.abs(sc) + 0.5)
+        if (np.abs(r) > 32767).any():
+            raise ValueError("Weights exceed int16 range")
+        quant.append(r.astype(np.int16))
+    lines = ["// Generated by train_resid.py; Forge-768 network.",
+             "#include <cstdint>", f"#define FORGE_NNUE_RESIDUAL {1 if residual else 0}",
+             f"static_assert(forge::nnue::InputCount == 768 && forge::nnue::HiddenSize == {hidden},",
+             '              "NNUE shape mismatch; rebuild with the correct FORGE_NNUE_HIDDEN");',
+             'static_assert(forge::nnue::SigmoidK == 2.25F, "NNUE output scale mismatch");',
+             'static_assert(forge::nnue::WeightScale == 4096.0F && forge::nnue::OutputScale == 4096.0F,',
+             '              "NNUE quantization scale mismatch");']
+    for name, v in zip(("NnueW1", "NnueB1", "NnueW2"), quant[:3]):
+        lines.append(f"static const std::int16_t {name}[{len(v)}] = {{")
+        lines.extend("  " + ", ".join(map(str, v[i:i + 24])) + "," for i in range(0, len(v), 24))
+        lines.append("};")
+    lines.append(f"static const std::int16_t NnueB2 = {int(quant[3][0])};")
+    atomic_write(stem.with_suffix(".inc"), lambda dst: dst.write(("\n".join(lines) + "\n").encode("ascii")))
+    raw = b"".join(np.asarray(v, dtype="<f4").tobytes() for v in arrays)
+    atomic_write(stem.with_suffix(".bin"), lambda dst: dst.write(raw))
+
+
+def cpu_copy(v):
+    if torch.is_tensor(v):
+        return v.detach().cpu().clone()
+    if isinstance(v, dict):
+        return {a: cpu_copy(b) for a, b in v.items()}
+    if isinstance(v, list):
+        return [cpu_copy(b) for b in v]
+    return v
+
+
+def device_for(name, index=None, requested="7900 XT"):
+    if name == "cpu":
+        return torch.device("cpu")
+    import torch_directml
+    names = [torch_directml.device_name(i) for i in range(torch_directml.device_count())]
+    if index is None:
+        m = [i for i, n in enumerate(names) if requested.lower() in n.lower()]
+        if not m:
+            raise ValueError(f"GPU {requested!r} not found: {names}")
+        index = m[0]
+    print(f"DirectML GPU {index}: {names[index]}", flush=True)
+    return torch_directml.device(index)
+
