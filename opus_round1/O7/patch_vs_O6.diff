+struct Rng {
+    std::uint64_t s;
+    std::uint64_t next() {
+        s ^= s >> 12U; s ^= s << 25U; s ^= s >> 27U;
+        return s * 2685821657736338717ULL;
+    }
+    int below(int n) { return static_cast<int>(next() % static_cast<std::uint64_t>(n)); }
+    bool chance(int percent) { return below(100) < percent; }
+};
