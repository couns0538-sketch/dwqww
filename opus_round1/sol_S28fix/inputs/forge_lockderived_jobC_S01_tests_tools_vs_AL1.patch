--- a/tools/rerecord_pins.sh	1969-12-31 16:00:00.000000000 -0800
+++ b/tools/rerecord_pins.sh	2026-10-26 00:12:11.396120118 -0700
@@ -0,0 +1,5 @@
+#!/usr/bin/env bash
+# Read-only engine pin observations; never changes expected values or host limits.
+set -euo pipefail
+script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
+exec python3 -B "$script_dir/rerecord_pins.py" "$@"
