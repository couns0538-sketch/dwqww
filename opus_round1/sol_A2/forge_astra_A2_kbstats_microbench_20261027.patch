+#ifdef FORGE_A2_KBSTATS
+// A2 king-bucket microbench (compile flag FORGE_A2_KBSTATS, see search.hpp). For several partitions of the
+// 64 own-king squares (perspective frame: a1 = 0 seen from that side, rank-flipped for Black) it counts how
+// often a king-bucketed input layer would need an accumulator refresh, and it simulates a refresh cache with
+// one entry per (perspective, key). Counting only: nothing here feeds back into the search.
+namespace a2kb {
+namespace {
+constexpr int LayoutCount = 8;
+// M<n>: mirrored layout with n half-board buckets (the C4 standard maps); its key also changes when the king
+// crosses between files d and e, because the feature transform flips the files. U<2n> (n buckets per half,
+// files e-h in their own buckets, unmirrored) has exactly the keys of M<n>. R4 / R8: unmirrored rank zones
+// (rank 1 | 2 | 3-4 | 5-8) and single ranks (files ignored).
+constexpr std::array<const char*, LayoutCount> Names{"M1", "M2=U4", "M4=U8", "M8=U16", "M16=U32", "M32=U64", "R4", "R8"};
+// Half-board rows, files a-d, rank 1 first (C4 tools/nnue/forge_nnue_v2.py _LAYOUT_ROWS); "" = 32 buckets.
+constexpr std::array<const char*, 6> HalfRows{
+    "0000" "0000" "0000" "0000" "0000" "0000" "0000" "0000",
+    "0000" "0000" "1111" "1111" "1111" "1111" "1111" "1111",
+    "0011" "0011" "2222" "2222" "3333" "3333" "3333" "3333",
+    "0123" "4455" "6666" "7777" "7777" "7777" "7777" "7777",
+    "0123" "4567" "8899" "aabb" "cccc" "dddd" "eeee" "ffff",
+    ""};
+constexpr std::array<int, 6> HalfBuckets{1, 2, 4, 8, 16, 32};
+
+struct Tables {
+    std::array<std::array<std::uint8_t, 64>, LayoutCount> key{};
+    std::array<int, LayoutCount> keys{};
+};
+
+int hex_digit(char c) { return c >= 'a' ? c - 'a' + 10 : c - '0'; }
+
+const Tables& tables() {
+    static const Tables instance = [] {
+        Tables t;
+        for (std::size_t l = 0; l < HalfBuckets.size(); ++l) {
+            for (int square = 0; square < 64; ++square) {
+                const int file = square & 7;
+                const int half = (square >> 3) * 4 + (file < 4 ? file : 7 - file);
+                const int bucket = HalfBuckets[l] == 32 ? half : hex_digit(HalfRows[l][half]);
+                t.key[l][static_cast<std::size_t>(square)] = static_cast<std::uint8_t>(bucket + (file >= 4 ? HalfBuckets[l] : 0));
+            }
+            t.keys[l] = 2 * HalfBuckets[l];
+        }
+        constexpr std::array<int, 8> zone4{0, 1, 2, 2, 3, 3, 3, 3};
+        for (int square = 0; square < 64; ++square) {
+            t.key[6][static_cast<std::size_t>(square)] = static_cast<std::uint8_t>(zone4[static_cast<std::size_t>(square >> 3)]);
+            t.key[7][static_cast<std::size_t>(square)] = static_cast<std::uint8_t>(square >> 3);
+        }
+        t.keys[6] = 4;
+        t.keys[7] = 8;
+        return t;
+    }();
+    return instance;
+}
+
+struct Counters {
+    std::uint64_t evals = 0;        // static_evaluate calls that use the network
+    std::uint64_t evals_valid = 0;  // ... whose accumulator was already valid (no update)
+    std::uint64_t scratch = 0;      // ... refreshed from scratch (no valid ancestor)
+    std::uint64_t replayed = 0;     // plies replayed by the lazy walk-back (incremental updates)
+    std::uint64_t replayed_cols = 0;  // weight columns of those updates, per perspective (sum of the dirty counts)
+    std::uint64_t moves = 0;        // record_move calls (moves made by the search, quiescence included)
+    std::uint64_t null_moves = 0;
+    std::uint64_t king_moves = 0;
+    std::array<std::uint64_t, LayoutCount> xm{};            // king moves made whose own key changes
+    std::array<std::uint64_t, LayoutCount> xp{};            // replayed plies whose mover's key changes (ply-by-ply refresh)
+    std::array<std::uint64_t, LayoutCount> xe{};            // (evaluation, perspective): key differs from the replay source
+    std::array<std::uint64_t, LayoutCount> cache_cols{};    // weight columns for the xe refreshes with the refresh cache
+    std::array<std::uint64_t, LayoutCount> scratch_cols{};  // weight columns for the xe refreshes from scratch
+};
+
+Counters position_counters;
+Counters total_counters;
+std::string report;
+// Simulated refresh cache: per layout, perspective and key, the 12 piece bitboards of the position that the
+// entry's accumulator was last brought to. All empty at the start of every bench position (cold cache).
+std::array<std::array<std::array<std::array<Bitboard, 12>, 64>, 2>, LayoutCount> cache{};
+
+int relative(Color perspective, int square) { return perspective == White ? square : square ^ 56; }
+
+void on_move(const Board& board, const Move& move) {
+    Counters& c = position_counters;
+    ++c.moves;
+    if (piece_type(board.piece_at(move.from)) != King) return;
+    ++c.king_moves;
+    const Tables& t = tables();
+    const Color us = board.side_to_move();
+    const std::size_t from = static_cast<std::size_t>(relative(us, move.from));
+    const std::size_t to = static_cast<std::size_t>(relative(us, move.to));
+    for (std::size_t l = 0; l < LayoutCount; ++l) c.xm[l] += t.key[l][from] != t.key[l][to] ? 1U : 0U;
+}
+
+void on_null_move() { ++position_counters.null_moves; }
+
+void on_evaluate(const Board& board, const SearchStack* ss) {
+    Counters& c = position_counters;
+    ++c.evals;
+    if (ss->accumulator.valid) {
+        ++c.evals_valid;
+        return;
+    }
+    // The walk-back of Worker::static_evaluate.
+    int back = 0;
+    while (back < ss->ply && !(ss - back - 1)->accumulator.valid) ++back;
+    if (back >= ss->ply && !(ss - back - 1)->accumulator.valid) {
+        ++c.scratch;
+        return;
+    }
+    c.replayed += static_cast<std::uint64_t>(back + 1);
+    const Tables& t = tables();
+    const std::array<int, 2> now{board.king_square(White), board.king_square(Black)};
+    std::array<int, 2> source = now;  // own king squares at the replay source (ss - back - 1)
+    for (int i = 0; i <= back; ++i) {  // replayed plies, newest first
+        const nnue::DirtyPieces& dirty = (ss - i)->dirty;
+        c.replayed_cols += static_cast<std::uint64_t>(dirty.count);
+        int from = -1;
+        int to = -1;
+        Color mover = White;
+        for (int j = 0; j < dirty.count; ++j) {
+            const nnue::PieceChange& change = dirty.changes[static_cast<std::size_t>(j)];
+            if (piece_type(change.piece) != King) continue;
+            if (change.add) {
+                to = change.square;
+            } else {
+                from = change.square;
+                mover = color_of(change.piece);
+            }
+        }
+        if (from < 0) continue;
+        source[static_cast<std::size_t>(mover)] = from;
+        const std::size_t a = static_cast<std::size_t>(relative(mover, from));
+        const std::size_t b = static_cast<std::size_t>(relative(mover, to));
+        for (std::size_t l = 0; l < LayoutCount; ++l) c.xp[l] += t.key[l][a] != t.key[l][b] ? 1U : 0U;
+    }
+    for (std::size_t l = 0; l < LayoutCount; ++l) {
+        for (const Color p : {White, Black}) {
+            const std::size_t pi = static_cast<std::size_t>(p);
+            const std::uint8_t key = t.key[l][static_cast<std::size_t>(relative(p, now[pi]))];
+            if (key == t.key[l][static_cast<std::size_t>(relative(p, source[pi]))]) continue;
+            ++c.xe[l];
+            auto& entry = cache[l][pi][key];
+            int columns = 0;
+            for (int piece = WP; piece <= BK; ++piece) {
+                const Bitboard bb = board.pieces(static_cast<Piece>(piece));
+                columns += popcount(entry[static_cast<std::size_t>(piece - 1)] ^ bb);
+                entry[static_cast<std::size_t>(piece - 1)] = bb;
+            }
+            c.cache_cols[l] += static_cast<std::uint64_t>(columns);
+            c.scratch_cols[l] += static_cast<std::uint64_t>(popcount(board.occupied()));
+        }
+    }
+}
+
+void append(std::string& out, const std::string& tag, std::uint64_t nodes, const Counters& c) {
+    out += "info string a2kb " + tag + " nodes " + std::to_string(nodes) + " evals " + std::to_string(c.evals) +
+           " evals_valid " + std::to_string(c.evals_valid) + " scratch_refresh " + std::to_string(c.scratch) +
+           " replayed " + std::to_string(c.replayed) + " replayed_cols " + std::to_string(c.replayed_cols) +
+           " moves " + std::to_string(c.moves) + " null_moves " +
+           std::to_string(c.null_moves) + " king_moves " + std::to_string(c.king_moves) + "\n";
+    const Tables& t = tables();
+    for (std::size_t l = 0; l < LayoutCount; ++l) {
+        out += "info string a2kb " + tag + " layout " + Names[l] + " keys " + std::to_string(t.keys[l]) + " xm " +
+               std::to_string(c.xm[l]) + " xp " + std::to_string(c.xp[l]) + " xe " + std::to_string(c.xe[l]) +
+               " cache_cols " + std::to_string(c.cache_cols[l]) + " scratch_cols " + std::to_string(c.scratch_cols[l]) + "\n";
+    }
+}
+} // namespace
+
+void begin_position() {
+    position_counters = Counters{};
+    for (auto& layout : cache) {
+        for (auto& perspective : layout) {
+            for (auto& entry : perspective) entry.fill(0);
+        }
+    }
+}
+
+void end_position(int index, std::uint64_t nodes) {
+    const Counters& p = position_counters;
+    Counters& t = total_counters;
+    t.evals += p.evals;
+    t.evals_valid += p.evals_valid;
+    t.scratch += p.scratch;
+    t.replayed += p.replayed;
+    t.replayed_cols += p.replayed_cols;
+    t.moves += p.moves;
+    t.null_moves += p.null_moves;
+    t.king_moves += p.king_moves;
+    for (std::size_t l = 0; l < LayoutCount; ++l) {
+        t.xm[l] += p.xm[l];
+        t.xp[l] += p.xp[l];
+        t.xe[l] += p.xe[l];
+        t.cache_cols[l] += p.cache_cols[l];
+        t.scratch_cols[l] += p.scratch_cols[l];
+    }
+    append(report, "pos " + std::to_string(index), nodes, p);
+}
+
+void print_total(int depth, std::uint64_t nodes) {
+    // The caller holds the UCI output lock.
+    append(report, "total depth " + std::to_string(depth), nodes, total_counters);
+    std::cout << report << std::flush;
+    report.clear();
+    total_counters = Counters{};
+}
+} // namespace a2kb
+#endif
