Full 32-bit sweep of corrplus::div100 / div_pow2<8> / div_pow2<13> against the C++ / operator
(MSYS2 g++ 15.2 -std=c++20 -O2 -march=x86-64-v3; div_pow2 checked for x > INT32_MIN + 2^Shift as documented)
----- sweep.cpp
// Full 32-bit sweep of the CorrHistPlus division helpers against the C++ / operator.
#include "forge/correction_plus.hpp"
#include <cstdint>
#include <cstdio>
int main() {
    volatile int sink = 0;
    unsigned long long bad100 = 0, bad8 = 0, bad13 = 0, n = 0;
    for (long long v = INT32_MIN; v <= INT32_MAX; ++v) {
        volatile int vx = static_cast<int>(v);
        const int x = vx;
        ++n;
        if (forge::corrplus::div100(x) != x / 100) ++bad100;
        if (x > INT32_MIN + 256 && forge::corrplus::div_pow2<8>(x) != x / 256) ++bad8;
        if (x > INT32_MIN + 8192 && forge::corrplus::div_pow2<13>(x) != x / 8192) ++bad13;
        sink = x;
    }
    std::printf("values %llu  div100 mismatches %llu  div_pow2<8> mismatches %llu  div_pow2<13> mismatches %llu\n", n, bad100, bad8, bad13);
    return (bad100 || bad8 || bad13) ? 1 : 0;
}
