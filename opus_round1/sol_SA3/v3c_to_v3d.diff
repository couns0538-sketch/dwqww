+# ----------------------------------------------------------------------------- lr schedules (v3d, S-A3)
+def lr_decay_start(total, warmup, decay_frac):
+    """v3d wsd: first step of the decay phase: the last round(decay_frac * total) steps of the horizon (at least 1 step),
+    never inside the warmup."""
+    return max(warmup, total - max(1, int(decay_frac * total + 0.5)))
+
+
+def lr_value(kind, s, lr, warmup, total, floor, decay_frac):
+    """v3d: learning rate at step s (0-based) for a schedule with a horizon of `total` steps. All kinds share v3b's linear
+    warmup lr*(s+1)/warmup and reach lr*floor (--min-lr-frac) at the horizon; after it the lr stays at the floor.
+    cosine (default) = v3b's expression exactly; linear = straight line from lr to the floor after the warmup;
+    wsd (warmup-stable-decay) = lr until the last decay_frac of the horizon, then a straight line to the floor."""
+    if s < warmup:
+        return lr * (s + 1) / warmup
+    if kind == "cosine":
+        pr = (s - warmup) / max(1, total - warmup)
+        return lr * (floor + (1 - floor) * 0.5 * (1 + math.cos(math.pi * min(pr, 1.0))))
+    if kind == "linear":
+        pr = (s - warmup) / max(1, total - warmup)
+        return lr * (floor + (1 - floor) * (1 - min(pr, 1.0)))
+    if kind == "wsd":
+        d0 = lr_decay_start(total, warmup, decay_frac)
+        if s < d0:
+            return lr
+        pr = (s - d0) / max(1, total - d0)
+        return lr * (floor + (1 - floor) * (1 - min(pr, 1.0)))
+    raise ValueError(f"unknown lr schedule {kind!r}")
+
+
+def lr_schedule_error(a):
+    """v3d: check of the lr schedule options (None = fine). Runs before the run dir is created."""
+    if a.lr_schedule_epochs < 0:
+        return "--lr-schedule-epochs must be >= 0 (0 = --epochs)"
+    if not (math.isfinite(a.lr_decay_frac) and 0 < a.lr_decay_frac <= 1):
+        return "--lr-decay-frac must be in (0, 1]"
+    if a.lr_decay_frac != V3D_LR["lr_decay_frac"] and a.lr_schedule != "wsd":
+        return "--lr-decay-frac needs --lr-schedule wsd"
+    return None
+
+
