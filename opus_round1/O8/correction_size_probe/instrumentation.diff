+    row("nmp_eval_c", nmp_eval_c); mat("nmp_pass_cs", nmp_pass_cs);
+    row("lmr_c", lmr_c);
+    for (int i = 0; i < CB; ++i) { std::fprintf(f, "lmr_r %d", i); for (int j = 0; j < 16; ++j) std::fprintf(f, " %llu", (unsigned long long)lmr_r[i][j]); std::fprintf(f, "\n"); }
+    row("se_c", se_c); row("se_ext1_c", se_ext1_c); row("se_ext2_c", se_ext2_c); mat("se_ext2_m", se_ext2_m);
+    std::fclose(f);
+}
