== cases that MUST fail (exit 2, HARD FAILURE)
case empty engine file            exit=2 hard_failure_lines=1
    HARD FAILURE: engine_R.jsonl produced 0 rows
    NO VERDICT: comparison did not run to completion.
case empty reference file         exit=2 hard_failure_lines=1
    HARD FAILURE: no reference rows at all
    NO VERDICT: comparison did not run to completion.
case missing depth 3 row          exit=2 hard_failure_lines=1
    engine rows 1 reference rows 1 expected 5000
    positions with no reference row: 0 []
    reference rows with no engine row: 0 []
    reference says INVALID FEN: 0 []
case nodes is a string            exit=2 hard_failure_lines=1
    engine rows 1 reference rows 1 expected 5000
    positions with no reference row: 0 []
    reference rows with no engine row: 0 []
    reference says INVALID FEN: 0 []
case nodes is null                exit=2 hard_failure_lines=1
    engine rows 1 reference rows 1 expected 5000
    positions with no reference row: 0 []
    reference rows with no engine row: 0 []
    reference says INVALID FEN: 0 []
