         .           int Board::static_exchange(const Move& move) const {
         .               int low = -2000;
         .               int high = 2000;
         .               while (low < high) {
         .                   const int mid = low + (high - low + 1) / 2;
         .                   if (see_ge(move, mid)) low = mid;
         .                   else high = mid - 1;
         .               }
         .               return low;
         .           }
