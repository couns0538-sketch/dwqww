if(NOT PROJECT_NAME STREQUAL "forge_combo29")
  return()
endif()

function(job22_apply_sanitizer)
  get_target_property(plain_definitions forge COMPILE_DEFINITIONS)
  get_target_property(plain_options forge COMPILE_OPTIONS)
  if(NOT "NDEBUG" IN_LIST plain_definitions OR NOT "-O3" IN_LIST plain_options)
    message(FATAL_ERROR "Forge baseline compile definitions/options differ from the expected recipe")
  endif()
  list(REMOVE_ITEM plain_definitions NDEBUG)
  list(REMOVE_ITEM plain_options -O3)
  set_property(TARGET forge PROPERTY COMPILE_DEFINITIONS "${plain_definitions}")
  set_property(TARGET forge PROPERTY COMPILE_OPTIONS "${plain_options}")

  target_compile_options(forge PRIVATE -O1 -g)
  if(JOB22_SANITIZER STREQUAL "AU")
    target_compile_options(forge PRIVATE -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=undefined)
    target_link_options(forge PRIVATE -fsanitize=address,undefined)
  elseif(JOB22_SANITIZER STREQUAL "T")
    target_compile_options(forge PRIVATE -fsanitize=thread)
    target_link_options(forge PRIVATE -fsanitize=thread)
  else()
    message(FATAL_ERROR "Unknown Job 22 sanitizer family: ${JOB22_SANITIZER}")
  endif()
endfunction()

cmake_language(DEFER CALL job22_apply_sanitizer)
