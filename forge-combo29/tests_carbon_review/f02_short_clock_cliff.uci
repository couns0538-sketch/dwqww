# Interactive timing sequence (run via run_all_tests.py so each `go` finishes before the next command):
setoption name OwnBook value false
setoption name Threads value 64
isready
position fen 6k1/5ppp/8/8/8/1q6/8/R2Q2K1 w - - 0 1
go wtime 10 btime 1000
# [wait for bestmove]
ucinewgame
isready
position fen 6k1/5ppp/8/8/8/1q6/8/R2Q2K1 w - - 0 1
go wtime 11 btime 1000
# [wait for bestmove]
quit
