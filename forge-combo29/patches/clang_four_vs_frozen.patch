+    lines.check_squares[Bishop] = attacks::bishop(their_king, occupancy);
+    lines.check_squares[Rook] = attacks::rook(their_king, occupancy);
+    lines.check_squares[Queen] = lines.check_squares[Bishop] | lines.check_squares[Rook];
+    lines.check_squares[King] = 0;
+    lines.valid = true;
