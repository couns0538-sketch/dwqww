+void Board::refresh_king_lines() const {
+    const Color us = side_;
+    const Color them = opposite(us);
+    const Bitboard occupancy = occupied();
+    const int our_king = king_square(us);
+    const int their_king = king_square(them);
+    KingLines& lines = king_lines_;
+    lines.pinned = single_blockers(our_king, pieces(them, Rook) | pieces(them, Queen),
+                                   pieces(them, Bishop) | pieces(them, Queen), occupancy) & occupied(us);
+    lines.discoverers = single_blockers(their_king, pieces(us, Rook) | pieces(us, Queen),
+                                        pieces(us, Bishop) | pieces(us, Queen), occupancy) & occupied(us);
+    lines.check_squares[NoPieceType] = 0;
+    lines.check_squares[Pawn] = attacks::pawn(them, their_king);
+    lines.check_squares[Knight] = attacks::knight(their_king);
+    lines.check_squares[Bishop] = attacks::bishop(their_king, occupancy);
+    lines.check_squares[Rook] = attacks::rook(their_king, occupancy);
+    lines.check_squares[Queen] = lines.check_squares[Bishop] | lines.check_squares[Rook];
+    lines.check_squares[King] = 0;
+    lines.valid = true;
